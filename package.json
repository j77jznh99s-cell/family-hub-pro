    "cycle": "codex exec --model gpt-6-astra \"$(cat prompts/cycle.md)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "engines": {
    "node": ">=20.6.0"
  }
