# Do NOT put real credentials in this file or anywhere inside the project.
# Copy this to your own secret store / shell profile / process manager
# environment instead. Nothing named .env is read automatically by any
# script here; this file only documents the variables each component needs.

# --- risk-gate (needs a key with contract TRADING permission) -------------
# Set in ~/.codex/config.toml under [mcp_servers.risk-gate].env, not here.
BYBIT_TESTNET=true
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- scripts/position-check.js, scripts/funding-check.js, ------------------
# --- scripts/telegram-commands.js's /status (read-only key is enough) -----
# Using a SEPARATE key from the risk gate's, scoped to read-only, keeps the
# only trading-permission credential confined to the risk gate.
BYBIT_TESTNET=true
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Telegram alerts and remote control ------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
