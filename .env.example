# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=3000
ANTHROPIC_MODEL=claude-sonnet-5
CLIP_COUNT=4
MAX_UPLOAD_MB=2048
MAX_CONCURRENT_JOBS=1
DELETE_SOURCE_AFTER_PROCESSING=true
UPLOAD_RATE_LIMIT_PER_HOUR=20

# Shared secret required to use the API/dashboard. Leave unset only for local dev.
ACCESS_TOKEN=

# Where uploads/clips/sqlite db live. Defaults to ./uploads, ./clips, ./data
# Point these at a mounted volume in production (Railway volumes, etc).
UPLOAD_DIR=
CLIPS_DIR=
DATA_DIR=
