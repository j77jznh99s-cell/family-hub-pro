# ── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Core app config (optional, sensible defaults) ───────────────────────────
PORT=3000
ANTHROPIC_MODEL=claude-sonnet-5
CLIP_COUNT=4
# Center-crop clips to this aspect ratio, e.g. 9:16 for TikTok/Reels/Shorts. Unset keeps the source ratio.
# CLIP_ASPECT=9:16
MAX_UPLOAD_MB=2048
MAX_CONCURRENT_JOBS=1
DELETE_SOURCE_AFTER_PROCESSING=true
UPLOAD_RATE_LIMIT_PER_HOUR=20

# Shared secret required to use the API/dashboard. Leave unset only for local dev.
ACCESS_TOKEN=

# Where uploads/clips live when using local disk storage. Defaults to ./uploads, ./clips
# Point these at a mounted volume in production (Railway volumes, etc) if not using S3.
UPLOAD_DIR=
CLIPS_DIR=
DATA_DIR=

# ── Database: Postgres instead of the SQLite default ────────────────────────
# Leave unset to use SQLite (zero-config, single-instance). Set to use Postgres
# instead (needed once you run more than one instance, or want the DB to survive
# a redeploy without a volume).
DATABASE_URL=

# ── Queue: Redis/BullMQ instead of the in-process default ───────────────────
# Leave unset to use the in-process queue (zero-config, single-instance, jobs lost on
# crash/restart while still in the queue). Set to persist queued jobs in Redis and let
# multiple instances share one job queue.
REDIS_URL=

# ── Storage: S3 instead of local disk ────────────────────────────────────────
# Leave unset to store clips/thumbnails on local disk (see UPLOAD_DIR/CLIPS_DIR above).
# Set S3_BUCKET to instead upload finished clips/thumbnails to S3 (or an S3-compatible
# provider like Cloudflare R2/MinIO via S3_ENDPOINT) and serve them via presigned URLs.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_DOWNLOAD_URL_TTL_SECONDS=300

# ── Transcript-based scoring + burned-in captions ────────────────────────────
# Leave unset to keep the Phase 1 frame-only scoring (no transcript, no captions). Set
# to transcribe audio via Whisper, score clips using what was actually said (not just
# visuals), and burn captions into exported clips.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
BURN_IN_CAPTIONS=true

# ── Payments: Stripe Checkout + credits ──────────────────────────────────────
# Leave unset to keep uploads unlimited (manual/invoice billing, single shared
# ACCESS_TOKEN - the Phase 1 default). Set to require an `accountId` on every upload
# and gate it on that account having a purchased credit (1 credit = 1 processed video).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREDIT_PRICE_CENTS=1000
# Where Stripe Checkout redirects after payment. Defaults to "<this app's URL>/?checkout=success|cancel".
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# ── AI presenter (optional - `npm run presenter`, see docs/ai-presenter.md) ──
# Trend research + scripts use ANTHROPIC_API_KEY above. Rendering uses HeyGen.
# PRESENTER_MODEL=claude-opus-5
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_ID=           # your trained video avatar (best quality)
# HEYGEN_TALKING_PHOTO_ID=    # or a photo avatar, used only if HEYGEN_AVATAR_ID is empty
# HEYGEN_VOICE_ID=            # your cloned voice
# HEYGEN_TEST=true            # free watermarked renders while you test
# PRESENTER_WIDTH=1080
# PRESENTER_HEIGHT=1920
