{
  "name": "SproutlingIsles",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      },
      "$properties": {
        "CharacterWalkSpeed": 18,
        "CharacterJumpHeight": 7.2
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": true }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.55, 0.55, 0.6],
        "OutdoorAmbient": [0.6, 0.6, 0.65],
        "Brightness": 2.5,
        "ClockTime": 14,
        "GlobalShadows": true
      }
    },
    "Workspace": {
      "$properties": { "Gravity": 196.2 }
    }
  }
}
