      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Ambience</string>
          <string name="Source"><![CDATA[--!strict
-- Lighting look for Sproutling Isles: a bright, saturated, slightly hazy afternoon.
--
-- Like MapBuilder it touches no services, so it runs both at server start (on game.Lighting)
-- and offline under Lune (tools/bake-map.luau), which passes its own Roblox API table.
-- Apply() is idempotent: it finds or creates each effect by class name and sets its properties.
--
-- WeatherService tints the Atmosphere during weather and restores Ambience.Clear afterwards,
-- because once an Atmosphere exists Roblox ignores Lighting.Fog*.

local Ambience = {}

local Instance = Instance
local Color3 = Color3

function Ambience.useApi(api: any)
	Instance = api.Instance
	Color3 = api.Color3
end

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Clear-weather Atmosphere values (WeatherService tweens back to these).
function Ambience.clearAtmosphere(): { [string]: any }
	return {
		Density = 0.3,
		Offset = 0.22,
		Color = rgb(205, 225, 255),
		Decay = rgb(110, 150, 215),
		Glare = 0.3,
		Haze = 1.3,
	}
end

-- Atmosphere values while a weather with this sky colour is active.
function Ambience.weatherAtmosphere(sky: Color3, thick: boolean): { [string]: any }
	return {
		Density = if thick then 0.55 else 0.42,
		Offset = 0.1,
		Color = sky,
		Decay = sky,
		Glare = 0,
		Haze = if thick then 2.6 else 1.8,
	}
end

local function ensure(lighting: Instance, className: string): Instance
	local existing = lighting:FindFirstChildOfClass(className)
	if existing then
		return existing
	end
	local effect = Instance.new(className)
	effect.Name = className
	effect.Parent = lighting
	return effect
end

local function set(target: Instance, props: { [string]: any })
	for key, value in props do
		(target :: any)[key] = value
	end
end

function Ambience.Apply(lighting: Instance)
	set(lighting, {
		Brightness = 3,
		ClockTime = 15.2,
		GeographicLatitude = 30,
		ExposureCompensation = 0.15,
		Ambient = rgb(125, 118, 145),
		OutdoorAmbient = rgb(145, 150, 175),
		ColorShift_Top = rgb(255, 232, 200),
		ColorShift_Bottom = rgb(120, 150, 210),
		EnvironmentDiffuseScale = 1,
		EnvironmentSpecularScale = 1,
		GlobalShadows = true,
	})

	set(ensure(lighting, "Atmosphere"), Ambience.clearAtmosphere())

	-- Neon parts (lanterns, crystals, beams, plot rims) glow softly.
	set(ensure(lighting, "BloomEffect"), {
		Intensity = 0.85,
		Size = 30,
		Threshold = 1.35,
	})

	-- Push colours a little: greener grass, bluer sea, warmer light.
	set(ensure(lighting, "ColorCorrectionEffect"), {
		Saturation = 0.22,
		Contrast = 0.1,
		Brightness = 0.03,
		TintColor = rgb(255, 248, 238),
	})

	set(ensure(lighting, "SunRaysEffect"), {
		Intensity = 0.09,
		Spread = 0.75,
	})

	-- Soft depth blur only on the far horizon, so the floating islets read as distant.
	set(ensure(lighting, "DepthOfFieldEffect"), {
		FarIntensity = 0.12,
		FocusDistance = 260,
		InFocusRadius = 300,
		NearIntensity = 0,
	})

	set(ensure(lighting, "Sky"), {
		SunAngularSize = 16,
		MoonAngularSize = 11,
		StarCount = 3000,
		CelestialBodiesShown = true,
	})
end

return Ambience
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Every gameplay tunable lives here so designers can rebalance without touching systems code.

local Config = {}

Config.GameName = "Sproutling Isles"
Config.CurrencyName = "Dew"

-- New players
Config.StartingDew = 25
Config.StartingSeeds = { mossbun = 2 }
Config.NewPlayerShieldSeconds = 15 * 60 -- can't be snatched from during first 15 min of playtime

-- Plots
Config.PlotCount = 8
Config.SoilTilesPerPlot = 12 -- 4 x 3 grid
Config.BasePads = 8
Config.BonusPadsPass = 4 -- "Big Greenhouse" game pass

-- Gate lock (defence)
Config.LockSeconds = 60
Config.LockSecondsWithPass = 90

-- Snatching
Config.SnatchHoldSeconds = 1.5
Config.SnatchCarrySeconds = 45 -- thief must reach home within this time
Config.CarryWalkSpeed = 12
Config.SnatchCooldownSeconds = 20
-- Server-side anti-cheat for carries (the thief's client owns its character physics).
-- Horizontal speed is checked with a token bucket: the thief earns CarryWalkSpeed * CarryMaxSpeedFactor
-- studs of allowance per second, banked up to CarryBurstSeconds' worth, so lag spikes (no movement,
-- then a catch-up jump) don't trip it but sustained speed hacks or teleports do. Tuning is unverified.
Config.CarryMaxSpeedFactor = 1.3 -- 12 * 1.3 = 15.6 studs/s, below the default 16 walk speed
Config.CarryBurstSeconds = 2.5
Config.SnatchReachSlack = 6 -- extra studs allowed beyond the prompt's range when the snatch fires

-- Selling
Config.SellRatio = 0.6 -- sell value = seed price * ratio * mutation * size

-- Growth & weather
Config.WeatherEverySeconds = { 300, 480 } -- random gap between natural weather events
Config.WeatherDurationSeconds = 120
Config.GoldenChance = 0.01 -- mutation roll available in any weather
Config.HugeChance = 0.01
Config.HugeSize = 2.5

-- Shop restock (per player)
Config.RestockSeconds = 300

-- Pollen Parade conveyor
Config.ParadeSpawnSeconds = 6
Config.ParadeTravelSeconds = 32

-- Wishing Pond
Config.PondCooldownSeconds = 8
Config.PondBiteSeconds = 3

-- Rebirth: cost grows x4 per rebirth, each rebirth adds +50% permanent Dew
Config.RebirthBaseCost = 250_000
Config.RebirthCostGrowth = 4
Config.RebirthBonus = 0.5

-- Daily streak rewards, index = streak day (loops after 7)
Config.DailyRewards = {
	{ dew = 100 },
	{ dew = 250 },
	{ seed = "clovercub", count = 2 },
	{ dew = 1_000 },
	{ seed = "tulipaca", count = 2 },
	{ dew = 5_000 },
	{ seed = "mushroomph", count = 1 },
}
Config.DailyResetHours = 48 -- miss more than this and the streak restarts

-- Testing: set true to get every game pass perk while play-testing in Studio
Config.StudioTestPasses = false
-- Testing: turns off the new-player shield, but ONLY inside Roblox Studio (RunService:IsStudio()).
-- Studio sessions never save playtime, so without this every test player is shielded for 15 min.
-- Live servers ignore this flag.
Config.StudioDisableShield = true
-- Testing: seconds added to os.time() for Hollow Harvest / Frostbloom phase checks, ONLY inside
-- Roblox Studio (RunService:IsStudio()). Live servers ignore this. Lets qa-tester fast-forward to
-- Part 2, Witching Hour, or past the event's end without waiting for the real date.
Config.EventTimeOffset = 0

-- Week 1 launch incentive: "Founding Gardener" badge. 0 until the badge is created on the Creator
-- Dashboard -- same "IDs are 0 until you create..." convention as Products.luau. Badges.award()
-- no-ops (skips, no error) while this is 0. See Events.FoundingGardenerWindow for the join window.
Config.FoundingGardenerBadgeId = 0

-- Saving
Config.DataStoreName = "SproutlingIsles_v1"
Config.AutosaveSeconds = 60
Config.SessionLockSeconds = 90

-- Leaderboards (Week 5 live-ops: cross-server income + rarest-hatch boards in the Plaza).
-- See vault/Projects/Sproutling Isles - Launch & Live Ops.md, Week 5 -- the spec is just one
-- line ("in-world leaderboards: income, rarest hatch"), so these two numbers are design calls,
-- not sourced requirements; game-designer/owner can revise them.
Config.LeaderboardSize = 10 -- top N shown on the physical board
Config.LeaderboardRefreshSeconds = 180 -- how often the board re-queries the OrderedDataStores

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Events</string>
          <string name="Source"><![CDATA[--!strict
-- Live-ops event configuration. Currently just the Halloween "Hollow Harvest" event; a winter
-- event would add a sibling table here later. See
-- vault/Projects/Sproutling Isles - Launch & Live Ops.md, "Halloween event spec Hollow Harvest".
--
-- All times are Unix UTC seconds, checked against os.time() (UTC on Roblox servers), so the event
-- starts and stops itself with no redeploy needed.

local RunService = game:GetService("RunService")

export type StallItem = {
	id: string,
	kind: "seed" | "skin",
	speciesId: string?, -- set when kind == "seed"
	skinId: string?, -- set when kind == "skin"
	price: number, -- Moonberries
	dailyCap: number?, -- nil = no daily cap
	fromPart: number, -- the event "part" (1, 2, ...) this unlocks in
}

export type EventConfig = {
	id: string,
	weatherId: string,
	part1At: number,
	part2At: number,
	witchingHourAt: number,
	endAt: number,
	fogEverySeconds: number,
	witchingFogEverySeconds: number,
	lanternCount: number,
	lanternValue: number,
	lanternDailyBonus: number,
	hatchBonus: number,
	hauntedHatchBonus: number,
	stall: { [string]: StallItem },
	stallOrder: { string },
}

local Config = require(script.Parent.Config)

local Events = {}

-- The real clock everywhere but Studio. Inside Studio, `Config.EventTimeOffset` (default 0) lets a
-- tester fast-forward past the event's real-world start/part/Witching-Hour/end boundaries without
-- waiting for the calendar. Live servers always ignore the offset.
function Events.now(): number
	return os.time() + (if RunService:IsStudio() then Config.EventTimeOffset else 0)
end

Events.Halloween2026 = {
	id = "halloween2026",
	weatherId = "spookyfog",

	-- Sat 17 Oct 2026 15:00 UTC (hand-checked: 20743 days after 1970-01-01, i.e. 56 years including
	-- 14 leap days [1972..2024] to reach 2026-01-01, +289 days to 17 Oct, +15:00 = 1,792,249,200s)
	part1At = 1792249200,
	-- Sat 24 Oct 2026 15:00 UTC (part1At + 7 days = +604,800s)
	part2At = 1792854000,
	-- Sat 31 Oct 2026 00:00 UTC
	witchingHourAt = 1793404800,
	-- Sun 1 Nov 2026 23:59 UTC
	endAt = 1793577540,

	fogEverySeconds = 20 * 60,
	witchingFogEverySeconds = 10 * 60,

	lanternCount = 10,
	lanternValue = 5,
	lanternDailyBonus = 20,
	hatchBonus = 1,
	hauntedHatchBonus = 5,

	stall = {
		pumpkit = { id = "pumpkit", kind = "seed", speciesId = "pumpkit", price = 60, dailyCap = 5, fromPart = 1 },
		gourdgeist = { id = "gourdgeist", kind = "seed", speciesId = "gourdgeist", price = 250, dailyCap = 2, fromPart = 2 },
		skin = { id = "skin", kind = "skin", skinId = "haunted", price = 400, dailyCap = nil, fromPart = 2 },
	},
	-- kiosk 1..3 order, matching MapBuilder's Lantern Stall Kiosk1/2/3 "Slot" attributes
	stallOrder = { "pumpkit", "gourdgeist", "skin" },
} :: EventConfig

-- Week 1 launch incentive: "Founding Gardener" badge + flag for anyone whose first-ever join
-- falls in Week 1. See vault/Projects/Sproutling Isles - Launch & Live Ops.md, Week 1 section,
-- and the launch calendar table ("Week 2 starts 17 Oct").
Events.FoundingGardenerWindow = {
	-- Sat 10 Oct 2026 00:00 UTC (public launch = Week 1 start). Hand-checked:
	-- `date -u -d "2026-10-10 00:00:00" +%s` -> 1791590400.
	startAt = 1791590400,
	-- Sat 17 Oct 2026 00:00 UTC (Week 2 starts, per the launch calendar table; end is exclusive,
	-- i.e. a join at exactly this instant counts as Week 2). Hand-checked:
	-- `date -u -d "2026-10-17 00:00:00" +%s` -> 1792195200.
	endAt = 1792195200,
}

-- Week 8 "Frostbloom Seedling" login-day teaser: a data-only tracker (no reward is granted here --
-- see init.server.luau's comment for why). See vault/Projects/Sproutling Isles - Launch &
-- Live Ops.md, Week 8 section.
Events.FrostbloomTeaserWindow = {
	-- Sat 28 Nov 2026 00:00 UTC (Week 8 start). Hand-checked:
	-- `date -u -d "2026-11-28 00:00:00" +%s` -> 1795824000.
	startAt = 1795824000,
	-- Fri 11 Dec 2026 23:59 UTC (the day before Frostbloom Festival Day 1, Sat 12 Dec; end is
	-- inclusive of this minute, per the spec's "through 11 Dec"). Hand-checked:
	-- `date -u -d "2026-12-11 23:59:00" +%s` -> 1797033540.
	endAt = 1797033540,
}
Events.FrostbloomTeaserDaysNeeded = 3

-- True from Part 1's start up to (not including) the end time.
function Events.active(config: EventConfig, now: number): boolean
	return now >= config.part1At and now < config.endAt
end

-- 1 before Part 2 starts, 2 from Part 2 onward (Witching Hour is still "part 2" for unlock checks).
function Events.part(config: EventConfig, now: number): number
	if now >= config.part2At then
		return 2
	end
	return 1
end

function Events.isWitchingHour(config: EventConfig, now: number): boolean
	return now >= config.witchingHourAt and now < config.endAt
end

function Events.fogIntervalSeconds(config: EventConfig, now: number): number
	return if Events.isWitchingHour(config, now) then config.witchingFogEverySeconds else config.fogEverySeconds
end

return Events
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- Number and time formatting shared by server labels and client UI.

local Format = {}

local suffixes = { "", "K", "M", "B", "T", "Qa", "Qi" }

function Format.number(value: number): string
	value = math.floor(value)
	if math.abs(value) < 1000 then
		return tostring(value)
	end
	local tier = math.min(math.floor(math.log10(math.abs(value)) / 3), #suffixes - 1)
	local scaled = value / (1000 ^ tier)
	local text = if scaled >= 100 then string.format("%d", scaled) else string.format("%.1f", scaled)
	text = string.gsub(text, "%.0$", "")
	return text .. suffixes[tier + 1]
end

function Format.time(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	if seconds < 60 then
		return string.format("%ds", seconds)
	elseif seconds < 3600 then
		return string.format("%dm %02ds", seconds // 60, seconds % 60)
	end
	return string.format("%dh %02dm", seconds // 3600, (seconds % 3600) // 60)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the whole Sproutling Isles map out of primitive parts.
--
-- It only creates geometry and named anchor parts; gameplay scripts find the anchors
-- by name and attach prompts/behaviour at runtime. Because it touches no services it can run:
--   * at server start (if Workspace.Map is missing),
--   * from the Studio command bar to bake the map into the place:
--       require(game.ReplicatedStorage.Shared.MapBuilder).Build(workspace)
--   * offline under Lune (see tools/bake-map.luau), which passes its own Roblox API table.
--
-- Layout (studs, +Z = south):
--   Bloom Plaza at origin, Wishing Pond at the north tip (z = -300),
--   8 plots in two columns (x = +-155), Pollen Parade belt south of the plaza (z = 85),
--   Sky Garden floating over the south tip (y = 90, z = 300).
--   Scenery (cottages, towers, windmill, festoon lights) sits in the strips between the avenue
--   and the plots (|x| 60-100) and at the island's north/south ends; floating islets, clouds and
--   waterfalls are out over the sea. None of it is gameplay: it lives in Map.Scenery.

local MapBuilder = {}

-- Roblox API aliases, overridable for Lune.
local Instance = Instance
local Vector3 = Vector3
local CFrame = CFrame
local Color3 = Color3
local Enum = Enum
local UDim2 = UDim2
local NumberRange = NumberRange
local NumberSequence = NumberSequence
local NumberSequenceKeypoint = NumberSequenceKeypoint
local ColorSequence = ColorSequence
local Vector2 = Vector2

function MapBuilder.useApi(api: any)
	Instance = api.Instance
	Vector3 = api.Vector3
	CFrame = api.CFrame
	Color3 = api.Color3
	Enum = api.Enum
	UDim2 = api.UDim2
	NumberRange = api.NumberRange
	NumberSequence = api.NumberSequence
	NumberSequenceKeypoint = api.NumberSequenceKeypoint
	ColorSequence = api.ColorSequence
	Vector2 = api.Vector2
end

MapBuilder.PlotSize = 100
MapBuilder.PlotColors = {
	{ "Red", 235, 80, 80 },
	{ "Orange", 245, 150, 60 },
	{ "Yellow", 240, 210, 70 },
	{ "Green", 90, 200, 100 },
	{ "Teal", 60, 200, 190 },
	{ "Blue", 80, 140, 240 },
	{ "Purple", 160, 100, 230 },
	{ "Pink", 240, 120, 190 },
}

-- Returns plot centre X, centre Z and "inward" direction (+1 = gate faces +X).
function MapBuilder.plotPlacement(index: number): (number, number, number)
	local rows = { -165, -55, 55, 165 }
	if index <= 4 then
		return -155, rows[index], 1
	end
	return 155, rows[index - 4], -1
end

-- Soil tile positions in plot-local (u = towards gate, v = along the avenue).
function MapBuilder.soilLocal(tile: number): (number, number)
	local row = (tile - 1) // 4 -- 0..2
	local col = (tile - 1) % 4 -- 0..3
	return 40 - row * 16, -24 + col * 16
end

-- Pads 1-8 are base, 9-12 unlock with the Big Greenhouse pass.
local padSlots = {
	{ -20, -40 }, { -20, -24 }, { -20, -8 }, { -20, 8 }, { -20, 24 }, { -20, 40 },
	{ -38, -8 }, { -38, 8 },
	{ -38, -40 }, { -38, -24 }, { -38, 24 }, { -38, 40 },
}
function MapBuilder.padLocal(pad: number): (number, number)
	local slot = padSlots[pad]
	return slot[1], slot[2]
end

----------------------------------------------------------------------------------------------
-- helpers

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: any?, props: { [string]: any }?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for key, value in props do
			(p :: any)[key] = value
		end
	end
	p.Parent = parent
	return p
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

-- Vertical cylinder (Roblox cylinders run along X, so roll 90 degrees).
local function cylinder(parent: Instance, name: string, height: number, diameter: number, x: number, y: number, z: number, color: Color3, material: any?): BasePart
	local p = part(parent, name, Vector3.new(height, diameter, diameter), CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(90)), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function ball(parent: Instance, name: string, diameter: number, x: number, y: number, z: number, color: Color3, material: any?): BasePart
	local p = part(parent, name, Vector3.new(diameter, diameter, diameter), at(x, y, z), color, material)
	p.Shape = Enum.PartType.Ball
	return p
end

-- Purely visual part: no collisions, raycasts, touches or shadows.
local function deco(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

-- NumberSequence that goes from a to b over a particle's life.
local function fade(a: number, b: number): NumberSequence
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

-- Particles use Roblox's built-in default texture, so no uploaded assets are needed.
local function emitter(parent: Instance, name: string, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

local function glowLight(parent: Instance, range: number, brightness: number, color: Color3)
	local light = Instance.new("PointLight")
	light.Range = range
	light.Brightness = brightness
	light.Color = color
	light.Parent = parent
end

local function label(adornee: BasePart, text: string, offsetY: number, size: UDim2?, color: Color3?): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = size or UDim2.fromOffset(220, 60)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Parent = adornee
	local text_ = Instance.new("TextLabel")
	text_.Name = "Text"
	text_.BackgroundTransparency = 1
	text_.Size = UDim2.fromScale(1, 1)
	text_.Font = Enum.Font.FredokaOne
	text_.TextScaled = true
	text_.Text = text
	text_.TextColor3 = color or rgb(255, 255, 255)
	text_.TextStrokeTransparency = 0.2
	text_.Parent = gui
	return text_
end

-- Cheap deterministic noise so the map is identical every build.
local function hash(n: number): number
	local s = math.sin(n * 12.9898) * 43758.5453
	return s - math.floor(s)
end

local function tree(parent: Instance, x: number, z: number, scale: number, seed: number, y0: number?)
	local model = Instance.new("Model")
	model.Name = "Tree"
	model.Parent = parent
	local base = y0 or 0
	local h = 10 * scale
	cylinder(model, "Trunk", h, 2.2 * scale, x, base + h / 2, z, rgb(110, 80, 55), Enum.Material.Wood)
	-- Mostly bright greens, with blossom, autumn and lilac trees mixed in for colour.
	local pick = hash(seed + 0.37)
	local leafColor = if pick < 0.16
		then rgb(255, 165 + math.floor(hash(seed + 2) * 30), 200)
		elseif pick < 0.27 then rgb(245, 145 + math.floor(hash(seed + 2) * 50), 60)
		elseif pick < 0.34 then rgb(185, 150, 245)
		else rgb(60 + math.floor(hash(seed) * 40), 165 + math.floor(hash(seed + 1) * 50), 70)
	ball(model, "Canopy", 9 * scale, x, base + h + 2 * scale, z, leafColor, Enum.Material.Grass)
	ball(model, "Canopy2", 6 * scale, x + 2.5 * scale, base + h + 4.5 * scale, z - 1.5 * scale, leafColor, Enum.Material.Grass)
end

local function lamp(parent: Instance, x: number, z: number)
	local model = Instance.new("Model")
	model.Name = "Lamp"
	model.Parent = parent
	cylinder(model, "Post", 12, 0.8, x, 6, z, rgb(60, 60, 70), Enum.Material.Metal)
	local bulb = ball(model, "Bulb", 2.2, x, 12.5, z, rgb(255, 235, 170), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Range = 20
	light.Brightness = 1.2
	light.Color = rgb(255, 225, 160)
	light.Parent = bulb
end

local function flowerBed(parent: Instance, x: number, z: number, w: number, d: number, seed: number)
	part(parent, "FlowerBed", Vector3.new(w, 1.2, d), at(x, 0.6, z), rgb(100, 70, 50), Enum.Material.Ground)
	local colors = { rgb(255, 120, 150), rgb(255, 220, 90), rgb(160, 120, 255), rgb(255, 255, 255), rgb(255, 140, 70) }
	local count = math.floor(w * d / 10)
	for i = 1, count do
		local fx = x + (hash(seed * 31 + i) - 0.5) * (w - 1.5)
		local fz = z + (hash(seed * 17 + i * 3) - 0.5) * (d - 1.5)
		local color = colors[(i + seed) % #colors + 1]
		cylinder(parent, "Stem", 1.6, 0.25, fx, 2, fz, rgb(60, 140, 60))
		ball(parent, "Bloom", 1.1, fx, 2.9, fz, color, Enum.Material.SmoothPlastic)
	end
end

local function stall(parent: Instance, name: string, x: number, z: number, facing: Vector3, width: number, awning: Color3): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	local base = CFrame.lookAt(Vector3.new(x, 0, z), Vector3.new(x, 0, z) + facing)
	local function rel(u: number, y: number, v: number): CFrame
		-- u = right, v = forward (towards customers)
		return base * CFrame.new(u, y, -v)
	end
	part(model, "Counter", Vector3.new(width, 3.5, 3), rel(0, 1.75, 0), rgb(170, 120, 80), Enum.Material.WoodPlanks)
	part(model, "Back", Vector3.new(width, 12, 1), rel(0, 6, -6), rgb(240, 230, 210), Enum.Material.WoodPlanks)
	for _, side in { -1, 1 } do
		part(model, "Post", Vector3.new(0.8, 12, 0.8), rel(side * (width / 2 - 0.4), 6, 1.2), rgb(150, 100, 70), Enum.Material.Wood)
	end
	local stripes = math.max(2, math.floor(width / 4))
	for i = 1, stripes do
		local u = -width / 2 + (i - 0.5) * (width / stripes)
		local color = if i % 2 == 0 then rgb(255, 255, 255) else awning
		part(model, "Awning", Vector3.new(width / stripes, 0.6, 9), rel(u, 12.5, -2) * CFrame.Angles(math.rad(-12), 0, 0), color, Enum.Material.Fabric)
	end
	local sign = part(model, "Sign", Vector3.new(width * 0.6, 3, 0.6), rel(0, 15.5, -2), awning, Enum.Material.SmoothPlastic)
	label(sign, name, 0, UDim2.fromOffset(300, 60))
	return model
end

----------------------------------------------------------------------------------------------
-- areas

-- Hollow Harvest: 14 marker points for Wisp Lanterns to spawn at (EventService picks 10 of them
-- at random each Fog). Placed along the avenue north of the Plaza (towards the Pond) and south of
-- the Parade (towards the Sky Garden's ground footprint), well clear of the Plaza's ~65-stud
-- radius, the Pond (centred z = -300), the Parade belt (z 79.5-90.5) and every plot's footprint
-- (plots sit at |x| = 105-205; these markers stay within |x| <= 12, so they never overlap a plot
-- regardless of z). Doubles as a squashed-pumpkin decoration so the avenue looks intentional even
-- outside Fog.
local LANTERN_SPAWN_POINTS = {
	{ -12, -90 }, { 12, -110 }, { -12, -130 }, { 12, -150 }, { -12, -170 }, { 12, -190 }, { -12, -210 },
	{ 12, 100 }, { -12, 130 }, { 12, 160 }, { -12, 190 }, { 12, 220 }, { -12, 250 }, { 12, 280 },
}

local function buildLanternSpawns(island: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "LanternSpawns"
	folder.Parent = island
	for i, xz in LANTERN_SPAWN_POINTS do
		local pumpkin = part(folder, "LanternSpawn" .. i, Vector3.new(2.6, 2, 2.6), at(xz[1], 1.5, xz[2]), rgb(230, 130, 40), Enum.Material.Neon, { Shape = Enum.PartType.Ball, CanCollide = false, CanQuery = false })
		pumpkin:SetAttribute("Spot", i)
	end
end

local function buildIsland(map: Instance)
	local island = Instance.new("Folder")
	island.Name = "Island"
	island.Parent = map

	part(island, "Sea", Vector3.new(1400, 2, 1600), at(0, -3, -30), rgb(60, 150, 210), Enum.Material.Glass, { Transparency = 0.25, CanCollide = false })
	part(island, "Seabed", Vector3.new(1400, 2, 1600), at(0, -10, -30), rgb(200, 185, 140), Enum.Material.Sand)
	part(island, "Sand", Vector3.new(520, 2, 760), at(0, -1.4, -30), rgb(235, 215, 160), Enum.Material.Sand)
	part(island, "Grass", Vector3.new(490, 2, 730), at(0, -1, -30), rgb(110, 180, 90), Enum.Material.Grass)
	-- the avenue: a stone path running the full length of the island
	part(island, "Avenue", Vector3.new(44, 0.2, 700), at(0, 0.1, -30), rgb(215, 200, 170), Enum.Material.Cobblestone)

	for i, z in { -250, -200, -130, -90, -20, 120, 160, 200 } do
		lamp(island, -24, z)
		lamp(island, 24, z + 20)
		flowerBed(island, -38, z, 8, 16, i)
		flowerBed(island, 38, z + 20, 8, 16, i + 20)
	end

	-- trees around the shore, skipping the pond and parade areas
	local n = 0
	for i = 0, 71 do
		local angle = (i / 72) * math.pi * 2
		local rx, rz = 225 + hash(i) * 10, 355 + hash(i + 5) * 10
		local x, z = math.cos(angle) * rx, math.sin(angle) * rz - 30
		local inPlotBand = math.abs(x) > 90 and math.abs(x) < 222 and z > -230 and z < 230
		if (math.abs(x) > 60 or (z > -250 and z < 200)) and not inPlotBand then
			n += 1
			tree(island, x, z, 0.9 + hash(i + 9) * 0.6, i)
		end
	end

	buildLanternSpawns(island)
	return n
end

-- Two physical boards (Top Income, Rarest Hatch) just north-west of the Rebirth Shrine, in the
-- gap between it and the Seed Shop. LeaderboardService.luau fills in the BillboardGui text and
-- refreshes it periodically; this function only builds the geometry (no Roblox services, so Lune
-- can still bake it offline).
local function buildLeaderboards(plaza: Instance)
	local model = Instance.new("Model")
	model.Name = "Leaderboards"
	model.Parent = plaza

	local x, z = -48, -33
	local facing = Vector3.new(0, 0, 1) -- faces south, back towards the Rebirth Shrine / spawn
	local base = CFrame.lookAt(Vector3.new(x, 0, z), Vector3.new(x, 0, z) + facing)
	local function rel(u: number, y: number, v: number): CFrame
		return base * CFrame.new(u, y, -v)
	end

	for _, side in { -1, 1 } do
		part(model, "Post", Vector3.new(0.8, 16, 0.8), rel(side * 13, 8, 0), rgb(90, 75, 60), Enum.Material.Wood)
	end
	local header = part(model, "Header", Vector3.new(26, 3, 0.6), rel(0, 16.5, 0), rgb(90, 190, 110), Enum.Material.SmoothPlastic)
	label(header, "Leaderboards", 0, UDim2.fromOffset(320, 60), rgb(255, 250, 220))

	local function board(name: string, u: number)
		local backing = part(model, name, Vector3.new(11, 13, 0.6), rel(u, 8.5, 0), rgb(60, 50, 45), Enum.Material.WoodPlanks)
		local gui = Instance.new("BillboardGui")
		gui.Name = "Label" -- matches the MapBuilder convention: BillboardGui "Label" > TextLabel "Text"
		gui.Size = UDim2.fromOffset(260, 300)
		gui.StudsOffset = Vector3.new(0, 0, 0.4)
		gui.LightInfluence = 0
		gui.MaxDistance = 100
		gui.Parent = backing
		-- TextLabel is a direct child of the BillboardGui ("Label" > "Text"), matching the
		-- MapBuilder convention the `label()` helper above uses. LeaderboardService.init looks
		-- it up with a non-recursive FindFirstChild, which an earlier version of this code broke
		-- by nesting Text inside an extra Background Frame — background color/transparency live
		-- directly on the TextLabel instead (TextLabel supports both, same as Frame).
		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.Size = UDim2.fromScale(0.94, 0.94)
		text.Position = UDim2.fromScale(0.03, 0.03)
		text.BackgroundColor3 = rgb(20, 30, 25)
		text.BackgroundTransparency = 0.1
		text.BorderSizePixel = 0
		text.Font = Enum.Font.FredokaOne
		text.TextScaled = true
		text.TextXAlignment = Enum.TextXAlignment.Left
		text.TextYAlignment = Enum.TextYAlignment.Top
		text.TextColor3 = rgb(255, 255, 255)
		text.TextStrokeTransparency = 0.4
		text.TextWrapped = true
		text.Text = "Loading..."
		text.Parent = gui
	end

	board("IncomeBoard", -6)
	board("RarityBoard", 6)
end

local function buildPlaza(map: Instance)
	local plaza = Instance.new("Folder")
	plaza.Name = "Plaza"
	plaza.Parent = map

	local floor = cylinder(plaza, "Floor", 0.6, 130, 0, 0.3, 0, rgb(225, 215, 195), Enum.Material.Slate)
	floor.Name = "Floor"
	cylinder(plaza, "Ring", 0.7, 126, 0, 0.35, 0, rgb(200, 185, 160), Enum.Material.Slate)
	cylinder(plaza, "Inner", 0.8, 60, 0, 0.4, 0, rgb(235, 225, 205), Enum.Material.Slate)

	-- Dewdrop Fountain
	cylinder(plaza, "FountainBase", 3, 30, 0, 1.5, 0, rgb(190, 190, 200), Enum.Material.Marble)
	cylinder(plaza, "FountainWater", 0.6, 26, 0, 3.1, 0, rgb(90, 180, 240), Enum.Material.Glass).Transparency = 0.3
	cylinder(plaza, "FountainPillar", 12, 4, 0, 7, 0, rgb(200, 200, 210), Enum.Material.Marble)
	local drop = ball(plaza, "Dewdrop", 6, 0, 16, 0, rgb(120, 220, 255), Enum.Material.Neon)
	local glow = Instance.new("PointLight")
	glow.Range = 30
	glow.Color = rgb(120, 220, 255)
	glow.Parent = drop
	emitter(drop, "Spray", {
		Color = ColorSequence.new(rgb(200, 240, 255)),
		Size = fade(0.6, 0.1),
		Rate = 40,
		Lifetime = NumberRange.new(1.2, 1.8),
		Speed = NumberRange.new(14, 18),
		SpreadAngle = Vector2.new(18, 18),
		Acceleration = Vector3.new(0, -24, 0),
		LightEmission = 0.6,
		Transparency = NumberSequence.new(0.25),
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 0.4, 10)
	spawn.CFrame = at(0, 0.9, 24)
	spawn.Color = rgb(235, 225, 205)
	spawn.Material = Enum.Material.Slate
	spawn.Duration = 0
	spawn.Parent = plaza
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end

	-- Seed Shop: long market stall on the north edge with one kiosk per shop species
	local shop = stall(plaza, "Seed Shop", 0, -52, Vector3.new(0, 0, 1), 84, rgb(90, 190, 110))
	local kiosks = Instance.new("Folder")
	kiosks.Name = "Kiosks"
	kiosks.Parent = shop
	for i = 1, 11 do
		local x = -40 + (i - 0.5) * (80 / 11)
		local k = part(kiosks, "Kiosk" .. i, Vector3.new(5, 1, 2.4), at(x, 4, -51), rgb(255, 250, 235), Enum.Material.SmoothPlastic)
		k:SetAttribute("Slot", i)
	end
	local timer = part(shop, "RestockBoard", Vector3.new(16, 4, 0.5), at(0, 19.5, -54), rgb(40, 60, 45), Enum.Material.SmoothPlastic)
	label(timer, "Restock in 5m 00s", 0, UDim2.fromOffset(260, 40), rgb(200, 255, 200))

	local sell = stall(plaza, "Sell Stand", 52, 0, Vector3.new(-1, 0, 0), 18, rgb(240, 180, 60))
	part(sell, "Anchor", Vector3.new(4, 1, 4), at(49, 4, 0), rgb(255, 220, 120), Enum.Material.Neon)

	local rebirth = Instance.new("Model")
	rebirth.Name = "Rebirth Shrine"
	rebirth.Parent = plaza
	cylinder(rebirth, "Step", 1, 20, -50, 0.5, 0, rgb(210, 200, 230), Enum.Material.Marble)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		cylinder(rebirth, "Pillar", 12, 1.5, -50 + math.cos(a) * 8, 6.5, math.sin(a) * 8, rgb(230, 225, 245), Enum.Material.Marble)
	end
	local orb = ball(rebirth, "Anchor", 5, -50, 6, 0, rgb(200, 150, 255), Enum.Material.Neon)
	label(orb, "Rebirth Shrine", 6)

	local daily = stall(plaza, "Daily Gift", -32, 44, Vector3.new(0.6, 0, -0.8).Unit, 14, rgb(240, 110, 150))
	part(daily, "Anchor", Vector3.new(3, 3, 3), at(-31, 5, 42.5), rgb(255, 120, 170), Enum.Material.Neon)

	local supply = stall(plaza, "Sprout Supply", 32, 44, Vector3.new(-0.6, 0, -0.8).Unit, 14, rgb(90, 160, 255))
	part(supply, "Anchor", Vector3.new(3, 3, 3), at(31, 5, 42.5), rgb(120, 190, 255), Enum.Material.Neon)

	-- Hollow Harvest Lantern Stall: reuses the Seed Shop kiosk pattern (see EventService.luau, which
	-- adds the ProximityPrompts and BillboardGui price labels at runtime, same as ShopService does
	-- for the Seed Shop kiosks below).
	local lanternStall = stall(plaza, "Lantern Stall", 0, 58, Vector3.new(0, 0, -1), 20, rgb(255, 140, 40))
	local eventKiosks = Instance.new("Folder")
	eventKiosks.Name = "Kiosks"
	eventKiosks.Parent = lanternStall
	for i, slot in { "pumpkit", "gourdgeist", "skin" } do
		local x = -7 + (i - 1) * 7
		local k = part(eventKiosks, "Kiosk" .. i, Vector3.new(5, 1, 2.4), at(x, 4, 57), rgb(255, 250, 235), Enum.Material.SmoothPlastic)
		k:SetAttribute("Slot", slot)
	end

	buildLeaderboards(plaza)

	for i = 0, 7 do
		local a = (i + 0.5) / 8 * math.pi * 2
		lamp(plaza, math.cos(a) * 60, math.sin(a) * 60)
	end
end

local function buildPlot(plots: Instance, index: number)
	local cx, cz, d = MapBuilder.plotPlacement(index)
	local colorInfo = MapBuilder.PlotColors[index]
	local color = rgb(colorInfo[2], colorInfo[3], colorInfo[4])
	local half = MapBuilder.PlotSize / 2

	local plot = Instance.new("Model")
	plot.Name = "Plot" .. index
	plot:SetAttribute("Index", index)
	plot:SetAttribute("ColorName", colorInfo[1])
	plot:SetAttribute("Inward", d)
	plot.Parent = plots

	local function w(u: number, y: number, v: number): Vector3
		return Vector3.new(cx + d * u, y, cz + v)
	end
	local facing = Vector3.new(d, 0, 0)

	local floor = part(plot, "Floor", Vector3.new(MapBuilder.PlotSize, 1, MapBuilder.PlotSize), at(cx, 0.5, cz), rgb(125, 190, 100), Enum.Material.Grass)
	plot.PrimaryPart = floor
	-- coloured border so plots are recognisable from afar
	for _, e in { { 0, -half }, { 0, half } } do
		part(plot, "Border", Vector3.new(MapBuilder.PlotSize, 1.2, 2), CFrame.new(w(e[1], 0.6, e[2])), color, Enum.Material.SmoothPlastic)
	end
	part(plot, "Border", Vector3.new(2, 1.2, MapBuilder.PlotSize), CFrame.new(w(-half, 0.6, 0)), color, Enum.Material.SmoothPlastic)

	-- hedges on the three non-gate sides
	part(plot, "Hedge", Vector3.new(MapBuilder.PlotSize, 8, 3), CFrame.new(w(0, 4, -half - 1.5)), rgb(70, 140, 60), Enum.Material.Grass)
	part(plot, "Hedge", Vector3.new(MapBuilder.PlotSize, 8, 3), CFrame.new(w(0, 4, half + 1.5)), rgb(70, 140, 60), Enum.Material.Grass)
	part(plot, "Hedge", Vector3.new(3, 8, MapBuilder.PlotSize + 6), CFrame.new(w(-half - 1.5, 4, 0)), rgb(70, 140, 60), Enum.Material.Grass)

	-- soil tiles
	local soil = Instance.new("Folder")
	soil.Name = "Soil"
	soil.Parent = plot
	for tile = 1, 12 do
		local u, v = MapBuilder.soilLocal(tile)
		local s = part(soil, "Soil" .. tile, Vector3.new(12, 1.2, 12), CFrame.new(w(u, 1.1, v)), rgb(110, 75, 50), Enum.Material.Ground)
		s:SetAttribute("Tile", tile)
	end

	-- greenhouse over the pad area
	local gh = Instance.new("Model")
	gh.Name = "Greenhouse"
	gh.Parent = plot
	part(gh, "GreenhouseFloor", Vector3.new(34, 0.4, 98), CFrame.new(w(-30, 1.2, 0)), rgb(235, 230, 220), Enum.Material.Marble)
	for _, v in { -48, -16, 16, 48 } do
		for _, u in { -47, -13 } do
			part(gh, "Frame", Vector3.new(1, 16, 1), CFrame.new(w(u, 9, v)), rgb(245, 245, 245), Enum.Material.Metal)
		end
	end
	part(gh, "Roof", Vector3.new(36, 0.6, 100), CFrame.new(w(-30, 17.3, 0)), rgb(200, 240, 255), Enum.Material.Glass, { Transparency = 0.6 })
	part(gh, "RoofTrim", Vector3.new(36, 1, 2), CFrame.new(w(-30, 17.8, 0)), color, Enum.Material.SmoothPlastic)

	local pads = Instance.new("Folder")
	pads.Name = "Pads"
	pads.Parent = plot
	for pad = 1, 12 do
		local u, v = MapBuilder.padLocal(pad)
		local p = cylinder(pads, "Pad" .. pad, 1, 9, 0, 0, 0, rgb(250, 250, 250), Enum.Material.Marble)
		p.CFrame = CFrame.new(w(u, 1.9, v)) * CFrame.Angles(0, 0, math.rad(90))
		p.Name = "Pad" .. pad
		p:SetAttribute("Pad", pad)
		p:SetAttribute("Bonus", pad > 8)
		if pad > 8 then
			p.Transparency = 0.7
		end
		local rim = cylinder(pads, "Rim" .. pad, 0.4, 9.6, 0, 0, 0, color, Enum.Material.Neon)
		rim.CFrame = CFrame.new(w(u, 1.5, v)) * CFrame.Angles(0, 0, math.rad(90))
	end

	-- gate: two pillars, a laser curtain (visible when locked) and the lock button
	local gate = Instance.new("Model")
	gate.Name = "Gate"
	gate.Parent = plot
	for _, v in { -half - 1.5, half + 1.5 } do
		part(gate, "Pillar", Vector3.new(4, 14, 4), CFrame.new(w(half, 7, v)), color, Enum.Material.SmoothPlastic)
		ball(gate, "PillarCap", 4.5, w(half, 14.5, v).X, 14.5, v + cz, color, Enum.Material.Neon)
	end
	part(gate, "Laser", Vector3.new(0.6, 10, MapBuilder.PlotSize), CFrame.new(w(half, 5, 0)), rgb(255, 60, 60), Enum.Material.ForceField, { Transparency = 1, CanCollide = false, CanQuery = false })
	local button = part(gate, "LockButton", Vector3.new(3, 3, 3), CFrame.lookAt(w(half - 5, 2.5, -half + 6), w(half - 5, 2.5, -half + 6) + facing), rgb(255, 80, 80), Enum.Material.Neon)
	part(gate, "LockPost", Vector3.new(2, 1, 2), CFrame.new(w(half - 5, 0.9, -half + 6)), rgb(80, 80, 90), Enum.Material.Metal)
	label(button, "LOCK", 3, UDim2.fromOffset(160, 40))

	-- owner sign over the gate
	local sign = part(plot, "Sign", Vector3.new(1, 5, 30), CFrame.new(w(half + 2, 16, 0)), rgb(250, 245, 230), Enum.Material.WoodPlanks)
	label(sign, colorInfo[1] .. " plot - unclaimed", 4, UDim2.fromOffset(360, 70), color)

	local spawnPoint = part(plot, "SpawnPoint", Vector3.new(4, 1, 4), CFrame.lookAt(w(-4, 3.5, 0), w(-4, 3.5, 0) + facing), color, Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false })
	spawnPoint:SetAttribute("Spawn", true)
end

local function buildParade(map: Instance)
	local parade = Instance.new("Model")
	parade.Name = "Parade"
	parade.Parent = map
	-- low belt with walk-through rails so the avenue stays passable
	part(parade, "Belt", Vector3.new(150, 0.8, 10), at(0, 0.5, 85), rgb(60, 60, 70), Enum.Material.DiamondPlate)
	part(parade, "RailNorth", Vector3.new(150, 0.8, 1), at(0, 1.2, 79.5), rgb(255, 210, 90), Enum.Material.SmoothPlastic, { CanCollide = false })
	part(parade, "RailSouth", Vector3.new(150, 0.8, 1), at(0, 1.2, 90.5), rgb(255, 210, 90), Enum.Material.SmoothPlastic, { CanCollide = false })
	part(parade, "Start", Vector3.new(2, 2, 2), at(-72, 2.7, 85), rgb(255, 255, 255), nil, { Transparency = 1, CanCollide = false })
	part(parade, "Finish", Vector3.new(2, 2, 2), at(72, 2.7, 85), rgb(255, 255, 255), nil, { Transparency = 1, CanCollide = false })
	for _, x in { -78, 78 } do
		local arch = part(parade, "Arch", Vector3.new(4, 14, 16), at(x, 7, 85), rgb(250, 170, 60), Enum.Material.SmoothPlastic)
		if x < 0 then
			label(arch, "Pollen Parade", 9, UDim2.fromOffset(300, 70), rgb(255, 240, 150))
		end
	end
	part(parade, "Items", Vector3.new(1, 1, 1), at(0, -20, 85), rgb(0, 0, 0), nil, { Transparency = 1, CanCollide = false }).Name = "ItemsAnchor"
	local items = Instance.new("Folder")
	items.Name = "Items"
	items.Parent = parade
end

local function buildPond(map: Instance)
	local pond = Instance.new("Model")
	pond.Name = "Pond"
	pond.Parent = map
	local rim = cylinder(pond, "Rim", 1.2, 98, 0, 0.2, -300, rgb(170, 160, 150), Enum.Material.Slate)
	-- QA m11: Rim is a full disc reaching under the whole pond, not just its edge, and its top
	-- (y 0.8) sits just under the water surface (y 1.05) -- with default CanCollide=true, players
	-- could walk across the entire pond as if it were solid ground barely covered by water.
	-- Fix (game-designer decision, 2026-09-26): CanCollide=false, same as Water below. Anyone who
	-- goes in now sinks to PondBed (top y -1.5, about 2.5 studs under the surface) instead -- a
	-- shallow wade, which fits a fishing pond you're meant to cast into from the Dock, not a floor
	-- you walk across. Not a ring/annulus (the QA note's other option): that needs a part shape
	-- this codebase's helpers don't build, for a purely cosmetic fix.
	rim.CanCollide = false
	local water = cylinder(pond, "Water", 1.4, 90, 0, 0.35, -300, rgb(70, 170, 200), Enum.Material.Glass)
	water.Transparency = 0.2
	water.CanCollide = false
	cylinder(pond, "PondBed", 1, 90, 0, -2, -300, rgb(60, 110, 110), Enum.Material.Mud)
	part(pond, "Dock", Vector3.new(12, 1, 44), at(0, 1.4, -262), rgb(160, 115, 75), Enum.Material.WoodPlanks)
	part(pond, "DockEnd", Vector3.new(34, 1, 10), at(0, 1.4, -286), rgb(160, 115, 75), Enum.Material.WoodPlanks)
	for i, x in { -14, -5, 5, 14 } do
		local spot = part(pond, "CastSpot" .. i, Vector3.new(3, 0.3, 3), at(x, 2, -289), rgb(120, 220, 255), Enum.Material.Neon)
		spot:SetAttribute("CastSpot", i)
	end
	for i = 1, 9 do
		local a = i / 9 * math.pi * 2
		local r = 22 + hash(i) * 16
		local lily = cylinder(pond, "LilyPad", 0.3, 4 + hash(i + 3) * 3, math.cos(a) * r, 1.2, -300 + math.sin(a) * r, rgb(90, 170, 80), Enum.Material.Grass)
		lily.CanCollide = false
		if i % 2 == 1 then
			local blossom = ball(pond, "LilyBlossom", 1.4, math.cos(a) * r + 0.6, 1.8, -300 + math.sin(a) * r, if i % 4 == 1 then rgb(255, 150, 200) else rgb(255, 245, 250), Enum.Material.Neon)
			blossom.CanCollide = false
		end
	end
	for _, x in { -18, 18 } do
		lamp(pond, x, -280)
	end
	local sign = part(pond, "Sign", Vector3.new(10, 4, 1), at(0, 4, -238), rgb(160, 115, 75), Enum.Material.WoodPlanks)
	label(sign, "Wishing Pond", 3, UDim2.fromOffset(260, 60), rgb(160, 230, 255))
end

local function buildSkyGarden(map: Instance)
	local sky = Instance.new("Model")
	sky.Name = "SkyGarden"
	sky.Parent = map
	local pad = cylinder(sky, "LaunchPad", 1, 14, 0, 0.6, 240, rgb(170, 120, 255), Enum.Material.Neon)
	label(pad, "Sky Garden (Rebirth 1+)", 5, UDim2.fromOffset(300, 60), rgb(220, 200, 255))
	cylinder(sky, "Island", 8, 80, 0, 88, 300, rgb(110, 180, 90), Enum.Material.Grass)
	cylinder(sky, "Underside", 10, 60, 0, 80, 300, rgb(130, 110, 90), Enum.Material.Rock)
	part(sky, "Landing", Vector3.new(8, 1, 8), at(0, 92.5, 275), rgb(220, 200, 255), Enum.Material.Neon, { Transparency = 0.5 })
	local well = cylinder(sky, "WellBase", 4, 12, 0, 94, 305, rgb(200, 200, 215), Enum.Material.Marble)
	well.Name = "WellBase"
	local wellWater = cylinder(sky, "SkyWell", 0.5, 10, 0, 96.1, 305, rgb(180, 140, 255), Enum.Material.Neon)
	label(wellWater, "Sky Well", 5)
	part(sky, "ReturnPad", Vector3.new(8, 1, 8), at(0, 92.5, 330), rgb(255, 255, 255), Enum.Material.Neon, { Transparency = 0.3 })
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		tree(sky, math.cos(a) * 30, 300 + math.sin(a) * 30, 0.8, 100 + i)
	end
end

----------------------------------------------------------------------------------------------
-- scenery: atmosphere pieces with no gameplay role (all under Map.Scenery)

local function cottage(parent: Instance, x: number, z: number, facing: Vector3, seed: number, storeys: number?, awning: Color3?)
	local model = Instance.new("Model")
	model.Name = "Cottage"
	model.Parent = parent
	local base = CFrame.lookAt(Vector3.new(x, 0, z), Vector3.new(x, 0, z) + facing)
	local function rel(u: number, y: number, v: number): CFrame
		return base * CFrame.new(u, y, -v) -- u = right, v = forward (towards the avenue)
	end
	local walls = { rgb(250, 238, 215), rgb(255, 214, 200), rgb(220, 240, 220), rgb(255, 230, 170), rgb(215, 225, 250) }
	local roofs = { rgb(205, 85, 70), rgb(70, 110, 180), rgb(60, 160, 150), rgb(225, 160, 60), rgb(150, 90, 170) }
	local wall = walls[seed % #walls + 1]
	local roof = roofs[(seed * 3) % #roofs + 1]
	local beam = rgb(110, 75, 50)
	local floors = storeys or 1
	local W, D, H, rise = 16, 12, 10 * floors, 6

	part(model, "Footing", Vector3.new(W + 1, 1.4, D + 1), rel(0, 0.7, 0), rgb(150, 145, 140), Enum.Material.Cobblestone)
	part(model, "Walls", Vector3.new(W, H, D), rel(0, H / 2 + 1, 0), wall, Enum.Material.Plaster)
	-- attic: a prism rotated 45 degrees whose lower half hides inside the walls, filling the gables
	local attic = math.sqrt(2) * rise
	part(model, "Attic", Vector3.new(W - 0.2, attic, attic), rel(0, H + 1, 0) * CFrame.Angles(math.rad(45), 0, 0), wall, Enum.Material.Plaster)
	-- timber frame on the front face
	for _, u in { -W / 2 + 0.4, -2.6, 2.6, W / 2 - 0.4 } do
		part(model, "Timber", Vector3.new(0.8, H, 0.5), rel(u, H / 2 + 1, D / 2 + 0.1), beam, Enum.Material.Wood)
	end
	part(model, "Timber", Vector3.new(W, 0.8, 0.5), rel(0, H + 0.8, D / 2 + 0.1), beam, Enum.Material.Wood)
	part(model, "Timber", Vector3.new(W, 0.6, 0.5), rel(0, 5.6, D / 2 + 0.1), beam, Enum.Material.Wood)
	for floor = 2, floors do
		local y0 = (floor - 1) * 10
		part(model, "Timber", Vector3.new(W, 0.8, 0.5), rel(0, y0 + 1, D / 2 + 0.1), beam, Enum.Material.Wood)
		for _, u in { -4.5, 0, 4.5 } do
			part(model, "WindowFrame", Vector3.new(3, 3.4, 0.3), rel(u, y0 + 6.5, D / 2 + 0.15), beam, Enum.Material.Wood)
			part(model, "Window", Vector3.new(2.2, 2.6, 0.3), rel(u, y0 + 6.5, D / 2 + 0.25), rgb(255, 215, 140), Enum.Material.Neon)
			part(model, "Shutter", Vector3.new(1, 3.2, 0.25), rel(u - 2, y0 + 6.5, D / 2 + 0.2), roof, Enum.Material.WoodPlanks)
		end
	end
	if awning then
		for i = 1, 4 do
			local u = -W / 2 + (i - 0.5) * (W / 4)
			part(model, "Awning", Vector3.new(W / 4, 0.5, 4), rel(u, 9.4, D / 2 + 2) * CFrame.Angles(math.rad(-18), 0, 0), if i % 2 == 0 then rgb(255, 255, 255) else awning, Enum.Material.Fabric)
		end
	end
	-- roof: two tilted slabs and a ridge
	local slope = math.atan(rise / (D / 2))
	local length = math.sqrt(rise * rise + (D / 2) ^ 2) + 2
	for _, side in { 1, -1 } do
		part(model, "Roof", Vector3.new(W + 2, 0.9, length), rel(0, H + 1 + rise / 2 + 0.4, side * D / 4) * CFrame.Angles(-side * slope, 0, 0), roof, Enum.Material.Slate)
	end
	part(model, "Ridge", Vector3.new(W + 2.4, 1, 1), rel(0, H + 1 + rise + 0.5, 0), Color3.new(roof.R * 0.75, roof.G * 0.75, roof.B * 0.75), Enum.Material.Wood)
	part(model, "Chimney", Vector3.new(2.2, 7, 2.2), rel(W / 2 - 3.5, H + rise, -D / 4), rgb(170, 110, 90), Enum.Material.Brick)
	-- door, lit windows and window boxes
	part(model, "Door", Vector3.new(3.4, 6.2, 0.4), rel(0, 4.1, D / 2 + 0.2), rgb(120, 80, 55), Enum.Material.WoodPlanks)
	local knob = ball(model, "Knob", 0.4, 0, 0, 0, rgb(240, 200, 90), Enum.Material.Metal)
	knob.CFrame = rel(1.1, 4, D / 2 + 0.45)
	for _, u in { -5.3, 5.3 } do
		part(model, "WindowFrame", Vector3.new(3.4, 3.4, 0.3), rel(u, 7, D / 2 + 0.15), beam, Enum.Material.Wood)
		local pane = part(model, "Window", Vector3.new(2.6, 2.6, 0.3), rel(u, 7, D / 2 + 0.25), rgb(255, 210, 130), Enum.Material.Neon)
		if u > 0 then
			glowLight(pane, 14, 0.8, rgb(255, 200, 130))
		end
		part(model, "WindowBox", Vector3.new(3.6, 0.9, 1), rel(u, 5, D / 2 + 0.6), rgb(150, 100, 70), Enum.Material.Wood)
		for i = 1, 4 do
			local flowerColors = { rgb(255, 110, 150), rgb(255, 225, 90), rgb(170, 130, 255), rgb(255, 255, 255) }
			local bloom = ball(model, "WindowBloom", 0.8, 0, 0, 0, flowerColors[(i + seed) % 4 + 1])
			bloom.CFrame = rel(u - 1.65 + i * 0.66, 5.7, D / 2 + 0.7)
		end
	end
	-- a little lantern by the door
	local lantern = ball(model, "DoorLantern", 0.9, 0, 0, 0, rgb(255, 215, 140), Enum.Material.Neon)
	lantern.CFrame = rel(-2.6, 8.4, D / 2 + 0.8)
	return model
end

local function lanternTower(parent: Instance, x: number, z: number, accent: Color3)
	local model = Instance.new("Model")
	model.Name = "LanternTower"
	model.Parent = parent
	cylinder(model, "Base", 4, 9, x, 2, z, rgb(165, 160, 150), Enum.Material.Cobblestone)
	cylinder(model, "Shaft", 22, 6.5, x, 15, z, rgb(200, 195, 185), Enum.Material.Brick)
	cylinder(model, "Balcony", 1, 10, x, 26.5, z, rgb(120, 85, 60), Enum.Material.WoodPlanks)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		cylinder(model, "Post", 6, 0.6, x + math.cos(a) * 3.6, 30, z + math.sin(a) * 3.6, rgb(110, 75, 50), Enum.Material.Wood)
	end
	local flame = ball(model, "Flame", 4, x, 30, z, rgb(255, 190, 90), Enum.Material.Neon)
	glowLight(flame, 45, 1.6, rgb(255, 200, 120))
	emitter(flame, "Embers", {
		Color = ColorSequence.new(rgb(255, 220, 120), rgb(255, 120, 40)),
		Size = fade(0.5, 0),
		Rate = 10,
		Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(3, 6),
		SpreadAngle = Vector2.new(25, 25),
		LightEmission = 1,
	})
	-- tiered roof
	for i, d in { 10, 7.5, 5, 2.5 } do
		cylinder(model, "Roof", 1.4, d, x, 33 + i * 1.3, z, accent, Enum.Material.Slate)
	end
	ball(model, "Finial", 1.4, x, 39.5, z, rgb(255, 225, 120), Enum.Material.Neon)
end

-- Windmill whose sail assembly the client spins (attribute SpinSpeed, degrees per second).
local function windmill(parent: Instance, x: number, z: number, facing: Vector3)
	local model = Instance.new("Model")
	model.Name = "Windmill"
	model.Parent = parent
	for i, d in { 16, 14.5, 13, 11.5, 10 } do
		cylinder(model, "Tower", 6, d, x, (i - 0.5) * 6, z, if i % 2 == 0 then rgb(240, 235, 225) else rgb(225, 218, 205), Enum.Material.Plaster)
	end
	for i, d in { 12, 9, 6, 3 } do
		cylinder(model, "Cap", 2, d, x, 30 + i * 2, z, rgb(200, 80, 70), Enum.Material.Slate)
	end
	part(model, "Door", Vector3.new(4, 7, 1), CFrame.lookAt(Vector3.new(x, 3.5, z) + facing * 7.8, Vector3.new(x, 3.5, z) + facing * 9), rgb(120, 80, 55), Enum.Material.WoodPlanks)

	local sails = Instance.new("Model")
	sails.Name = "Sails"
	sails.Parent = model
	local hubPos = Vector3.new(x, 28, z) + facing * 7
	local hubCf = CFrame.lookAt(hubPos, hubPos + facing)
	local hub = part(sails, "Hub", Vector3.new(2.6, 2.6, 2.6), hubCf, rgb(110, 75, 50), Enum.Material.Wood)
	sails.PrimaryPart = hub
	for i = 0, 3 do
		local spoke = hubCf * CFrame.Angles(0, 0, i * math.pi / 2)
		part(sails, "Arm", Vector3.new(0.8, 22, 0.8), spoke * CFrame.new(0, 11, 0), rgb(110, 75, 50), Enum.Material.Wood)
		part(sails, "Sail", Vector3.new(5, 16, 0.3), spoke * CFrame.new(3, 13, 0.3), rgb(250, 248, 240), Enum.Material.Fabric)
		part(sails, "SailTip", Vector3.new(5, 3, 0.35), spoke * CFrame.new(3, 22.5, 0.3), rgb(220, 70, 70), Enum.Material.Fabric)
	end
	for _, p in sails:GetChildren() do
		if p:IsA("BasePart") then
			p.CanCollide = false
		end
	end
	sails:SetAttribute("SpinSpeed", 25)
end

-- A string of coloured festoon bulbs between two points.
local function festoon(parent: Instance, a: Vector3, b: Vector3, seed: number)
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	deco(part(parent, "FestoonWire", Vector3.new(0.15, 0.15, length), CFrame.lookAt(mid, b), rgb(50, 45, 40)))
	local colors = { rgb(255, 90, 120), rgb(255, 210, 70), rgb(90, 220, 255), rgb(150, 255, 120), rgb(200, 130, 255), rgb(255, 150, 60) }
	local count = math.floor(length / 5)
	for i = 1, count do
		local f = i / (count + 1)
		local sag = math.sin(f * math.pi) * 1.6
		local pos = a + (b - a) * f - Vector3.new(0, sag + 0.5, 0)
		deco(ball(parent, "FestoonBulb", 0.9, pos.X, pos.Y, pos.Z, colors[(i + seed) % #colors + 1], Enum.Material.Neon))
	end
end

-- Tall translucent light column (two nested cylinders) rising from (x, y0, z).
local function lightBeam(parent: Instance, name: string, x: number, y0: number, z: number, height: number, width: number, color: Color3)
	local core = deco(cylinder(parent, name, height, width, x, y0 + height / 2, z, color, Enum.Material.Neon))
	core.Transparency = 0.45
	local halo = deco(cylinder(parent, name .. "Halo", height, width * 2.6, x, y0 + height / 2, z, color, Enum.Material.Neon))
	halo.Transparency = 0.86
	emitter(core, "Motes", {
		Color = ColorSequence.new(rgb(255, 255, 255), color),
		Size = fade(0.7, 0),
		Rate = 6,
		Lifetime = NumberRange.new(4, 6),
		Speed = NumberRange.new(4, 8),
		EmissionDirection = Enum.NormalId.Top,
		LightEmission = 1,
		Transparency = fade(0.1, 1),
	})
	return core
end

-- Glowing crystal cluster; the client bobs and turns the ones tagged with Bob.
local function crystal(parent: Instance, x: number, y: number, z: number, scale: number, color: Color3, seed: number, bob: boolean)
	local model = Instance.new("Model")
	model.Name = "Crystal"
	model.Parent = parent
	local main = part(model, "Shard", Vector3.new(2.4, 7, 2.4) * scale, CFrame.new(x, y + 3.5 * scale, z) * CFrame.Angles(0, math.rad(seed * 37), math.rad(8)), color, Enum.Material.Neon)
	model.PrimaryPart = main
	for i = 1, 3 do
		local a = (i / 3 + hash(seed + i) * 0.2) * math.pi * 2
		part(model, "Shard", Vector3.new(1.4, 4, 1.4) * scale, CFrame.new(x + math.cos(a) * 1.8 * scale, y + 2 * scale, z + math.sin(a) * 1.8 * scale) * CFrame.Angles(math.cos(a) * 0.5, a, math.sin(a) * 0.5), color, Enum.Material.Neon)
	end
	for _, p in model:GetChildren() do
		deco(p :: BasePart)
	end
	glowLight(main, 18 * scale, 1.2, color)
	emitter(main, "Glint", {
		Color = ColorSequence.new(rgb(255, 255, 255), color),
		Size = fade(0.4, 0),
		Rate = 3,
		Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(1, 2),
		SpreadAngle = Vector2.new(180, 180),
		LightEmission = 1,
	})
	if bob then
		model:SetAttribute("Bob", true)
	end
end

-- A falling ribbon of water from (x, top, z) down to the sea, with spray at the bottom.
local function waterfall(parent: Instance, x: number, top: number, z: number, width: number, facing: Vector3)
	local height = top + 2
	local cf = CFrame.lookAt(Vector3.new(x, top - height / 2, z), Vector3.new(x, top - height / 2, z) + facing)
	local sheet = deco(part(parent, "Waterfall", Vector3.new(width, height, 1.2), cf, rgb(95, 185, 240), Enum.Material.Glass))
	sheet.Transparency = 0.2
	-- brighter white-water streak down the middle
	local foam = deco(part(parent, "WaterfallFoam", Vector3.new(width * 0.35, height, 0.4), cf * CFrame.new(0, 0, -0.7), rgb(225, 245, 255), Enum.Material.SmoothPlastic))
	foam.Transparency = 0.35
	local back = deco(part(parent, "WaterfallBack", Vector3.new(width + 2, height, 0.6), cf * CFrame.new(0, 0, 1), rgb(50, 130, 200), Enum.Material.Glass))
	back.Transparency = 0.35
	emitter(sheet, "Streaks", {
		Color = ColorSequence.new(rgb(235, 250, 255)),
		Size = fade(0.8, 0.3),
		Rate = 25,
		Lifetime = NumberRange.new(2, 3),
		Speed = NumberRange.new(30, 40),
		EmissionDirection = Enum.NormalId.Bottom,
		LightEmission = 0.5,
		Transparency = fade(0.3, 0.9),
	})
	local splash = deco(part(parent, "Splash", Vector3.new(width + 6, 1, 8), CFrame.new(x, -1, z), rgb(255, 255, 255), nil, { Transparency = 1 }))
	emitter(splash, "Mist", {
		Color = ColorSequence.new(rgb(255, 255, 255)),
		Size = fade(4, 9),
		Rate = 12,
		Lifetime = NumberRange.new(2, 3),
		Speed = NumberRange.new(4, 8),
		SpreadAngle = Vector2.new(60, 60),
		EmissionDirection = Enum.NormalId.Top,
		Transparency = fade(0.5, 1),
		RotSpeed = NumberRange.new(-20, 20),
	})
end

local function floatingIslet(parent: Instance, x: number, y: number, z: number, r: number, seed: number, falls: boolean)
	local model = Instance.new("Model")
	model.Name = "Islet"
	model.Parent = parent
	cylinder(model, "Top", 3, r * 2, x, y, z, rgb(105, 190, 85), Enum.Material.Grass)
	cylinder(model, "Soil", 4, r * 2 - 1, x, y - 3.4, z, rgb(130, 95, 65), Enum.Material.Ground)
	cylinder(model, "Rock", r * 0.5, r * 1.5, x, y - 5.4 - r * 0.25, z, rgb(140, 125, 115), Enum.Material.Rock)
	cylinder(model, "Rock", r * 0.5, r * 0.9, x + r * 0.08, y - 5.4 - r * 0.7, z - r * 0.05, rgb(125, 110, 100), Enum.Material.Rock)
	ball(model, "RockTip", r * 0.55, x - r * 0.05, y - 5.4 - r * 1.05, z + r * 0.05, rgb(115, 100, 95), Enum.Material.Rock)
	-- hanging roots
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2 + hash(seed + i)
		local len = 6 + hash(seed * 3 + i) * 10
		cylinder(model, "Root", len, 0.5, x + math.cos(a) * r * 0.7, y - 5 - len / 2, z + math.sin(a) * r * 0.7, rgb(95, 120, 60), Enum.Material.Grass)
	end
	for i = 1, math.max(1, math.floor(r / 12)) do
		local a = hash(seed + i * 7) * math.pi * 2
		local d = hash(seed + i * 11) * r * 0.55
		tree(model, x + math.cos(a) * d, z + math.sin(a) * d, 0.8 + hash(seed + i) * 0.5, seed * 10 + i, y + 1.5)
	end
	local crystalColors = { rgb(120, 230, 255), rgb(255, 130, 200), rgb(190, 140, 255), rgb(140, 255, 170) }
	local ca = hash(seed + 5) * math.pi * 2
	crystal(model, x + math.cos(ca) * r * 0.6, y + 1.5, z + math.sin(ca) * r * 0.6, 0.9, crystalColors[seed % 4 + 1], seed, false)
	if falls then
		-- pour off the edge facing the main island
		local toward = Vector3.new(-x, 0, -z).Unit
		local edge = Vector3.new(x, 0, z) + toward * (r - 0.5)
		waterfall(model, edge.X, y + 1, edge.Z, math.max(5, r * 0.2), toward)
	end
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
		end
	end
end

local function cloud(parent: Instance, x: number, y: number, z: number, scale: number, seed: number)
	local model = Instance.new("Model")
	model.Name = "Cloud"
	model.Parent = parent
	for i = 1, 6 do
		local ox = (i - 3.5) * 9 * scale
		local d = (14 + hash(seed + i) * 12) * scale
		local p = deco(ball(model, "Puff", d, x + ox, y + hash(seed * 2 + i) * 5 * scale, z + (hash(seed * 3 + i) - 0.5) * 12 * scale, rgb(255, 255, 255)))
		p.Transparency = 0.12
	end
end

-- Drifting glowing motes in a box-shaped volume.
local function motes(parent: Instance, name: string, cf: CFrame, size: Vector3, color: Color3, rate: number)
	local volume = deco(part(parent, name, size, cf, color, nil, { Transparency = 1 }))
	emitter(volume, "Motes", {
		Shape = Enum.ParticleEmitterShape.Box,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
		Color = ColorSequence.new(color),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.2, 0.35),
			NumberSequenceKeypoint.new(0.8, 0.35),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Rate = rate,
		Lifetime = NumberRange.new(5, 8),
		Speed = NumberRange.new(0.5, 1.5),
		SpreadAngle = Vector2.new(180, 180),
		LightEmission = 1,
		Drag = 0.5,
	})
end

-- A cylinder running from point a to point b (for trunks, branches and posts at an angle).
local function segment(parent: Instance, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, material: any?): BasePart
	local length = (b - a).Magnitude
	local p = part(parent, name, Vector3.new(length, diameter, diameter), CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- Flat stone path between two ground points.
local function path(parent: Instance, a: Vector3, b: Vector3, width: number)
	local mid = (a + b) / 2
	part(parent, "Path", Vector3.new(width, 0.25, (b - a).Magnitude), CFrame.lookAt(Vector3.new(mid.X, 0.12, mid.Z), Vector3.new(b.X, 0.12, b.Z)), rgb(200, 190, 170), Enum.Material.Cobblestone, { CanCollide = false })
end

local function barrel(parent: Instance, x: number, z: number)
	cylinder(parent, "Barrel", 3.6, 3, x, 1.8, z, rgb(150, 100, 60), Enum.Material.WoodPlanks)
	cylinder(parent, "Hoop", 0.4, 3.15, x, 2.8, z, rgb(80, 80, 85), Enum.Material.Metal)
	cylinder(parent, "Hoop", 0.4, 3.15, x, 0.8, z, rgb(80, 80, 85), Enum.Material.Metal)
end

local function crate(parent: Instance, x: number, y: number, z: number, size: number, turn: number)
	part(parent, "Crate", Vector3.new(size, size, size), CFrame.new(x, y + size / 2, z) * CFrame.Angles(0, turn, 0), rgb(190, 145, 90), Enum.Material.WoodPlanks)
end

local function bench(parent: Instance, x: number, z: number, facing: Vector3)
	local base = CFrame.lookAt(Vector3.new(x, 0, z), Vector3.new(x, 0, z) + facing)
	part(parent, "BenchSeat", Vector3.new(6, 0.5, 2), base * CFrame.new(0, 1.8, 0), rgb(170, 120, 75), Enum.Material.WoodPlanks)
	part(parent, "BenchBack", Vector3.new(6, 2, 0.4), base * CFrame.new(0, 3, 0.9), rgb(170, 120, 75), Enum.Material.WoodPlanks)
	for _, u in { -2.5, 2.5 } do
		part(parent, "BenchLeg", Vector3.new(0.5, 1.8, 2), base * CFrame.new(u, 0.9, 0), rgb(70, 70, 75), Enum.Material.Metal)
	end
end

local function cart(parent: Instance, x: number, z: number, turn: number, produce: Color3)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, turn, 0)
	part(parent, "CartBed", Vector3.new(5, 1, 8), base * CFrame.new(0, 2.6, 0), rgb(160, 110, 70), Enum.Material.WoodPlanks)
	for _, s in { -1, 1 } do
		part(parent, "CartSide", Vector3.new(0.4, 1.6, 8), base * CFrame.new(s * 2.5, 3.6, 0), rgb(140, 95, 60), Enum.Material.WoodPlanks)
		local wheel = part(parent, "Wheel", Vector3.new(0.6, 4, 4), base * CFrame.new(s * 2.9, 2, 1), rgb(110, 75, 50), Enum.Material.Wood)
		wheel.Shape = Enum.PartType.Cylinder
	end
	for i = 1, 6 do
		local fruit = part(parent, "Produce", Vector3.new(1.6, 1.6, 1.6), base * CFrame.new(((i - 1) % 2 - 0.5) * 2, 3.8, (i - 3.5) * 1.1), produce, Enum.Material.SmoothPlastic)
		fruit.Shape = Enum.PartType.Ball
	end
end

local function haystack(parent: Instance, x: number, z: number, d: number)
	cylinder(parent, "Hay", d * 0.6, d, x, d * 0.3, z, rgb(235, 200, 100), Enum.Material.Fabric)
	ball(parent, "HayTop", d * 0.9, x, d * 0.6, z, rgb(240, 210, 110), Enum.Material.Fabric)
end

local function well(parent: Instance, x: number, z: number)
	cylinder(parent, "WellWall", 3, 7, x, 1.5, z, rgb(170, 165, 160), Enum.Material.Cobblestone)
	cylinder(parent, "WellWater", 0.4, 5.6, x, 2.8, z, rgb(80, 170, 220), Enum.Material.Glass)
	for _, s in { -1, 1 } do
		part(parent, "WellPost", Vector3.new(0.6, 7, 0.6), at(x + s * 3, 5, z), rgb(110, 75, 50), Enum.Material.Wood)
	end
	for _, s in { -1, 1 } do
		part(parent, "WellRoof", Vector3.new(8, 0.5, 4.4), at(x, 9.3, z + s * 1.6) * CFrame.Angles(s * math.rad(35), 0, 0), rgb(205, 85, 70), Enum.Material.Slate)
	end
	cylinder(parent, "Bucket", 1.4, 1.4, x, 4.2, z, rgb(150, 100, 60), Enum.Material.WoodPlanks)
end

local function signpost(parent: Instance, x: number, z: number, text: string, color: Color3)
	cylinder(parent, "SignPole", 9, 0.6, x, 4.5, z, rgb(110, 75, 50), Enum.Material.Wood)
	local board = part(parent, "SignBoard", Vector3.new(6, 1.6, 0.4), at(x, 8, z), rgb(200, 160, 110), Enum.Material.WoodPlanks)
	label(board, text, 1.6, UDim2.fromOffset(220, 50), color)
end

-- Front-yard picket fence with a gate gap and two vegetable patches.
local function yard(parent: Instance, x: number, z: number, facing: Vector3, seed: number)
	local base = CFrame.lookAt(Vector3.new(x, 0, z), Vector3.new(x, 0, z) + facing)
	local function rel(u: number, y: number, v: number): CFrame
		return base * CFrame.new(u, y, -v)
	end
	local white = rgb(250, 248, 240)
	local front, half = 13, 10
	for _, s in { -1, 1 } do
		-- front rail either side of the gate, and the side rails
		part(parent, "FenceRail", Vector3.new(8, 0.4, 0.3), rel(s * 6, 2, front), white, Enum.Material.WoodPlanks)
		part(parent, "FenceRail", Vector3.new(0.3, 0.4, 7), rel(s * half, 2, front - 3.5), white, Enum.Material.WoodPlanks)
		for i = 0, 3 do
			part(parent, "Picket", Vector3.new(0.5, 3, 0.4), rel(s * (2.5 + i * 2.5), 1.5, front), white, Enum.Material.WoodPlanks)
		end
		part(parent, "Picket", Vector3.new(0.5, 3, 0.4), rel(s * half, 1.5, front - 3.5), white, Enum.Material.WoodPlanks)
		-- vegetable patch
		part(parent, "VegBed", Vector3.new(4, 0.5, 5), rel(s * 6, 0.25, front - 4), rgb(110, 75, 50), Enum.Material.Ground)
		local crop = if (seed + s) % 3 == 0 then rgb(245, 140, 40) elseif (seed + s) % 3 == 1 then rgb(90, 180, 70) else rgb(220, 60, 70)
		for k = 0, 2 do
			local veg = part(parent, "Veg", Vector3.new(1.4, 1.4, 1.4), rel(s * 6, 1, front - 5.5 + k * 1.5), crop, Enum.Material.SmoothPlastic)
			veg.Shape = Enum.PartType.Ball
		end
	end
	-- stepping stones from the door to the gate
	for i = 1, 3 do
		cylinder(parent, "Stone", 0.25, 2.2, 0, 0, 0, rgb(185, 180, 170), Enum.Material.Slate).CFrame = rel((i % 2 - 0.5) * 0.6, 0.15, 6.5 + i * 2) * CFrame.Angles(0, 0, math.rad(90))
	end
end

local function palm(parent: Instance, x: number, z: number, lean: Vector3, seed: number)
	local model = Instance.new("Model")
	model.Name = "Palm"
	model.Parent = parent
	local prev = Vector3.new(x, 0, z)
	for i = 1, 6 do
		local nxt = Vector3.new(x, 0, z) + lean * (0.35 * i * i) + Vector3.new(0, i * 3.6, 0)
		segment(model, "Trunk", prev, nxt, 1.9 - i * 0.12, if i % 2 == 0 then rgb(150, 115, 80) else rgb(165, 128, 90), Enum.Material.Wood)
		prev = nxt
	end
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2 + hash(seed + i)
		local dir = Vector3.new(math.cos(a), -0.35, math.sin(a)).Unit
		part(model, "Frond", Vector3.new(2, 0.3, 9), CFrame.lookAt(prev + dir * 4.2, prev + dir * 9), rgb(60, 165 + math.floor(hash(seed + i * 2) * 40), 70), Enum.Material.Grass, { CanCollide = false })
	end
	for i = 1, 3 do
		ball(model, "Coconut", 1.2, prev.X + (i - 2) * 0.9, prev.Y - 0.9, prev.Z + ((i % 2) - 0.5) * 0.8, rgb(110, 80, 50), Enum.Material.Wood)
	end
end

local function seaArch(parent: Instance, x: number, z: number, turn: number)
	local model = Instance.new("Model")
	model.Name = "SeaArch"
	model.Parent = parent
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, turn, 0)
	local rock = rgb(160, 145, 130)
	for _, s in { -1, 1 } do
		local leg = part(model, "ArchLeg", Vector3.new(44, 14, 14), base * CFrame.new(s * 20, 12, 0) * CFrame.Angles(0, 0, math.rad(90)), rock, Enum.Material.Rock)
		leg.Shape = Enum.PartType.Cylinder
		ball(model, "ArchRock", 16, (base * CFrame.new(s * 22, 0, 2)).Position.X, -2, (base * CFrame.new(s * 22, 0, 2)).Position.Z, rock, Enum.Material.Rock)
	end
	part(model, "ArchTop", Vector3.new(58, 10, 15), base * CFrame.new(0, 37, 0), rock, Enum.Material.Rock)
	part(model, "ArchGrass", Vector3.new(54, 1.5, 13), base * CFrame.new(0, 42.6, 0), rgb(110, 185, 85), Enum.Material.Grass)
	tree(model, (base * CFrame.new(-12, 0, 0)).Position.X, (base * CFrame.new(-12, 0, 0)).Position.Z, 0.7, 501, 43)
	tree(model, (base * CFrame.new(14, 0, 2)).Position.X, (base * CFrame.new(14, 0, 2)).Position.Z, 0.6, 502, 43)
end

local function seaStack(parent: Instance, x: number, z: number, h: number, seed: number)
	cylinder(parent, "SeaStack", h + 10, 12 + hash(seed) * 6, x, h / 2 - 5, z, rgb(150, 138, 125), Enum.Material.Rock)
	cylinder(parent, "SeaStackTop", 1.5, 11 + hash(seed) * 6, x, h + 0.5, z, rgb(110, 185, 85), Enum.Material.Grass)
	ball(parent, "SeaStackRock", 9, x + 6, -1, z - 4, rgb(140, 128, 118), Enum.Material.Rock)
end

local function ruins(parent: Instance, x: number, y: number, z: number)
	local marble = rgb(235, 230, 220)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local h = 4 + hash(i + 40) * 9
		cylinder(parent, "Column", h, 1.8, x + math.cos(a) * 7, y + h / 2, z + math.sin(a) * 7, marble, Enum.Material.Marble)
	end
	part(parent, "Lintel", Vector3.new(10, 1.2, 2.2), at(x + 3.5, y + 13.6, z + 6.1) * CFrame.Angles(0, math.rad(-30), math.rad(4)), marble, Enum.Material.Marble)
	segment(parent, "FallenColumn", Vector3.new(x - 6, y + 1, z - 4), Vector3.new(x + 2, y + 1, z - 8), 1.8, marble, Enum.Material.Marble)
	local orb = ball(parent, "RuinOrb", 2.4, x, y + 3, z, rgb(140, 255, 210), Enum.Material.Neon)
	glowLight(orb, 22, 1.2, rgb(140, 255, 210))
end

-- Landmark: an enormous blossom tree with hanging lanterns and drifting petals.
local function elderTree(parent: Instance, x: number, y: number, z: number)
	local model = Instance.new("Model")
	model.Name = "ElderTree"
	model.Parent = parent
	local bark = rgb(120, 85, 65)
	ball(model, "RootFlare", 16, x, y + 1, z, bark, Enum.Material.Wood)
	local top = Vector3.new(x + 2, y + 34, z - 1)
	segment(model, "Trunk", Vector3.new(x, y, z), top, 9, bark, Enum.Material.Wood)
	local canopyColors = { rgb(255, 170, 205), rgb(255, 195, 220), rgb(250, 150, 195) }
	ball(model, "Crown", 30, top.X, top.Y + 8, top.Z, canopyColors[1], Enum.Material.Grass)
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		local tip = top + Vector3.new(math.cos(a) * 18, 2 + hash(i + 60) * 8, math.sin(a) * 18)
		segment(model, "Branch", top - Vector3.new(0, 6, 0), tip, 3.2, bark, Enum.Material.Wood)
		ball(model, "Canopy", 18 + hash(i + 70) * 6, tip.X, tip.Y + 3, tip.Z, canopyColors[i % 3 + 1], Enum.Material.Grass)
		-- hanging lantern under each canopy
		local lx, lz = tip.X * 0.8 + top.X * 0.2, tip.Z * 0.8 + top.Z * 0.2
		deco(part(model, "LanternCord", Vector3.new(0.15, 6, 0.15), at(lx, tip.Y - 6, lz), rgb(60, 50, 40)))
		local lantern = deco(ball(model, "Lantern", 1.8, lx, tip.Y - 9.5, lz, if i % 2 == 0 then rgb(255, 210, 120) else rgb(255, 150, 200), Enum.Material.Neon))
		glowLight(lantern, 16, 1, rgb(255, 200, 170))
	end
	local crown = model:FindFirstChild("Crown") :: BasePart
	glowLight(crown, 40, 0.8, rgb(255, 170, 210))
	emitter(crown, "Petals", {
		Shape = Enum.ParticleEmitterShape.Sphere,
		Color = ColorSequence.new(rgb(255, 190, 215), rgb(255, 150, 195)),
		Size = NumberSequence.new(0.5),
		Rate = 14,
		Lifetime = NumberRange.new(6, 9),
		Speed = NumberRange.new(1, 3),
		Acceleration = Vector3.new(0.6, -1.4, 0.3),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-90, 90),
		SpreadAngle = Vector2.new(180, 180),
		LightEmission = 0.2,
	})
end

local function balloon(parent: Instance, x: number, y: number, z: number, a: Color3, b: Color3)
	local model = Instance.new("Model")
	model.Name = "Balloon"
	model.Parent = parent
	local envelope = deco(ball(model, "Envelope", 20, x, y, z, a, Enum.Material.Fabric))
	model.PrimaryPart = envelope
	deco(cylinder(model, "Band", 4, 20.4, x, y, z, b, Enum.Material.Fabric))
	deco(cylinder(model, "Band", 2, 17.4, x, y + 6, z, b, Enum.Material.Fabric))
	deco(cylinder(model, "Skirt", 4, 7, x, y - 10.5, z, b, Enum.Material.Fabric))
	deco(part(model, "Basket", Vector3.new(5, 3.5, 5), at(x, y - 19, z), rgb(170, 120, 70), Enum.Material.WoodPlanks))
	for _, c in { { -2.2, -2.2 }, { 2.2, -2.2 }, { -2.2, 2.2 }, { 2.2, 2.2 } } do
		deco(segment(model, "Rope", Vector3.new(x + c[1], y - 17.2, z + c[2]), Vector3.new(x + c[1] * 1.2, y - 12.4, z + c[2] * 1.2), 0.2, rgb(90, 75, 60)))
	end
	local flame = deco(ball(model, "Burner", 1.6, x, y - 14.5, z, rgb(255, 170, 60), Enum.Material.Neon))
	glowLight(flame, 14, 1, rgb(255, 180, 90))
	model:SetAttribute("Bob", "float")
end

local function buildDetails(scenery: Instance)
	local details = Instance.new("Folder")
	details.Name = "Details"
	details.Parent = scenery

	-- yards and paths for the village row (cottages at x = +-75 facing the avenue)
	local seed = 0
	for _, z in { -195, -145, 145, 195 } do
		for _, side in { -1, 1 } do
			seed += 1
			yard(details, side * 75, z, Vector3.new(-side, 0, 0), seed)
			path(details, Vector3.new(side * 62, 0, z), Vector3.new(side * 22, 0, z), 3.5)
		end
	end
	yard(details, -160, -250, Vector3.new(0, 0, 1), 25)
	yard(details, 160, -250, Vector3.new(0, 0, 1), 26)
	-- shop fronts: path, barrels, crates and a bench
	for _, s in { { -80, -95, 1 }, { 80, -95, -1 }, { -80, 120, 1 }, { 80, 120, -1 } } do
		local x, z, d = s[1], s[2], s[3]
		path(details, Vector3.new(x + d * 6, 0, z), Vector3.new(if x < 0 then -22 else 22, 0, z), 4)
		barrel(details, x + d * 9, z - 9)
		barrel(details, x + d * 9.5, z - 5.8)
		crate(details, x + d * 9, 0, z + 8, 2.6, 0.3)
		crate(details, x + d * 9.2, 2.6, z + 8.2, 2, 0.8)
		bench(details, x + d * 15, z + 12, Vector3.new(d, 0, 0))
	end
	cart(details, -66, -118, math.rad(20), rgb(230, 60, 60))
	cart(details, 66, 98, math.rad(-15), rgb(245, 150, 40))
	-- north village square
	well(details, -135, -262)
	cart(details, 135, -264, math.rad(70), rgb(120, 200, 80))
	bench(details, -125, -248, Vector3.new(0, 0, -1))
	-- farm by the windmill
	haystack(details, 90, 272, 6)
	haystack(details, 96, 282, 4.5)
	haystack(details, 132, 238, 5)
	-- signposts
	signpost(details, -30, -232, "Wishing Pond", rgb(160, 230, 255))
	signpost(details, 30, 104, "Sky Garden", rgb(220, 200, 255))
	signpost(details, -30, -78, "Seed Shop", rgb(200, 255, 200))

	-- beach palms leaning out to sea
	local palms = { { -252, -300, -1 }, { -254, -120, -1 }, { -252, 200, -1 }, { 252, -260, 1 }, { 254, -80, 1 }, { 252, 150, 1 }, { 253, 290, 1 } }
	for i, pt in palms do
		palm(details, pt[1], pt[2], Vector3.new(pt[3], 0, (hash(i) - 0.5) * 0.6).Unit, i)
	end
	for i, x in { -150, -40, 70, 180 } do
		palm(details, x, -404, Vector3.new((hash(i + 9) - 0.5) * 0.6, 0, -1).Unit, i + 10)
	end

	-- sea features
	local sea = Instance.new("Folder")
	sea.Name = "SeaFeatures"
	sea.Parent = scenery
	seaArch(sea, 140, -490, math.rad(15))
	seaStack(sea, -200, -470, 30, 1)
	seaStack(sea, -240, -445, 18, 2)
	seaStack(sea, 260, 420, 26, 3)
	seaStack(sea, -150, 430, 22, 4)
	ruins(sea, 310, 8, 230)

	-- hot-air balloons drifting over the island (the client bobs them)
	local balloons = Instance.new("Folder")
	balloons.Name = "Balloons"
	balloons.Parent = scenery
	balloon(balloons, -150, 150, -120, rgb(255, 90, 110), rgb(255, 220, 80))
	balloon(balloons, 190, 175, -40, rgb(80, 170, 255), rgb(255, 255, 255))
	balloon(balloons, -80, 140, 170, rgb(150, 110, 240), rgb(130, 230, 200))
	balloon(balloons, 110, 160, -260, rgb(255, 160, 60), rgb(255, 90, 110))
	balloon(balloons, 260, 190, 260, rgb(110, 210, 110), rgb(255, 230, 120))
end

-- Terraced grassy hill: stacked, shrinking discs with a rocky skirt and a few trees on top.
local function hill(parent: Instance, x: number, z: number, r: number, tiers: number, seed: number, trees: boolean?): number
	local model = Instance.new("Model")
	model.Name = "Hill"
	model.Parent = parent
	local y = 0
	local radius = r
	for i = 1, tiers do
		local h = 5 + hash(seed + i) * 3
		local green = rgb(95 + i * 8, 175 + i * 6, 80)
		cylinder(model, "Terrace", h, radius * 2, x + (hash(seed * 2 + i) - 0.5) * 4, y + h / 2 - 0.5, z + (hash(seed * 3 + i) - 0.5) * 4, green, Enum.Material.Grass)
		-- rocks poking out of each terrace edge
		for k = 1, 3 do
			local a = hash(seed * 5 + i * 3 + k) * math.pi * 2
			ball(model, "Rock", 3 + hash(seed + k + i) * 3, x + math.cos(a) * radius * 0.95, y + 1.5, z + math.sin(a) * radius * 0.95, rgb(150, 140, 130), Enum.Material.Rock)
		end
		y += h - 0.5
		radius *= 0.72
	end
	for i = 1, if trees == false then 0 else 2 do
		local a = hash(seed + i * 13) * math.pi * 2
		tree(model, x + math.cos(a) * radius * 0.5, z + math.sin(a) * radius * 0.5, 0.9 + hash(seed + i) * 0.4, seed * 7 + i, y)
	end
	return y
end

-- Rocky island rising out of the sea with a grassy cap; returns the cap height.
local function cliffIsle(parent: Instance, x: number, z: number, r: number, h: number, seed: number): number
	local model = Instance.new("Model")
	model.Name = "CliffIsle"
	model.Parent = parent
	cylinder(model, "Cliff", h + 10, r * 2, x, (h - 10) / 2, z, rgb(150, 135, 120), Enum.Material.Rock)
	cylinder(model, "Ledge", h * 0.5, r * 2 + 8, x + 3, -5 + h * 0.25, z - 2, rgb(135, 120, 108), Enum.Material.Rock)
	cylinder(model, "Cap", 2, r * 2 + 1, x, h + 1, z, rgb(110, 185, 85), Enum.Material.Grass)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2 + hash(seed + i)
		local d = r + 3 + hash(seed * 2 + i) * 6
		ball(model, "Boulder", 6 + hash(seed + i * 3) * 8, x + math.cos(a) * d, -1, z + math.sin(a) * d, rgb(140, 128, 118), Enum.Material.Rock)
	end
	return h + 2
end

-- Striped lighthouse whose beam the client sweeps round (SpinSpeed on the Beam model).
local function lighthouse(parent: Instance, x: number, y: number, z: number)
	local model = Instance.new("Model")
	model.Name = "Lighthouse"
	model.Parent = parent
	for i = 1, 6 do
		cylinder(model, "Tower", 7, 11 - i * 0.8, x, y + (i - 0.5) * 7, z, if i % 2 == 1 then rgb(245, 245, 245) else rgb(215, 65, 60), Enum.Material.SmoothPlastic)
	end
	local top = y + 42
	cylinder(model, "Gallery", 1, 11, x, top + 0.5, z, rgb(60, 60, 70), Enum.Material.Metal)
	local lamp = cylinder(model, "LampRoom", 6, 6, x, top + 4, z, rgb(255, 235, 160), Enum.Material.Neon)
	glowLight(lamp, 60, 2, rgb(255, 230, 160))
	for i, d in { 7.5, 5, 2.5 } do
		cylinder(model, "Roof", 1.4, d, x, top + 7 + i * 1.3, z, rgb(215, 65, 60), Enum.Material.Slate)
	end
	local beam = Instance.new("Model")
	beam.Name = "Beam"
	beam.Parent = model
	local hubCf = CFrame.new(x, top + 4, z) * CFrame.Angles(-math.pi / 2, 0, 0) -- local Z points up
	local hub = deco(part(beam, "Hub", Vector3.new(1, 1, 1), hubCf, rgb(255, 240, 180), Enum.Material.Neon, { Transparency = 1 }))
	beam.PrimaryPart = hub
	for _, side in { 1, -1 } do
		local ray = deco(part(beam, "Ray", Vector3.new(120, 4, 4), hubCf * CFrame.new(side * 62, 0, 0), rgb(255, 240, 180), Enum.Material.Neon))
		ray.Transparency = 0.75
	end
	beam:SetAttribute("SpinSpeed", 40)
end

-- Small stone keep with corner towers, battlements and banners.
local function keep(parent: Instance, x: number, y: number, z: number, banner: Color3)
	local model = Instance.new("Model")
	model.Name = "Keep"
	model.Parent = parent
	local stone, dark = rgb(200, 195, 185), rgb(165, 158, 150)
	part(model, "Hall", Vector3.new(30, 22, 30), at(x, y + 11, z), stone, Enum.Material.Cobblestone)
	-- battlements
	for i = 0, 6 do
		local o = -13.5 + i * 4.5
		for _, e in { { o, -14.5 }, { o, 14.5 }, { -14.5, o }, { 14.5, o } } do
			part(model, "Merlon", Vector3.new(2.2, 3, 2.2), at(x + e[1], y + 23.5, z + e[2]), dark, Enum.Material.Cobblestone)
		end
	end
	for _, c in { { -15, -15 }, { 15, -15 }, { -15, 15 }, { 15, 15 } } do
		local tx, tz = x + c[1], z + c[2]
		cylinder(model, "Tower", 32, 10, tx, y + 16, tz, stone, Enum.Material.Cobblestone)
		for i, d in { 12, 9, 6, 3 } do
			cylinder(model, "Spire", 3, d, tx, y + 32 + i * 3 - 1.5, tz, rgb(70, 95, 170), Enum.Material.Slate)
		end
		cylinder(model, "Pole", 6, 0.4, tx, y + 47, tz, rgb(90, 80, 70), Enum.Material.Wood)
		part(model, "Banner", Vector3.new(0.2, 3, 5), at(tx, y + 48.5, tz + 2.7), banner, Enum.Material.Fabric)
	end
	-- gate and lit windows facing the main island (east, +X)
	part(model, "Gate", Vector3.new(1, 10, 8), at(x + 15.2, y + 5, z), rgb(110, 75, 50), Enum.Material.WoodPlanks)
	for _, oz in { -8, 8 } do
		part(model, "Window", Vector3.new(0.5, 4, 2.4), at(x + 15.2, y + 15, z + oz), rgb(255, 210, 130), Enum.Material.Neon)
	end
	local brazier = ball(model, "Brazier", 3, x + 18, y + 25, z, rgb(255, 170, 70), Enum.Material.Neon)
	glowLight(brazier, 40, 1.4, rgb(255, 180, 90))
	emitter(brazier, "Embers", {
		Color = ColorSequence.new(rgb(255, 220, 120), rgb(255, 110, 40)),
		Size = fade(0.6, 0),
		Rate = 12,
		Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(4, 7),
		SpreadAngle = Vector2.new(20, 20),
		LightEmission = 1,
	})
end

local function boat(parent: Instance, x: number, z: number, heading: number, sail: Color3)
	local model = Instance.new("Model")
	model.Name = "Boat"
	model.Parent = parent
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, heading, 0)
	part(model, "Hull", Vector3.new(7, 3, 18), base * CFrame.new(0, 0.5, 0), rgb(140, 95, 60), Enum.Material.WoodPlanks)
	part(model, "Bow", Vector3.new(4.9, 3, 4.9), base * CFrame.new(0, 0.5, -9) * CFrame.Angles(0, math.rad(45), 0), rgb(140, 95, 60), Enum.Material.WoodPlanks)
	part(model, "Deck", Vector3.new(6, 0.4, 16), base * CFrame.new(0, 2.1, 0), rgb(190, 150, 100), Enum.Material.WoodPlanks)
	part(model, "Mast", Vector3.new(0.7, 16, 0.7), base * CFrame.new(0, 10, -1), rgb(110, 75, 50), Enum.Material.Wood)
	part(model, "Sail", Vector3.new(0.3, 11, 8), base * CFrame.new(0.4, 11, 3) * CFrame.Angles(0, math.rad(90), 0), sail, Enum.Material.Fabric)
	part(model, "Stripe", Vector3.new(0.35, 2, 8), base * CFrame.new(0.45, 11, 3) * CFrame.Angles(0, math.rad(90), 0), rgb(255, 255, 255), Enum.Material.Fabric)
end

-- Distant snow-capped peak (out past the sea edge, mostly seen through the haze).
local function peak(parent: Instance, x: number, z: number, scale: number, seed: number)
	local model = Instance.new("Model")
	model.Name = "Peak"
	model.Parent = parent
	local y = -10
	local r = 140 * scale
	for i = 1, 11 do
		local h = 15 * scale
		local snow = i >= 9
		local color = if snow then rgb(245, 248, 255) elseif i >= 7 then rgb(165 + i * 2, 160 + i * 2, 175) else rgb(110 + i * 8, 140 + i * 6, 115)
		local ox, oz = (hash(seed + i) - 0.5) * 24 * scale, (hash(seed * 2 + i) - 0.5) * 24 * scale
		deco(cylinder(model, "Layer", h, r * 2, x + ox, y + h / 2, z + oz, color, if snow then Enum.Material.Snow else Enum.Material.Rock))
		y += h
		r *= 0.82
	end
end

local function bush(parent: Instance, x: number, z: number, seed: number)
	local green = rgb(70 + math.floor(hash(seed) * 30), 150 + math.floor(hash(seed + 1) * 40), 70)
	ball(parent, "Bush", 4.5, x, 1.6, z, green, Enum.Material.Grass)
	ball(parent, "Bush", 3.4, x + 2.2, 1.3, z + 1, green, Enum.Material.Grass)
	local flowers = { rgb(255, 120, 160), rgb(255, 230, 100), rgb(255, 255, 255), rgb(180, 140, 255) }
	for i = 1, 3 do
		local a = hash(seed * 3 + i) * math.pi * 2
		ball(parent, "BushFlower", 0.8, x + math.cos(a) * 2, 3.2, z + math.sin(a) * 2, flowers[(seed + i) % 4 + 1])
	end
end

local function buildLandscape(scenery: Instance)
	local land = Instance.new("Folder")
	land.Name = "Landscape"
	land.Parent = scenery

	-- terraced hills in the island's four empty corners (outside the shoreline tree ring)
	hill(land, -205, -355, 34, 4, 1)
	hill(land, 205, -355, 30, 4, 2)
	local elderBase = hill(land, -210, 300, 30, 3, 3, false)
	elderTree(land, -210, elderBase, 300)
	hill(land, 205, 305, 26, 3, 4)

	-- town: two-storey shop houses beside the Plaza, more cottages at the north corners
	local town = scenery:FindFirstChild("Village") or land
	cottage(town, -80, -95, Vector3.new(1, 0, 0), 21, 2, rgb(90, 190, 110))
	cottage(town, 80, -95, Vector3.new(-1, 0, 0), 22, 2, rgb(240, 120, 150))
	cottage(town, -80, 120, Vector3.new(1, 0, 0), 23, 2, rgb(90, 160, 255))
	cottage(town, 80, 120, Vector3.new(-1, 0, 0), 24, 2, rgb(255, 180, 60))
	cottage(town, -160, -250, Vector3.new(0, 0, 1), 25)
	cottage(town, 160, -250, Vector3.new(0, 0, 1), 26)
	cottage(town, -138, -300, Vector3.new(0.6, 0, 0.8).Unit, 27, 2)
	cottage(town, 138, -300, Vector3.new(-0.6, 0, 0.8).Unit, 28, 2)

	-- bushes lining the avenue (clear of the Plaza and the Parade)
	local n = 0
	for z = -240, 240, 30 do
		if math.abs(z) > 75 and not (z > 60 and z < 100) then
			for _, side in { -1, 1 } do
				n += 1
				bush(land, side * 50, z + side * 7, n)
			end
		end
	end

	-- boulders along the beach
	for i = 1, 28 do
		local f = i / 28
		local x, z
		if i % 2 == 0 then
			x, z = (f * 2 - 1) * 250, if i % 4 == 0 then -402 else 342
		else
			x, z = if i % 4 == 1 then -253 else 253, -400 + f * 740
		end
		ball(land, "Boulder", 4 + hash(i) * 6, x + (hash(i + 2) - 0.5) * 6, -0.5, z, rgb(160, 150, 140), Enum.Material.Rock)
	end

	-- out at sea: lighthouse isle, a keep on a cliff island, a harbour pier with boats
	local coast = Instance.new("Folder")
	coast.Name = "Coast"
	coast.Parent = scenery
	local lighthouseTop = cliffIsle(coast, 345, -150, 22, 14, 31)
	lighthouse(coast, 345, lighthouseTop, -150)
	local keepTop = cliffIsle(coast, -360, 140, 34, 18, 32)
	keep(coast, -360, keepTop, 140, rgb(220, 70, 90))
	local smallTop = cliffIsle(coast, -330, -260, 16, 9, 33)
	tree(coast, -333, -258, 1.1, 77, smallTop)
	tree(coast, -324, -266, 0.8, 78, smallTop)
	cliffIsle(coast, 310, 230, 12, 6, 34)

	part(coast, "Pier", Vector3.new(80, 1, 10), at(290, 1.5, 20), rgb(160, 115, 75), Enum.Material.WoodPlanks)
	for i = 0, 7 do
		for _, side in { -1, 1 } do
			cylinder(coast, "Piling", 8, 1.2, 254 + i * 10, -2.5, 20 + side * 5.2, rgb(110, 80, 55), Enum.Material.Wood)
		end
	end
	lamp(coast, 328, 26)
	boat(coast, 300, 38, math.rad(80), rgb(240, 90, 90))
	boat(coast, 318, 2, math.rad(100), rgb(90, 150, 240))
	boat(coast, 380, 70, math.rad(30), rgb(255, 210, 80))

	-- distant mountains ringing the horizon
	local horizon = Instance.new("Folder")
	horizon.Name = "Horizon"
	horizon.Parent = scenery
	local peaks = {
		{ -820, -500, 1.2 }, { -900, 100, 1.5 }, { -760, 600, 1.1 }, { 850, -300, 1.4 },
		{ 900, 350, 1.2 }, { -200, -1000, 1.6 }, { 350, -950, 1.3 }, { 150, 950, 1.2 },
	}
	for i, pk in peaks do
		peak(horizon, pk[1], pk[2], pk[3], i)
	end
end

local function buildScenery(map: Instance)
	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	scenery.Parent = map

	-- Village: cottages in the strips between the avenue and the plots, facing the avenue.
	local village = Instance.new("Folder")
	village.Name = "Village"
	village.Parent = scenery
	local seed = 0
	for _, z in { -195, -145, 145, 195 } do
		for _, side in { -1, 1 } do
			seed += 1
			cottage(village, side * 75, z, Vector3.new(-side, 0, 0), seed)
		end
	end
	-- north end, either side of the pond, and the south-west corner
	cottage(village, -110, -275, Vector3.new(1, 0, 0), 11)
	cottage(village, 110, -275, Vector3.new(-1, 0, 0), 12)
	cottage(village, -95, 262, Vector3.new(1, 0, -0.4).Unit, 13)
	windmill(village, 112, 255, Vector3.new(-1, 0, -0.3).Unit)
	lanternTower(village, -62, -245, rgb(70, 110, 180))
	lanternTower(village, 62, -245, rgb(205, 85, 70))
	lanternTower(village, -60, 232, rgb(60, 160, 150))
	lanternTower(village, 60, 225, rgb(150, 90, 170))

	-- Festoon lights strung across the avenue between the lamp pairs (skipping the Plaza).
	local lights = Instance.new("Folder")
	lights.Name = "Festoons"
	lights.Parent = scenery
	for i, z in { -250, -200, -130, -90, 120, 160, 200 } do
		festoon(lights, Vector3.new(-24, 13.2, z), Vector3.new(24, 13.2, z + 20), i)
	end

	-- Light beams: the Dewdrop fountain, the Rebirth Shrine and the Sky Garden lift.
	local beams = Instance.new("Folder")
	beams.Name = "Beams"
	beams.Parent = scenery
	lightBeam(beams, "DewdropBeam", 0, 19, 0, 420, 4, rgb(120, 225, 255))
	lightBeam(beams, "ShrineBeam", -50, 9, 0, 320, 2.4, rgb(200, 150, 255))
	lightBeam(beams, "SkyLiftBeam", 0, 1, 240, 92, 5, rgb(190, 140, 255))
	lightBeam(beams, "SkyWellBeam", 0, 97, 305, 260, 3, rgb(220, 180, 255))

	-- Glowing crystals around the Wishing Pond and on the Sky Garden.
	local crystals = Instance.new("Folder")
	crystals.Name = "Crystals"
	crystals.Parent = scenery
	crystal(crystals, -58, 0, -305, 1.1, rgb(120, 230, 255), 1, false)
	crystal(crystals, 58, 0, -310, 1, rgb(255, 130, 200), 2, false)
	crystal(crystals, -30, 0, -352, 0.9, rgb(190, 140, 255), 3, false)
	crystal(crystals, 32, 0, -350, 1.2, rgb(140, 255, 170), 4, false)
	crystal(crystals, -18, 92, 300, 0.8, rgb(220, 170, 255), 5, false)
	crystal(crystals, 18, 92, 300, 0.8, rgb(120, 230, 255), 6, false)
	-- small floating ones that bob over the pond and plaza edges
	crystal(crystals, -36, 14, -318, 0.5, rgb(255, 190, 110), 7, true)
	crystal(crystals, 38, 16, -290, 0.5, rgb(120, 230, 255), 8, true)
	crystal(crystals, -75, 18, -60, 0.5, rgb(255, 130, 200), 9, true)
	crystal(crystals, 75, 18, -60, 0.5, rgb(190, 140, 255), 10, true)

	-- Drifting motes: gold over the Plaza, blue over the pond, violet on the Sky Garden.
	local fx = Instance.new("Folder")
	fx.Name = "Ambient"
	fx.Parent = scenery
	motes(fx, "PlazaMotes", CFrame.new(0, 9, 0), Vector3.new(120, 12, 120), rgb(255, 225, 130), 14)
	motes(fx, "AvenueMotesNorth", CFrame.new(0, 7, -170), Vector3.new(60, 10, 160), rgb(255, 240, 170), 6)
	motes(fx, "AvenueMotesSouth", CFrame.new(0, 7, 180), Vector3.new(60, 10, 160), rgb(255, 240, 170), 6)
	motes(fx, "PondMotes", CFrame.new(0, 5, -300), Vector3.new(90, 8, 90), rgb(140, 220, 255), 10)
	motes(fx, "SkyGardenMotes", CFrame.new(0, 100, 300), Vector3.new(70, 14, 70), rgb(220, 180, 255), 10)
	local mist = deco(part(fx, "PondMist", Vector3.new(80, 1, 80), CFrame.new(0, 1.6, -300), rgb(255, 255, 255), nil, { Transparency = 1 }))
	emitter(mist, "Mist", {
		Shape = Enum.ParticleEmitterShape.Box,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
		Color = ColorSequence.new(rgb(225, 245, 255)),
		Size = fade(6, 12),
		Rate = 4,
		Lifetime = NumberRange.new(6, 9),
		Speed = NumberRange.new(0.3, 0.8),
		SpreadAngle = Vector2.new(180, 10),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.4, 0.82),
			NumberSequenceKeypoint.new(1, 1),
		}),
		RotSpeed = NumberRange.new(-8, 8),
	})

	-- Sky Garden waterfall pouring off its south edge.
	waterfall(fx, 0, 86, 341, 8, Vector3.new(0, 0, -1))

	-- Out over the sea: floating islets (some with waterfalls) and clouds, for depth.
	local sky = Instance.new("Folder")
	sky.Name = "Skyline"
	sky.Parent = scenery
	local islets = {
		{ -340, 110, -120, 38, true }, { 360, 140, 60, 45, true }, { -300, 170, 260, 30, false },
		{ 320, 95, -330, 28, true }, { -150, 190, -520, 34, true }, { 180, 150, -500, 26, false },
		{ 60, 210, 520, 32, true }, { -420, 230, -380, 22, false }, { 440, 210, 330, 24, false },
		{ 75, 125, 375, 10, false }, { -70, 112, 330, 8, false },
	}
	for i, it in islets do
		floatingIslet(sky, it[1], it[2], it[3], it[4], i, it[5])
	end
	local clouds = {
		{ -260, 260, -300, 1.4 }, { 250, 280, -150, 1.2 }, { -380, 240, 100, 1.6 }, { 380, 300, 250, 1.3 },
		{ 0, 320, -620, 1.8 }, { -200, 290, 480, 1.2 }, { 260, 250, 520, 1 }, { 520, 270, -420, 1.5 },
		{ -540, 300, -120, 1.7 }, { 120, 340, 40, 1.1 },
	}
	for i, c in clouds do
		cloud(sky, c[1], c[2], c[3], c[4], i)
	end
	buildLandscape(scenery)
	buildDetails(scenery)
end

----------------------------------------------------------------------------------------------

function MapBuilder.Build(parent: Instance): Instance
	local existing = parent:FindFirstChild("Map")
	if existing then
		existing:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "Map"

	buildIsland(map)
	buildPlaza(map)
	local plots = Instance.new("Folder")
	plots.Name = "Plots"
	plots.Parent = map
	for index = 1, 8 do
		buildPlot(plots, index)
	end
	buildParade(map)
	buildPond(map)
	buildSkyGarden(map)
	buildScenery(map)

	map.Parent = parent
	return map
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Products</string>
          <string name="Source"><![CDATA[--!strict
-- Robux catalogue. IDs are 0 until you create the passes/products on the Creator Dashboard
-- and paste the real IDs here. Items with id 0 still show in the in-game store, with a "Set ID"
-- button instead of a price, and can't be bought.

export type Pass = { key: string, id: number, name: string, price: number, description: string }
export type Product = { key: string, id: number, name: string, price: number, description: string }

local Products = {}

Products.Passes = {
	{ key = "DoubleDew", id = 0, name = "2x Dew", price = 249, description = "Double all Dew income, forever." },
	{ key = "BigGreenhouse", id = 0, name = "Big Greenhouse", price = 199, description = "+4 display pads for more Sproutlings." },
	{ key = "SturdyGate", id = 0, name = "Sturdy Gate", price = 99, description = "Gate lock lasts 90s instead of 60s." },
	{ key = "LuckyRod", id = 0, name = "Lucky Rod", price = 149, description = "Double rare catches at the Wishing Pond." },
	{ key = "VIP", id = 0, name = "VIP", price = 149, description = "Golden VIP name tag and +10% Dew." },
} :: { Pass }

Products.DevProducts = {
	{ key = "StarterPack", id = 0, name = "Starter Pack", price = 49, description = "One-time: 2 Mushroomph seeds + 5,000 Dew." },
	{ key = "DewSmall", id = 0, name = "Dew Pouch", price = 29, description = "15 minutes of your current income (min 500 Dew)." },
	{ key = "DewLarge", id = 0, name = "Dew Barrel", price = 249, description = "3 hours of your current income (min 20,000 Dew)." },
	{ key = "InstantGrow", id = 0, name = "Instant Grow", price = 39, description = "Every seed in your soil finishes growing now." },
	{ key = "LuckBoost", id = 0, name = "Luck Boost (15 min)", price = 49, description = "Double mutation chances on your hatches." },
	{ key = "RestockNow", id = 0, name = "Restock Shop", price = 25, description = "Instantly re-roll your seed shop stock." },
	{ key = "SummonStarfall", id = 0, name = "Summon Starfall", price = 199, description = "Starts a server-wide Starfall. Everyone cheers your name." },
	{ key = "SummonAurora", id = 0, name = "Summon Aurora", price = 399, description = "Starts a server-wide Aurora (Prismatic x6 hatches)." },
} :: { Product }

Products.PassByKey = {} :: { [string]: Pass }
for _, pass in Products.Passes do
	Products.PassByKey[pass.key] = pass
end

Products.ProductById = {} :: { [number]: Product }
for _, product in Products.DevProducts do
	if product.id ~= 0 then
		Products.ProductById[product.id] = product
	end
end

return Products
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Species</string>
          <string name="Source"><![CDATA[--!strict
-- Sproutling species. A seed of a species always hatches into that species;
-- mutation and size are rolled at hatch time.

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic" | "Secret"

export type Species = {
	id: string,
	name: string,
	rarity: Rarity,
	price: number, -- seed price in Dew
	growSeconds: number,
	dewPerSecond: number,
	stockChance: number, -- chance the seed shop stocks it on a restock (0 = never sold in shop)
	stockRange: { number },
	body: Color3,
	leaf: Color3,
	topper: "Leaf" | "Petals" | "Cap" | "Spikes" | "Pad" | "Flame" | "Crystal",
	limited: string?, -- event id (e.g. "halloween2026") for limited species; nil for the base roster.
	-- Limited species always have stockChance = 0 (Species.ShopList excludes them automatically) and
	-- are earned only through the matching event's own systems (EventService, PondService).
}

local Species = {}

Species.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

Species.RarityColors = {
	Common = Color3.fromRGB(190, 190, 190),
	Uncommon = Color3.fromRGB(110, 210, 110),
	Rare = Color3.fromRGB(80, 160, 255),
	Epic = Color3.fromRGB(180, 100, 255),
	Legendary = Color3.fromRGB(255, 190, 40),
	Mythic = Color3.fromRGB(255, 80, 140),
	Secret = Color3.fromRGB(40, 255, 230),
}

local list: { Species } = {
	{ id = "mossbun", name = "Mossbun", rarity = "Common", price = 10, growSeconds = 30, dewPerSecond = 1, stockChance = 1, stockRange = { 8, 20 }, body = Color3.fromRGB(120, 170, 90), leaf = Color3.fromRGB(70, 130, 60), topper = "Leaf" },
	{ id = "pebblepup", name = "Pebblepup", rarity = "Common", price = 40, growSeconds = 45, dewPerSecond = 2, stockChance = 1, stockRange = { 6, 15 }, body = Color3.fromRGB(150, 150, 160), leaf = Color3.fromRGB(90, 160, 80), topper = "Leaf" },
	{ id = "clovercub", name = "Clovercub", rarity = "Common", price = 120, growSeconds = 60, dewPerSecond = 4, stockChance = 0.9, stockRange = { 4, 10 }, body = Color3.fromRGB(90, 200, 110), leaf = Color3.fromRGB(40, 150, 60), topper = "Petals" },
	{ id = "tulipaca", name = "Tulipaca", rarity = "Uncommon", price = 500, growSeconds = 90, dewPerSecond = 10, stockChance = 0.7, stockRange = { 3, 8 }, body = Color3.fromRGB(250, 235, 215), leaf = Color3.fromRGB(240, 90, 120), topper = "Petals" },
	{ id = "cactoad", name = "Cactoad", rarity = "Uncommon", price = 1_500, growSeconds = 120, dewPerSecond = 20, stockChance = 0.55, stockRange = { 2, 6 }, body = Color3.fromRGB(80, 160, 90), leaf = Color3.fromRGB(250, 200, 80), topper = "Spikes" },
	{ id = "mushroomph", name = "Mushroomph", rarity = "Rare", price = 6_000, growSeconds = 180, dewPerSecond = 50, stockChance = 0.4, stockRange = { 1, 4 }, body = Color3.fromRGB(240, 225, 200), leaf = Color3.fromRGB(210, 60, 60), topper = "Cap" },
	{ id = "lilypadger", name = "Lilypadger", rarity = "Rare", price = 18_000, growSeconds = 240, dewPerSecond = 100, stockChance = 0.3, stockRange = { 1, 3 }, body = Color3.fromRGB(70, 110, 90), leaf = Color3.fromRGB(110, 200, 120), topper = "Pad" },
	{ id = "thornix", name = "Thornix", rarity = "Epic", price = 60_000, growSeconds = 360, dewPerSecond = 220, stockChance = 0.18, stockRange = { 1, 2 }, body = Color3.fromRGB(90, 40, 70), leaf = Color3.fromRGB(200, 40, 90), topper = "Spikes" },
	{ id = "bloomingo", name = "Bloomingo", rarity = "Epic", price = 180_000, growSeconds = 480, dewPerSecond = 450, stockChance = 0.12, stockRange = { 1, 2 }, body = Color3.fromRGB(255, 150, 190), leaf = Color3.fromRGB(255, 240, 120), topper = "Petals" },
	{ id = "sunfloof", name = "Sunfloof", rarity = "Legendary", price = 600_000, growSeconds = 600, dewPerSecond = 1_000, stockChance = 0.06, stockRange = { 1, 1 }, body = Color3.fromRGB(255, 210, 90), leaf = Color3.fromRGB(255, 140, 30), topper = "Flame" },
	{ id = "orchidragon", name = "Orchidragon", rarity = "Legendary", price = 2_000_000, growSeconds = 900, dewPerSecond = 2_200, stockChance = 0.03, stockRange = { 1, 1 }, body = Color3.fromRGB(170, 120, 220), leaf = Color3.fromRGB(250, 250, 255), topper = "Petals" },
	{ id = "moonpetal", name = "Moonpetal Wisp", rarity = "Mythic", price = 7_500_000, growSeconds = 1_500, dewPerSecond = 5_000, stockChance = 0, stockRange = { 0, 0 }, body = Color3.fromRGB(200, 220, 255), leaf = Color3.fromRGB(120, 140, 255), topper = "Crystal" },
	{ id = "starseed", name = "Starseed Sprite", rarity = "Secret", price = 25_000_000, growSeconds = 1_800, dewPerSecond = 12_000, stockChance = 0, stockRange = { 0, 0 }, body = Color3.fromRGB(30, 30, 60), leaf = Color3.fromRGB(80, 255, 230), topper = "Crystal" },
	-- Halloween "Hollow Harvest" limited species (appended after the base 13 so their `order` never
	-- shifts an existing species' analytics order). stockChance = 0 keeps them out of Species.ShopList;
	-- they're earned only via the Lantern Stall (pumpkit, gourdgeist) or the Wishing Pond during Spooky
	-- Fog from Part 2 (hollowisp). See EventService.luau and PondService.luau.
	{ id = "pumpkit", name = "Pumpkit", rarity = "Epic", price = 150_000, growSeconds = 420, dewPerSecond = 380, stockChance = 0, stockRange = { 0, 0 }, body = Color3.fromRGB(235, 140, 40), leaf = Color3.fromRGB(40, 110, 50), topper = "Cap", limited = "halloween2026" },
	{ id = "gourdgeist", name = "Gourdgeist", rarity = "Legendary", price = 1_200_000, growSeconds = 780, dewPerSecond = 1_500, stockChance = 0, stockRange = { 0, 0 }, body = Color3.fromRGB(225, 235, 215), leaf = Color3.fromRGB(150, 90, 255), topper = "Flame", limited = "halloween2026" },
	{ id = "hollowisp", name = "Hollowisp", rarity = "Mythic", price = 10_000_000, growSeconds = 1_500, dewPerSecond = 6_000, stockChance = 0, stockRange = { 0, 0 }, body = Color3.fromRGB(30, 30, 40), leaf = Color3.fromRGB(170, 90, 255), topper = "Crystal", limited = "halloween2026" },
}

Species.List = list
Species.ById = {} :: { [string]: Species }
for index, species in list do
	Species.ById[species.id] = species
	;(species :: any).order = index
end

function Species.get(id: string): Species?
	return Species.ById[id]
end

-- Limited species (Halloween etc.) are excluded here on purpose: Species.rollByRarity backs the
-- Pollen Parade and the Wishing Pond/Sky Well, and a limited species must only ever come from its
-- own event system (the Lantern Stall, or the Pond during Spooky Fog for hollowisp) -- never leak
-- out through an unrelated random-rarity roll just because it shares a rarity tier.
local countByRarity: { [string]: number } = {}
for _, species in list do
	if not species.limited then
		countByRarity[species.rarity] = (countByRarity[species.rarity] or 0) + 1
	end
end

-- Weighted random species pick. `weights` maps rarity -> total weight for that rarity,
-- shared evenly between the (non-limited) species of that rarity.
function Species.rollByRarity(weights: { [string]: number }, rng: Random): Species
	local total = 0
	for rarity, weight in weights do
		if countByRarity[rarity] then
			total += weight
		end
	end
	local roll = rng:NextNumber() * total
	for _, species in list do
		if not species.limited then
			roll -= (weights[species.rarity] or 0) / countByRarity[species.rarity]
			if roll <= 0 then
				return species
			end
		end
	end
	return list[1]
end

-- Species sold in the seed shop, in kiosk order.
Species.ShopList = {} :: { Species }
for _, species in list do
	if species.stockChance > 0 then
		table.insert(Species.ShopList, species)
	end
end

return Species
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">SproutModel</string>
          <string name="Source"><![CDATA[--!strict
-- Builds a Sproutling's look out of primitive parts: round body, face, species topper,
-- and a halo + tint when it carries a mutation. All parts are anchored and non-colliding;
-- callers position the model with :PivotTo().

local Species = require(script.Parent.Species)
local Weather = require(script.Parent.Weather)

export type Sprout = { s: string, m: string?, z: number, u: string }

local SproutModel = {}

local function newPart(model: Model, name: string, shape: Enum.PartType?, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = offset
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.Parent = model
	return p
end

local function addTopper(model: Model, kind: string, s: number, top: number, leaf: Color3)
	if kind == "Leaf" then
		newPart(model, "Stem", Enum.PartType.Cylinder, Vector3.new(0.9 * s, 0.25 * s, 0.25 * s), CFrame.new(0, top + 0.3 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), leaf)
		newPart(model, "Leaf", nil, Vector3.new(1.4 * s, 0.15 * s, 0.8 * s), CFrame.new(0.5 * s, top + 0.75 * s, 0) * CFrame.Angles(0, 0, math.rad(-25)), leaf, Enum.Material.Grass)
	elseif kind == "Petals" then
		for i = 0, 4 do
			local a = i / 5 * math.pi * 2
			newPart(model, "Petal", Enum.PartType.Ball, Vector3.new(0.8 * s, 0.5 * s, 0.8 * s), CFrame.new(math.cos(a) * 0.55 * s, top + 0.25 * s, math.sin(a) * 0.55 * s), leaf)
		end
		newPart(model, "Center", Enum.PartType.Ball, Vector3.new(0.55 * s, 0.55 * s, 0.55 * s), CFrame.new(0, top + 0.4 * s, 0), Color3.fromRGB(255, 220, 90))
	elseif kind == "Cap" then
		newPart(model, "Cap", Enum.PartType.Ball, Vector3.new(3.2 * s, 1.4 * s, 3.2 * s), CFrame.new(0, top + 0.1 * s, 0), leaf)
		for i = 0, 3 do
			local a = i / 4 * math.pi * 2 + 0.4
			newPart(model, "Spot", Enum.PartType.Ball, Vector3.new(0.45 * s, 0.3 * s, 0.45 * s), CFrame.new(math.cos(a) * 0.9 * s, top + 0.6 * s, math.sin(a) * 0.9 * s), Color3.new(1, 1, 1))
		end
	elseif kind == "Spikes" then
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			newPart(model, "Spike", nil, Vector3.new(0.25 * s, 0.9 * s, 0.25 * s), CFrame.new(math.cos(a) * 0.9 * s, top - 0.2 * s, math.sin(a) * 0.9 * s) * CFrame.Angles(math.sin(a) * 0.5, 0, -math.cos(a) * 0.5), leaf, Enum.Material.Neon)
		end
	elseif kind == "Pad" then
		newPart(model, "Pad", Enum.PartType.Cylinder, Vector3.new(0.2 * s, 2.6 * s, 2.6 * s), CFrame.new(0, top, 0) * CFrame.Angles(0, 0, math.rad(90)), leaf, Enum.Material.Grass)
		newPart(model, "Bud", Enum.PartType.Ball, Vector3.new(0.6 * s, 0.6 * s, 0.6 * s), CFrame.new(0.5 * s, top + 0.3 * s, 0.3 * s), Color3.fromRGB(255, 170, 200))
	elseif kind == "Flame" then
		newPart(model, "Flame", Enum.PartType.Ball, Vector3.new(1.3 * s, 1.8 * s, 1.3 * s), CFrame.new(0, top + 0.5 * s, 0), leaf, Enum.Material.Neon)
		newPart(model, "FlameTip", Enum.PartType.Ball, Vector3.new(0.7 * s, 1.1 * s, 0.7 * s), CFrame.new(0, top + 1.3 * s, 0), Color3.fromRGB(255, 240, 150), Enum.Material.Neon)
	elseif kind == "Crystal" then
		for i = -1, 1 do
			newPart(model, "Crystal", nil, Vector3.new(0.5 * s, (1.6 - math.abs(i) * 0.5) * s, 0.5 * s), CFrame.new(i * 0.5 * s, top + 0.5 * s, 0) * CFrame.Angles(0, math.rad(45), math.rad(i * -20)), leaf, Enum.Material.Glass)
		end
	end
end

-- Dew per second a single Sproutling earns before player multipliers.
function SproutModel.income(sprout: Sprout): number
	local species = Species.get(sprout.s)
	if not species then
		return 0
	end
	local mutation = sprout.m and Weather.Mutations[sprout.m]
	return species.dewPerSecond * (mutation and mutation.multiplier or 1) * sprout.z
end

function SproutModel.displayName(sprout: Sprout): string
	local species = Species.get(sprout.s)
	local name = species and species.name or sprout.s
	local mutation = sprout.m and Weather.Mutations[sprout.m]
	if sprout.z >= 2 then
		name = "Huge " .. name
	end
	if mutation then
		name = mutation.name .. " " .. name
	end
	return name
end

function SproutModel.build(sprout: Sprout, withLabel: boolean?): Model
	local species = Species.get(sprout.s) or Species.List[1]
	local mutation = sprout.m and Weather.Mutations[sprout.m]
	local s = 1.4 * sprout.z

	local model = Instance.new("Model")
	model.Name = "Sprout_" .. species.id

	local bodyColor = species.body
	if mutation then
		bodyColor = bodyColor:Lerp(mutation.color, 0.45)
	end
	local body = newPart(model, "Body", Enum.PartType.Ball, Vector3.new(2.4 * s, 2.1 * s, 2.4 * s), CFrame.new(0, 1.05 * s, 0), bodyColor, if sprout.m == "golden" then Enum.Material.Foil else Enum.Material.SmoothPlastic)
	model.PrimaryPart = body
	body.PivotOffset = CFrame.new(0, -1.05 * s, 0) -- pivot at the feet so PivotTo() stands it on a surface

	-- face points towards -Z (model front)
	for _, side in { -1, 1 } do
		newPart(model, "Eye", Enum.PartType.Ball, Vector3.new(0.42 * s, 0.5 * s, 0.3 * s), CFrame.new(side * 0.45 * s, 1.3 * s, -1.05 * s), Color3.fromRGB(30, 30, 40))
		newPart(model, "Shine", Enum.PartType.Ball, Vector3.new(0.14 * s, 0.14 * s, 0.1 * s), CFrame.new(side * 0.45 * s + 0.08 * s, 1.42 * s, -1.2 * s), Color3.new(1, 1, 1), Enum.Material.Neon)
		newPart(model, "Cheek", Enum.PartType.Ball, Vector3.new(0.4 * s, 0.22 * s, 0.1 * s), CFrame.new(side * 0.8 * s, 1.0 * s, -0.98 * s), Color3.fromRGB(255, 150, 160))
		newPart(model, "Foot", Enum.PartType.Ball, Vector3.new(0.7 * s, 0.4 * s, 0.9 * s), CFrame.new(side * 0.55 * s, 0.15 * s, -0.3 * s), species.leaf)
	end

	addTopper(model, species.topper, s, 2.1 * s, species.leaf)

	if mutation then
		local halo = newPart(model, "Halo", Enum.PartType.Cylinder, Vector3.new(0.15 * s, 2 * s, 2 * s), CFrame.new(0, 3.3 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), mutation.color, Enum.Material.Neon)
		halo.Transparency = 0.3
		local light = Instance.new("PointLight")
		light.Color = mutation.color
		light.Range = 10
		light.Brightness = 1.5
		light.Parent = body
	end

	if withLabel then
		local gui = Instance.new("BillboardGui")
		gui.Name = "Info"
		gui.Size = UDim2.fromOffset(200, 50)
		gui.StudsOffsetWorldSpace = Vector3.new(0, 3.2 * s + 1.5, 0)
		gui.MaxDistance = 70
		gui.LightInfluence = 0
		gui.Parent = body
		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "Name"
		nameLabel.BackgroundTransparency = 1
		nameLabel.Size = UDim2.fromScale(1, 0.55)
		nameLabel.Font = Enum.Font.FredokaOne
		nameLabel.TextScaled = true
		nameLabel.Text = SproutModel.displayName(sprout)
		nameLabel.TextColor3 = Species.RarityColors[species.rarity]
		nameLabel.TextStrokeTransparency = 0.3
		nameLabel.Parent = gui
		local incomeLabel = nameLabel:Clone()
		incomeLabel.Name = "Income"
		incomeLabel.Position = UDim2.fromScale(0, 0.55)
		incomeLabel.Size = UDim2.fromScale(1, 0.45)
		incomeLabel.TextColor3 = Color3.fromRGB(150, 230, 255)
		incomeLabel.Text = ""
		incomeLabel.Parent = gui
	end

	return model
end

-- Converts an anchored display model into a carryable one welded to `root`.
function SproutModel.weldTo(model: Model, root: BasePart, offset: CFrame)
	local body = model.PrimaryPart :: BasePart
	model:PivotTo(root.CFrame * offset)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= body then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = body
			weld.Part1 = descendant
			weld.Parent = descendant
		end
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = body
	weld.Parent = body
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
		end
	end
end

return SproutModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Weather</string>
          <string name="Source"><![CDATA[--!strict
-- Weather events and the mutations they can apply when a Sproutling hatches.

export type Mutation = {
	id: string,
	name: string,
	multiplier: number,
	color: Color3,
}

export type WeatherType = {
	id: string,
	name: string,
	growthSpeed: number, -- 2 = plants grow twice as fast while it lasts
	mutation: string?,
	mutationChance: number,
	naturalWeight: number, -- 0 = only via Robux summon
	sky: Color3,
	announce: string,
}

local Weather = {}

Weather.Mutations = {
	golden = { id = "golden", name = "Golden", multiplier = 4, color = Color3.fromRGB(255, 205, 50) },
	dewy = { id = "dewy", name = "Dewy", multiplier = 1.5, color = Color3.fromRGB(120, 200, 255) },
	charged = { id = "charged", name = "Charged", multiplier = 2, color = Color3.fromRGB(255, 255, 110) },
	starry = { id = "starry", name = "Starry", multiplier = 3, color = Color3.fromRGB(190, 170, 255) },
	prismatic = { id = "prismatic", name = "Prismatic", multiplier = 6, color = Color3.fromRGB(255, 120, 230) },
	-- Halloween "Hollow Harvest": Spooky Fog's mutation.
	haunted = { id = "haunted", name = "Haunted", multiplier = 3, color = Color3.fromRGB(150, 90, 255) },
} :: { [string]: Mutation }

Weather.Types = {
	drizzle = { id = "drizzle", name = "Drizzle", growthSpeed = 2, mutation = "dewy", mutationChance = 0.3, naturalWeight = 50, sky = Color3.fromRGB(150, 170, 190), announce = "A Drizzle rolls in: plants grow 2x faster and may hatch Dewy!" },
	thunder = { id = "thunder", name = "Thunderbloom", growthSpeed = 1.5, mutation = "charged", mutationChance = 0.2, naturalWeight = 30, sky = Color3.fromRGB(90, 90, 120), announce = "Thunderbloom! Hatches may come out Charged (x2)!" },
	starfall = { id = "starfall", name = "Starfall", growthSpeed = 1, mutation = "starry", mutationChance = 0.15, naturalWeight = 15, sky = Color3.fromRGB(40, 40, 90), announce = "Stars are falling! Hatches may turn Starry (x3)!" },
	aurora = { id = "aurora", name = "Aurora", growthSpeed = 1.5, mutation = "prismatic", mutationChance = 0.1, naturalWeight = 5, sky = Color3.fromRGB(80, 200, 170), announce = "AURORA! Prismatic (x6) hatches are possible!" },
	-- Halloween "Hollow Harvest" (see vault/Projects/Sproutling Isles - Launch & Live Ops.md).
	-- naturalWeight = 0: never rolled by pickNatural(), only ever started by EventService's schedule
	-- or a Robux summon (see WeatherService.pickNatural's explicit weight > 0 filter).
	spookyfog = { id = "spookyfog", name = "Spooky Fog", growthSpeed = 1.5, mutation = "haunted", mutationChance = 0.2, naturalWeight = 0, sky = Color3.fromRGB(70, 40, 100), announce = "Spooky Fog creeps in... hatches may turn HAUNTED (x3)! Catch the Wisp Lanterns!" },
} :: { [string]: WeatherType }

return Weather
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="20">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Sproutling Isles server bootstrap: builds the map if it isn't baked in, starts every
-- service, and manages the player lifecycle (load -> claim plot -> tick income -> save).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)
local MapBuilder = require(Shared.MapBuilder)
local Ambience = require(Shared.Ambience)
local Events = require(Shared.Events)

local Net = require(script.Net)
local State = require(script.State)
local Analytics = require(script.Analytics)
local Badges = require(script.Badges)
local DataService = require(script.DataService)
local WeatherService = require(script.WeatherService)
local PlotService = require(script.PlotService)
local SnatchService = require(script.SnatchService)
local ShopService = require(script.ShopService)
local PondService = require(script.PondService)
local ProgressionService = require(script.ProgressionService)
local MonetizationService = require(script.MonetizationService)
local LeaderboardService = require(script.LeaderboardService)
local EventService = require(script.EventService)
local CodesService = require(script.CodesService)

local map = workspace:FindFirstChild("Map") or MapBuilder.Build(workspace)
Ambience.Apply(game:GetService("Lighting")) -- before WeatherService.init, which captures the clear-sky defaults

WeatherService.init()
PlotService.init(map)
SnatchService.init()
ShopService.init(map)
PondService.init(map)
ProgressionService.init(map)
MonetizationService.init()
LeaderboardService.init(map)
EventService.init(map) -- after WeatherService.init so the Fog scheduler's onStart/onStop hooks are live
CodesService.init() -- Week 5 live-ops: the in-world Codes box (client HUD), see CodesService.luau

----------------------------------------------------------------------------------------------
-- player lifecycle

local function onCharacter(session: State.Session, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	character:WaitForChild("HumanoidRootPart", 10)
	humanoid.WalkSpeed = game:GetService("StarterPlayer").CharacterWalkSpeed
	task.defer(PlotService.teleportHome, session)
	-- VIP name tag
	if session.passes.VIP then
		local head = character:WaitForChild("Head", 5)
		if head then
			local tag = Instance.new("BillboardGui")
			tag.Name = "VIPTag"
			tag.Size = UDim2.fromOffset(100, 24)
			tag.StudsOffset = Vector3.new(0, 2.6, 0)
			tag.MaxDistance = 80
			tag.Parent = head
			local text = Instance.new("TextLabel")
			text.BackgroundTransparency = 1
			text.Size = UDim2.fromScale(1, 1)
			text.Font = Enum.Font.FredokaOne
			text.TextScaled = true
			text.Text = "VIP"
			text.TextColor3 = Color3.fromRGB(255, 210, 60)
			text.TextStrokeTransparency = 0.2
			text.Parent = tag
		end
	end
end

local function onPlayerAdded(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	-- Rebirths first so the player list sorts by it (Dew is a formatted string, which sorts as text; m13)
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	local dew = Instance.new("StringValue")
	dew.Name = "Dew"
	dew.Parent = stats
	stats.Parent = player
	local seeds = Instance.new("Folder")
	seeds.Name = "Seeds"
	seeds.Parent = player

	local data, persist, isNewSave = DataService.load(player)
	if not player.Parent then
		if persist then
			DataService.save(player, data, true)
		end
		return
	end

	-- 3a step 1 "Joined": only for a save that never existed before, so this never re-fires for a
	-- returning player (including ones who joined before the `onb` field existed).
	if isNewSave and not data.onb.Joined then
		data.onb.Joined = true
		Analytics.onboarding(player, "Joined")
	end

	local now = Events.now()

	-- Week 1 launch incentive: "Founding Gardener" badge + flag, granted once, ever, on a player's
	-- first-ever join, if that join falls inside Week 1. See Events.FoundingGardenerWindow and
	-- vault/Projects/Sproutling Isles - Launch & Live Ops.md, Week 1 section.
	if isNewSave and not data.foundingGardener then
		if now >= Events.FoundingGardenerWindow.startAt and now < Events.FoundingGardenerWindow.endAt then
			data.foundingGardener = true
			Badges.award(player, Config.FoundingGardenerBadgeId)
		end
	end

	-- Week 8 "Frostbloom Seedling" login-day teaser: record today's UTC calendar day if this join
	-- falls inside the teaser window and today isn't already recorded; once 3 distinct days are
	-- recorded, mark qualified and stop recording further days. Data-only -- the actual Frostfawn
	-- seed grant is a future task for whatever builds the Frostbloom Advent Gift system, which
	-- should check data.frostbloomTeaser.qualified on Day 1 (Sat 12 Dec). See
	-- Events.FrostbloomTeaserWindow and the Week 8 section of the same note.
	if not data.frostbloomTeaser.qualified and now >= Events.FrostbloomTeaserWindow.startAt and now <= Events.FrostbloomTeaserWindow.endAt then
		local today = now // 86400
		local alreadyRecorded = false
		for _, day in data.frostbloomTeaser.days do
			if day == today then
				alreadyRecorded = true
				break
			end
		end
		if not alreadyRecorded then
			table.insert(data.frostbloomTeaser.days, today)
			if #data.frostbloomTeaser.days >= Events.FrostbloomTeaserDaysNeeded then
				data.frostbloomTeaser.qualified = true
			end
		end
	end

	local shield = if data.playSeconds < Config.NewPlayerShieldSeconds then now + (Config.NewPlayerShieldSeconds - data.playSeconds) else 0
	if data.shieldForfeited or (Config.StudioDisableShield and RunService:IsStudio()) then
		shield = 0 -- m7: snatching gives the shield up for good; M6: Studio test switch
	end
	local session: State.Session = {
		player = player,
		data = data,
		persist = persist,
		plot = nil,
		selectedSeed = nil,
		stock = {},
		lockUntil = 0,
		shieldUntil = shield,
		carrying = nil,
		snatchReadyAt = 0,
		luckUntil = tonumber(data.luckUntil) or 0, -- M5: a paid Luck Boost survives rejoining
		pondReadyAt = 0,
		passes = {},
		joinedAt = now,
		dewRemainder = 0,
		incomeSinceLog = 0,
	}
	State.sessions[player] = session

	if not PlotService.claim(session) then
		-- servers are capped at 8 players (one per plot) in Game Settings; this is a safety net
		player:Kick("This garden island is full. Please join another server!")
		return
	end
	MonetizationService.loadPasses(session)
	ShopService.loadStock(session)
	State.syncAll(session)
	PlotService.renderPads(session)
	EventService.onJoin(session) -- Hollow Harvest: sync the Moonberries/skin attributes, convert leftovers if the event has ended

	player.CharacterAdded:Connect(function(character)
		onCharacter(session, character)
	end)
	if player.Character then
		onCharacter(session, player.Character)
	end

	if not persist then
		State.notify(session, "Saving is off in this server (Studio without API access?). Progress won't be kept.", "#ffb070")
	end
	if data.totalDew == 0 then
		State.notify(session, "Welcome to Sproutling Isles! Walk to the brown soil and plant your free seeds.", "#a0ffa0")
	end
end

-- 3c Income Source event: batched, never per-tick (per-server analytics rate limits). Also
-- reports totalDew to the income leaderboard on the same batch, so that never writes per-tick either.
local function flushIncome(session: State.Session)
	local amount = session.incomeSinceLog or 0
	if amount > 0 then
		Analytics.source(session.player, "Income", amount, session.data.dew)
		session.incomeSinceLog = 0
		LeaderboardService.reportIncome(session.player, session.data.totalDew)
	end
end

-- 3d SessionEnd's income bucket: the player's current Dew/s rate, not their balance.
local function incomeBucket(income: number): string
	if income < 10 then
		return "<10"
	elseif income < 100 then
		return "<100"
	elseif income < 1000 then
		return "<1k"
	elseif income < 10000 then
		return "<10k"
	else
		return "10k+"
	end
end

local function onPlayerRemoving(player: Player)
	local session = State.get(player)
	if not session or session.leaving then
		return -- m1: PlayerRemoving and BindToClose both call this on shutdown; save once
	end
	session.leaving = true
	flushIncome(session)
	SnatchService.onLeaving(player)
	-- 3d SnatchVictimLeft: this player left within 120s of being snatched from
	if session.lastStolenAt and os.time() - session.lastStolenAt <= 120 then
		Analytics.custom(player, "SnatchVictimLeft", os.time() - session.lastStolenAt, { session.lastStolenRarity or "unknown" })
	end
	session.data.playSeconds += os.time() - session.joinedAt
	session.joinedAt = os.time()
	-- 3d SessionEnd
	Analytics.custom(player, "SessionEnd", math.floor(session.data.playSeconds / 60), {
		tostring(session.data.rebirths),
		incomeBucket(State.income(session)),
	})
	PlotService.release(session)
	if session.persist then
		DataService.save(player, session.data, true)
	end
	State.sessions[player] = nil
end

Net.SelectSeed.OnServerEvent:Connect(function(player, speciesId)
	local session = State.get(player)
	if session and type(speciesId) == "string" and Species.get(speciesId) then
		session.selectedSeed = speciesId
		player:SetAttribute("SelectedSeed", speciesId)
	end
end)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- income tick
task.spawn(function()
	while true do
		task.wait(1)
		for _, session in State.sessions do
			-- carry fractions over so a 1.2 Dew/s garden really earns 1.2 per second
			local total = State.income(session) + session.dewRemainder
			local whole = math.floor(total)
			session.dewRemainder = total - whole
			if whole > 0 then
				State.addDew(session, whole) -- no reason: logged in the 5-min batch below, not per-tick
				session.incomeSinceLog = (session.incomeSinceLog or 0) + whole
			end
			-- 3b Rebirth funnel step 1 "CanAfford": fires once per rebirth tier, the first time this
			-- tick sees enough Dew for it (not every tick after that).
			local tier = session.data.rebirths
			if session.rebirthCanAffordTier ~= tier and session.data.dew >= ProgressionService.rebirthCost(session) then
				session.rebirthCanAffordTier = tier
				Analytics.funnel(session.player, "Rebirth", "rb" .. tier, 1, "CanAfford")
			end
		end
	end
end)

-- batched income analytics: one Source event every 5 min (also flushed on leave, see flushIncome)
task.spawn(function()
	while true do
		task.wait(5 * 60)
		for _, session in State.sessions do
			flushIncome(session)
		end
	end
end)

-- autosave
task.spawn(function()
	while true do
		task.wait(Config.AutosaveSeconds)
		for player, session in State.sessions do
			if session.persist and not session.leaving then -- m2
				local now = os.time()
				session.data.playSeconds += now - session.joinedAt
				session.joinedAt = now
				task.spawn(DataService.save, player, session.data, false)
			end
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player in State.sessions do
		pending += 1
		task.spawn(function()
			onPlayerRemoving(player)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 25
	-- also wait for saves started by PlayerRemoving (onPlayerRemoving returns early for those)
	while (pending > 0 or DataService.pendingSaves() > 0) and os.clock() < deadline do
		task.wait(0.2)
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Analytics</string>
          <string name="Source"><![CDATA[-- Thin wrapper around Roblox AnalyticsService. Every real call is wrapped in pcall so a
-- rate limit, a wrong argument or a service outage never breaks gameplay: we warn and move on.
--
-- NOTE (unverified): the AnalyticsService method signatures below are written from the spec in
-- vault/Projects/Sproutling Isles - Launch & Live Ops.md section 3, which itself says they are
-- "from memory, must be checked against Creator Docs". This sandbox has no internet access, so
-- they have NOT been checked against the live Creator Docs. If Roblox's real signatures differ,
-- the pcall below stops it from crashing gameplay, but the events may simply fail to log until
-- someone verifies and fixes the argument order/names against the current docs.

local AnalyticsService = game:GetService("AnalyticsService")

local Analytics = {}

-- 3a. Onboarding funnel, once per player, ever. Order matches the spec's table exactly; Roblox
-- uses the step number to draw the funnel and the drop-off between steps.
local ONBOARDING_STEP_NUMBER: { [string]: number } = {
	Joined = 1,
	PlotClaimed = 2,
	FirstPlant = 3,
	FirstHatch = 4,
	FirstSeedBought = 5,
	FirstSell = 6,
	FirstWeatherHatch = 7,
	FirstGateLock = 8,
	FirstPondCast = 9,
	FirstDailyClaim = 10,
	FirstPurchase = 11,
}

-- 3c. Economy events: derive a default transactionType from the reason's prefix (the part before
-- the first ":"), matching the spec's table. Callers can still override it explicitly.
local TRANSACTION_TYPE_BY_REASON_PREFIX: { [string]: string } = {
	Income = "Gameplay",
	Sell = "Gameplay",
	SellStorage = "Gameplay",
	Daily = "TimedReward",
	Pond = "Gameplay",
	IAP = "IAP",
	AdReward = "Gameplay",
	Event = "Gameplay",
	Seed = "Shop",
	Rebirth = "Gameplay",
	EventShop = "Shop",
	Code = "Gameplay", -- Week 5 Codes system (CodesService.luau); not in the section 3 spec table, chosen to match the closest existing free-grant precedent (Daily uses TimedReward, but a one-off redeemable code reads closer to a plain Gameplay grant)
}

local CUSTOM_FIELD_KEYS = {
	Enum.AnalyticsCustomFieldKeys.CustomField01,
	Enum.AnalyticsCustomFieldKeys.CustomField02,
	Enum.AnalyticsCustomFieldKeys.CustomField03,
}

-- Custom fields: up to 3 short, low-cardinality values (rarity names, not UIDs). Accepts a plain
-- array so call sites don't need to know the Enum; nils are skipped.
local function toCustomFields(fields: { string? }?): { [any]: string }?
	if not fields then
		return nil
	end
	local out = {}
	local any = false
	for i = 1, 3 do
		local value = fields[i]
		if value ~= nil then
			out[CUSTOM_FIELD_KEYS[i]] = tostring(value)
			any = true
		end
	end
	if not any then
		return nil
	end
	return out
end

local function reasonPrefix(reason: string): string
	return reason:match("^([^:]+)") or reason
end

local function transactionTypeFor(reason: string): string
	return TRANSACTION_TYPE_BY_REASON_PREFIX[reasonPrefix(reason)] or "Gameplay"
end

-- Fires an onboarding funnel step exactly once (callers guard with `session.data.onb[stepName]`).
function Analytics.onboarding(player: Player, stepName: string)
	local step = ONBOARDING_STEP_NUMBER[stepName]
	if not step then
		warn("[Analytics] unknown onboarding step:", stepName)
		return
	end
	local ok, err = pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, stepName)
	end)
	if not ok then
		warn("[Analytics] LogOnboardingFunnelStepEvent failed:", err)
	end
end

-- 3b recurring funnels (Store/Snatch/Rebirth/EventShop/Ad) are not wired yet; this wrapper exists
-- so a follow-up task can call it without touching Analytics.luau again.
function Analytics.funnel(
	player: Player,
	funnelName: string,
	funnelSessionId: string?,
	step: number,
	stepName: string,
	customFields: { string? }?
)
	local ok, err = pcall(function()
		AnalyticsService:LogFunnelStepEvent(player, funnelName, funnelSessionId, step, stepName, toCustomFields(customFields))
	end)
	if not ok then
		warn("[Analytics] LogFunnelStepEvent failed:", err)
	end
end

local function economy(
	flowType: any,
	player: Player,
	reason: string,
	amount: number,
	endingBalance: number,
	currencyType: string?,
	transactionType: string?
)
	local ok, err = pcall(function()
		AnalyticsService:LogEconomyEvent(
			player,
			flowType,
			currencyType or "Dew",
			amount,
			endingBalance,
			transactionType or transactionTypeFor(reason),
			reason
		)
	end)
	if not ok then
		warn("[Analytics] LogEconomyEvent failed:", err)
	end
end

-- 3c economy source (income, sells, daily gifts, pond, IAP...). `reason` doubles as the itemSku.
function Analytics.source(
	player: Player,
	reason: string,
	amount: number,
	endingBalance: number,
	currencyType: string?,
	transactionType: string?
)
	economy(Enum.AnalyticsEconomyFlowType.Source, player, reason, amount, endingBalance, currencyType, transactionType)
end

-- 3c economy sink (seed purchases, rebirth's Dew reset...). Same shape as Analytics.source.
function Analytics.sink(
	player: Player,
	reason: string,
	amount: number,
	endingBalance: number,
	currencyType: string?,
	transactionType: string?
)
	economy(Enum.AnalyticsEconomyFlowType.Sink, player, reason, amount, endingBalance, currencyType, transactionType)
end

-- 3d custom events. Not wired yet (a follow-up task); exists so call sites can start using it
-- without another change to this file.
function Analytics.custom(player: Player, eventName: string, value: number?, customFields: { string? }?)
	local ok, err = pcall(function()
		AnalyticsService:LogCustomEvent(player, eventName, value, toCustomFields(customFields))
	end)
	if not ok then
		warn("[Analytics] LogCustomEvent failed:", err)
	end
end

return Analytics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Badges</string>
          <string name="Source"><![CDATA[-- Thin wrapper around Roblox BadgeService, same pcall-facade pattern as Analytics.luau: a
-- throttle, a bad ID or a service outage must never break gameplay.

local BadgeService = game:GetService("BadgeService")

local Badges = {}

-- Awards `badgeId` to `player`. No-ops (silently, no warning) while badgeId is 0 -- see
-- Products.luau's "IDs are 0 until you create the passes/products... paste the real IDs here"
-- convention: the badge hasn't been created on the Creator Dashboard yet. Once a real ID is
-- pasted into Config, this actually calls BadgeService, pcall-wrapped like every other
-- external-service call in this codebase (BadgeService:AwardBadge can throttle or fail).
function Badges.award(player: Player, badgeId: number)
	if badgeId == 0 then
		return
	end
	local ok, err = pcall(function()
		BadgeService:AwardBadge(player.UserId, badgeId)
	end)
	if not ok then
		warn("[Badges] AwardBadge failed:", err)
	end
end

return Badges
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Codes</string>
          <string name="Source"><![CDATA[--!strict
-- Week 5 live-ops "Codes" system (vault/Projects/Sproutling Isles - Launch & Live Ops.md, Week 5,
-- 7 Nov): a server-side table of redeemable codes and their rewards. See CodesService.luau for
-- redemption, validation and one-time-per-player tracking.
--
-- Per the spec, rewards must stay FREE-TIER ONLY: Dew, common/rare seeds, or a short Luck Boost.
-- Never add a reward here that only paying players could otherwise get (skins, game passes,
-- dev-product-gated perks) -- codes must not create a paid-only shortcut.
--
-- Reward shape: { dew: number?, seeds: { [speciesId]: count }?, luckSeconds: number? }.
-- A single code may combine more than one field; at least one should be set or redeeming does
-- nothing. `seeds` keys must be Species ids of Common/Uncommon/Rare rarity only (CodesService
-- doesn't enforce this at runtime since this table is dev-authored, not player input).

export type Reward = {
	dew: number?,
	seeds: { [string]: number }?,
	luckSeconds: number?,
}

local Codes = {}

Codes.list = {
	-- Real Week 5 code list (live-ops-manager proposal, 2026-09-26; GROWINGSTRONG's seed reward
	-- reviewed/swapped by game-designer same day -- see the vault note's "Week 5 code list" section
	-- for the full table, rationale and retention window per code). Goes live 7 Nov.

	-- The announcement copy already promises this exact code -- evergreen "thank you for finding
	-- the Codes button" grant.
	SPROUT1K = { dew = 1000 } :: Reward,

	-- Catch-up code for players who joined during Weeks 2-4 and missed the Week 1 Founding
	-- Gardener window.
	MISSEDBLOOM = { dew = 500, seeds = { mossbun = 1 } } :: Reward,

	-- Matches the shortest ad-tier Luck reward (5 min) so a code never beats the free ad path.
	LUCKYGARDEN = { luckSeconds = 300 } :: Reward,

	-- Community milestone/thank-you code. Reward uses mushroomph (not lilypadger -- swapped
	-- 2026-09-26 after a balance review found lilypadger priced above the paid Starter Pack's own
	-- Rare seed; mushroomph matches the Starter Pack's grant instead).
	GROWINGSTRONG = { dew = 250, seeds = { mushroomph = 1 } } :: Reward,

	-- Dew-free code: pure seed variety for new or alt accounts still Dew-poor.
	SEEDSTASH = { seeds = { mossbun = 2 } } :: Reward,
} :: { [string]: Reward }

return Codes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">CodesService</string>
          <string name="Source"><![CDATA[-- Week 5 live-ops "Codes" system: a player opens the client Codes box, types a code and hits
-- Redeem; this validates it server-side and grants a one-time, per-player, free-tier-only reward
-- (Dew, common/rare seeds, or a short Luck Boost -- see Codes.luau for the reward table and why).
-- Bad, already-redeemed and spammed attempts all get a clear toast via State.notify, matching the
-- pattern used by ShopService/PondService/SnatchService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Species = require(Shared.Species)
local Format = require(Shared.Format)

local Net = require(script.Parent.Net)
local State = require(script.Parent.State)
local Analytics = require(script.Parent.Analytics)
local Codes = require(script.Parent.Codes)

local CodesService = {}

local MAX_CODE_LENGTH = 24
local REDEEM_COOLDOWN = 1 -- seconds; a spammed client just gets ignored, not a toast

local function describeReward(reward: Codes.Reward): string
	local parts = {}
	if reward.dew and reward.dew > 0 then
		table.insert(parts, Format.number(reward.dew) .. " Dew")
	end
	if reward.seeds then
		for speciesId, count in reward.seeds do
			if count > 0 then
				local species = Species.get(speciesId)
				table.insert(parts, count .. "x " .. (species and species.name or speciesId) .. " seed")
			end
		end
	end
	if reward.luckSeconds and reward.luckSeconds > 0 then
		table.insert(parts, Format.time(reward.luckSeconds) .. " Luck Boost")
	end
	if #parts == 0 then
		return "nothing (this code has no reward set -- tell roblox-engineer)"
	end
	return table.concat(parts, ", ")
end

local function grant(session: State.Session, reward: Codes.Reward, reason: string)
	if reward.dew and reward.dew > 0 then
		State.addDew(session, reward.dew, reason)
	end
	if reward.seeds then
		for speciesId, count in reward.seeds do
			if count > 0 and Species.get(speciesId) then
				State.addSeeds(session, speciesId, count)
			end
		end
	end
	if reward.luckSeconds and reward.luckSeconds > 0 then
		-- M5 pattern (MonetizationService.LuckBoost): both the in-memory session field and the saved
		-- data field must be set, or the boost silently doesn't survive a rejoin/server hop.
		session.luckUntil = math.max(session.luckUntil, os.time()) + reward.luckSeconds
		session.data.luckUntil = session.luckUntil
		session.player:SetAttribute("LuckUntil", session.luckUntil)
	end
end

local function redeem(player: Player, rawCode: string)
	local session = State.get(player)
	if not session then
		return
	end
	local now = os.clock()
	if (session.codeReadyAt or 0) > now then
		return -- silent: a spammed/scripted client, not a real user mistake worth a toast
	end
	session.codeReadyAt = now + REDEEM_COOLDOWN
	if type(rawCode) ~= "string" then
		return
	end
	-- Case-insensitive, whitespace-trimmed: a reasonable UX default the spec doesn't dictate.
	local code = rawCode:gsub("%s+", ""):upper()
	if code == "" then
		return
	end
	if #code > MAX_CODE_LENGTH then
		State.notify(session, "That code doesn't look right.", "#ff8080")
		return
	end
	local reward = Codes.list[code]
	if not reward then
		State.notify(session, '"' .. code .. '" isn\'t a valid code.', "#ff8080")
		return
	end
	session.data.codes = session.data.codes or {}
	if session.data.codes[code] then
		State.notify(session, 'You already redeemed "' .. code .. '".', "#ffb070")
		return
	end
	session.data.codes[code] = true
	grant(session, reward, "Code:" .. code)
	State.notify(session, "Code redeemed! +" .. describeReward(reward), "#a0ffa0")
	Analytics.custom(player, "CodeRedeemed", nil, { code })
end

function CodesService.init()
	Net.RedeemCode.OnServerEvent:Connect(redeem)
end

return CodesService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Loads and saves player profiles with a lightweight session lock so a player who hops
-- servers quickly can't load stale data (which would let snatched Sproutlings be duplicated).
-- In Studio without API access, profiles run in memory only.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local DataService = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Sproutling] DataStore unavailable, progress will not save:", result)
	end
end

local jobId = if game.JobId ~= "" then game.JobId else "studio"

-- Saves are serialised per player so an older write can never land after a newer one:
--   inFlight[userId]  - a save for this player is running right now
--   released[userId]  - the leave-save (lock release) is done; later non-release saves are
--                       dropped so a late autosave can't re-take the lock (cleared on next load)
local inFlight: { [number]: boolean } = {}
local released: { [number]: boolean } = {}

local function waitIdle(userId: number, timeout: number)
	local deadline = os.clock() + timeout
	while inFlight[userId] and os.clock() < deadline do
		task.wait(0.1)
	end
end

-- Number of saves currently running (BindToClose waits for this to reach 0).
function DataService.pendingSaves(): number
	local n = 0
	for _ in inFlight do
		n += 1
	end
	return n
end

function DataService.defaultData()
	return {
		dew = Config.StartingDew,
		totalDew = 0,
		rebirths = 0,
		seeds = table.clone(Config.StartingSeeds),
		soil = {}, -- [tostring(tile)] = { s = speciesId, ready = unixTime, total = seconds }
		pads = {}, -- [tostring(pad)] = sprout
		storage = {}, -- array of sprouts
		streak = 0,
		lastDaily = 0,
		playSeconds = 0,
		starterBought = false,
		receipts = {},
		stock = {}, -- [speciesId] = count left in this player's Seed Shop
		stockEpoch = 0, -- the restock time (ShopService.nextRestockAt) the saved stock belongs to
		luckUntil = 0, -- Luck Boost end, absolute Unix time so it survives server hops
		shieldForfeited = false, -- true once the player has snatched (no new-player shield after that)
		onb = {}, -- [stepName] = true once that onboarding funnel step has been logged, ever
		bestHatch = { rarityIndex = 0, order = 0, species = "" }, -- highest rarity/species ever
		-- hatched (0 = none yet); backs the rarest-hatch leaderboard, see LeaderboardService.
		-- Halloween "Hollow Harvest" (EventService.luau). berries = Moonberries balance;
		-- lanternDay = UTC day (os.time() // 86400) the +20 daily-first-lantern bonus was last paid;
		-- stallBuys = { [itemId] = { day = utcDay, n = count } } per-item daily purchase caps.
		event = { id = "halloween2026", berries = 0, lanternDay = 0, stallBuys = {} },
		skins = {}, -- [skinId] = true once earned, e.g. skins.haunted; kept forever, earn-only
		skin = "", -- currently equipped cosmetic plot skin id ("" = none)
		codes = {}, -- [code] = true once redeemed, ever (Week 5 Codes system, see CodesService.luau)
		-- Week 1 launch incentive: true once earned (first-ever join fell inside Week 1), independent
		-- of whether the real Roblox badge could be awarded yet (Config.FoundingGardenerBadgeId may
		-- still be 0). Backs the title/cosmetic-greenhouse-flag part of the spec later; see
		-- init.server.luau and Events.FoundingGardenerWindow.
		foundingGardener = false,
		-- Week 8 "Frostbloom Seedling" teaser: a login-day tracker only, no reward yet. `days` is the
		-- set of distinct UTC calendar days (os.time() // 86400) recorded inside
		-- Events.FrostbloomTeaserWindow; `qualified` flips true once 3 distinct days are recorded (see
		-- Events.FrostbloomTeaserDaysNeeded). The Frostfawn seed grant is a future task for whatever
		-- builds the Frostbloom Advent Gift system, which should check this flag on Day 1 (Sat 12 Dec).
		frostbloomTeaser = { days = {}, qualified = false },
	}
end

local function reconcile(data)
	local defaults = DataService.defaultData()
	for key, value in defaults do
		if data[key] == nil then
			data[key] = value
		end
	end
	return data
end

local function key(player: Player): string
	return "p_" .. player.UserId
end

-- Returns data table, whether it is backed by the DataStore, and whether this is a brand-new
-- save (no profile existed for this player before this load) -- used to fire the "Joined"
-- onboarding step exactly once, ever, even after this field is added to already-existing saves.
function DataService.load(player: Player): ({ [string]: any }, boolean, boolean)
	if not store then
		return DataService.defaultData(), false, true
	end
	-- a fast rejoin to this same server must not read data older than the leave-save still in flight
	waitIdle(player.UserId, 30)
	released[player.UserId] = nil
	for attempt = 1, 6 do
		local loaded = nil
		local locked = false
		local isNew = false
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function(old)
				old = old or {}
				local lock = old.lock
				if attempt < 6 and lock and lock.job ~= jobId and os.time() - lock.t < Config.SessionLockSeconds then
					locked = true
					return nil -- cancel write, another server still owns this profile
				end
				old.lock = { job = jobId, t = os.time() }
				isNew = old.data == nil
				loaded = old.data
				return old
			end)
		end)
		if ok and not locked then
			return reconcile(loaded or DataService.defaultData()), true, isNew
		end
		if not ok then
			warn("[Sproutling] load failed for", player.Name, err)
			if RunService:IsStudio() then
				return DataService.defaultData(), false, true
			end
		end
		if not player.Parent then
			break
		end
		task.wait(5)
	end
	return DataService.defaultData(), false, true
end

function DataService.save(player: Player, data, release: boolean): boolean
	if not store then
		return true
	end
	local userId = player.UserId
	waitIdle(userId, 30)
	if released[userId] then
		return true -- this player already left and released the lock; nothing newer to write
	end
	inFlight[userId] = true
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function(old)
			old = old or {}
			if old.lock and old.lock.job ~= jobId then
				return nil -- another server took over; never overwrite its newer data
			end
			old.data = data
			old.lock = if release then nil else { job = jobId, t = os.time() }
			return old
		end)
	end)
	inFlight[userId] = nil
	if ok and release then
		released[userId] = true
	end
	if not ok then
		warn("[Sproutling] save failed for", player.Name, err)
	end
	return ok
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[-- Halloween "Hollow Harvest": the Spooky Fog scheduler, Wisp Lantern spawn/pickup/despawn, hatch
-- Moonberry bonuses, the Lantern Stall (3 kiosks, reusing the Seed Shop's Prompts.create pattern),
-- the plot skin equip toggle, and the end-of-event Moonberry -> Dew conversion.
-- See vault/Projects/Sproutling Isles - Launch & Live Ops.md, "Halloween event spec Hollow Harvest".

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Events = require(Shared.Events)
local Species = require(Shared.Species)
local Format = require(Shared.Format)

local Net = require(script.Parent.Net)
local State = require(script.Parent.State)
local Analytics = require(script.Parent.Analytics)
local Prompts = require(script.Parent.Prompts)
local WeatherService = require(script.Parent.WeatherService)

local EventService = {}

local cfg = Events.Halloween2026

----------------------------------------------------------------------------------------------
-- skin-change hook (7. PlotService applies data.skin on claim and whenever it's toggled here;
-- EventService does not require PlotService back, so there's no circular require)

local skinChangeCallbacks: { (State.Session) -> () } = {}

function EventService.onSkinChange(fn: (State.Session) -> ())
	table.insert(skinChangeCallbacks, fn)
end

local function fireSkinChange(session: State.Session)
	for _, fn in skinChangeCallbacks do
		local ok, err = pcall(fn, session)
		if not ok then
			warn("[EventService] onSkinChange callback failed:", err)
		end
	end
end

----------------------------------------------------------------------------------------------
-- economy helper

local function grantMoonberries(session: State.Session, amount: number, reason: string)
	session.data.event.berries += amount
	session.player:SetAttribute("Moonberries", session.data.event.berries)
	Analytics.source(session.player, "Event:" .. reason, amount, session.data.event.berries, "Moonberries")
end

----------------------------------------------------------------------------------------------
-- hatch bonus (called from PlotService's hatch branch, item 7)

function EventService.onHatch(player: Player, wasHaunted: boolean)
	if not Events.active(cfg, Events.now()) then
		return
	end
	local session = State.get(player)
	if not session then
		return
	end
	local amount = if wasHaunted then cfg.hauntedHatchBonus else cfg.hatchBonus
	grantMoonberries(session, amount, if wasHaunted then "HauntedHatch" else "Hatch")
end

----------------------------------------------------------------------------------------------
-- Wisp Lanterns

local lanternFolder: Folder
local spawnPoints: { BasePart } = {}
-- one entry per lantern currently standing this Fog; `collected` is per-player so a player who
-- joins mid-Fog still sees (and can take) every lantern still standing, not just the ones nobody
-- has taken yet (per the spec's join-mid-Fog edge case).
type LanternEntry = { part: BasePart, prompt: ProximityPrompt, collected: { [number]: boolean } }
local activeLanterns: { LanternEntry } = {}

local function utcDay(now: number): number
	return now // 86400
end

local function onLanternTriggered(entry: LanternEntry, player: Player)
	local session = State.get(player)
	if not session or entry.collected[player.UserId] then
		return
	end
	-- exploit check: re-validate distance server-side (the spec's <= 12 studs), don't trust the
	-- prompt's own activation distance alone (see SnatchService's M1 pad-distance check for the
	-- same pattern in this codebase).
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - entry.part.Position).Magnitude > 12 then
		return
	end
	entry.collected[player.UserId] = true
	local now = Events.now()
	local day = utcDay(now)
	local amount = cfg.lanternValue
	local dailyBonus = false
	if session.data.event.lanternDay ~= day then
		session.data.event.lanternDay = day
		amount += cfg.lanternDailyBonus
		dailyBonus = true
	end
	grantMoonberries(session, amount, "Lantern")
	Analytics.custom(player, "EventLantern", amount)
	if dailyBonus then
		State.notify(session, "+" .. amount .. " Moonberries (+" .. cfg.lanternDailyBonus .. " daily bonus!)", "#ffb347")
	else
		State.notify(session, "+" .. amount .. " Moonberries", "#ffb347")
	end
	-- "the client hides the lantern after pickup" (per-player only: everyone else can still take
	-- this same lantern). Reuses the existing Effect remote instead of adding a new one; the client
	-- only mutates its own local rendering, so this never affects other players' view of it.
	Net.Effect:FireClient(player, "LanternGone", entry.part)
end

local function makeLantern(position: Vector3): LanternEntry
	local p = Instance.new("Part")
	p.Name = "Lantern"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(2.2, 2.2, 2.2)
	p.Anchored = true
	p.CanCollide = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 170, 60)
	p.Position = position + Vector3.new(0, 3, 0)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 60)
	light.Range = 16
	light.Parent = p
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromOffset(160, 40)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	gui.Parent = p
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextStrokeTransparency = 0.3
	text.TextColor3 = Color3.fromRGB(255, 200, 120)
	text.Text = "Wisp Lantern"
	text.Parent = gui
	p.Parent = lanternFolder

	local prompt = Prompts.create(p, "Catch (+" .. cfg.lanternValue .. " Moonberries)", "Wisp Lantern")
	prompt.MaxActivationDistance = 12
	local entry: LanternEntry = { part = p, prompt = prompt, collected = {} }
	prompt.Triggered:Connect(function(player)
		onLanternTriggered(entry, player)
	end)
	return entry
end

local function spawnLanterns()
	if #spawnPoints == 0 then
		return
	end
	-- shuffle a copy of the spawn points, then take up to lanternCount of them (Fisher-Yates)
	local shuffled = table.clone(spawnPoints)
	for i = #shuffled, 2, -1 do
		local j = State.rng:NextInteger(1, i)
		shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
	end
	for i = 1, math.min(cfg.lanternCount, #shuffled) do
		table.insert(activeLanterns, makeLantern(shuffled[i].Position))
	end
end

local function despawnLanterns()
	for _, entry in activeLanterns do
		entry.prompt:Destroy()
		entry.part:Destroy()
	end
	table.clear(activeLanterns)
end

local function onWeatherStart(w, _byPlayer: Player?)
	if w.id == cfg.weatherId and Events.active(cfg, Events.now()) then
		spawnLanterns()
	end
end

local function onWeatherStop(w)
	if w.id == cfg.weatherId then
		despawnLanterns()
	end
end

----------------------------------------------------------------------------------------------
-- Fog scheduler: fires once per interval-slot boundary on the UTC clock (:00/:20/:40, or every 10
-- min during Witching Hour), so multiple servers agree without any cross-server coordination.

local function fogScheduler()
	local lastSlot: number? = nil
	while true do
		task.wait(1)
		local now = Events.now()
		if Events.active(cfg, now) then
			local interval = Events.fogIntervalSeconds(cfg, now)
			local slot = now // interval
			if slot ~= lastSlot then
				lastSlot = slot
				WeatherService.start(cfg.weatherId)
			end
			ReplicatedStorage:SetAttribute("EventActive", true)
			ReplicatedStorage:SetAttribute("NextFogAt", (slot + 1) * interval)
		else
			lastSlot = nil
			ReplicatedStorage:SetAttribute("EventActive", false)
			ReplicatedStorage:SetAttribute("NextFogAt", 0)
		end
	end
end

----------------------------------------------------------------------------------------------
-- Lantern Stall (3 kiosks: Pumpkit, Gourdgeist, Haunted Greenhouse skin)

local kioskLabels: { [string]: TextLabel } = {}

local function stallBuyCount(session: State.Session, itemId: string): number
	local rec = session.data.event.stallBuys[itemId]
	if not rec or rec.day ~= utcDay(Events.now()) then
		return 0
	end
	return rec.n
end

local function stallRecordBuy(session: State.Session, itemId: string)
	local day = utcDay(Events.now())
	local rec = session.data.event.stallBuys[itemId]
	if not rec or rec.day ~= day then
		rec = { day = day, n = 0 }
		session.data.event.stallBuys[itemId] = rec
	end
	rec.n += 1
end

local function itemDisplayName(item): string
	if item.kind == "seed" then
		local species = Species.get(item.speciesId)
		return species and species.name or item.speciesId
	end
	return "Haunted Greenhouse"
end

local function buyStallItem(item, player: Player)
	local session = State.get(player)
	if not session then
		return
	end
	local now = Events.now()
	local funnelId = HttpService:GenerateGUID(false)
	Analytics.funnel(player, "EventShop", funnelId, 1, "Opened")

	if now >= cfg.endAt then
		State.notify(session, "Hollow Harvest is over. See you next year!", "#ffb070")
		return
	end
	if not Events.active(cfg, now) then
		State.notify(session, "The Lantern Stall opens with Hollow Harvest on 17 Oct.", "#ffb070")
		return
	end
	local part = Events.part(cfg, now)
	if part < item.fromPart then
		State.notify(session, itemDisplayName(item) .. " unlocks in Part 2 (24 Oct).", "#ffb070")
		return
	end

	if item.kind == "skin" and session.data.skins[item.skinId] then
		-- already owned: this kiosk becomes an equip/unequip toggle instead of a sale
		session.data.skin = if session.data.skin == item.skinId then "" else item.skinId
		session.player:SetAttribute("Skin", session.data.skin)
		fireSkinChange(session)
		State.notify(session, if session.data.skin == item.skinId then "Haunted Greenhouse skin equipped!" else "Haunted Greenhouse skin unequipped.", "#c9a0ff")
		return
	end

	if item.dailyCap and stallBuyCount(session, item.id) >= item.dailyCap then
		State.notify(session, itemDisplayName(item) .. " limit reached for today (" .. item.dailyCap .. "/day). Resets at 00:00 UTC.", "#ffb070")
		return
	end
	if session.data.event.berries < item.price then
		State.notify(session, "Not enough Moonberries for " .. itemDisplayName(item) .. " (" .. item.price .. ")", "#ff8080")
		return
	end

	session.data.event.berries -= item.price
	session.player:SetAttribute("Moonberries", session.data.event.berries)
	Analytics.sink(player, "EventShop:" .. item.id, item.price, session.data.event.berries, "Moonberries")
	stallRecordBuy(session, item.id)

	if item.kind == "seed" then
		-- M: limited seeds go straight to the seed inventory (never onto pads), same as
		-- ShopService.buySeed, so a full greenhouse/storage never blocks a stall purchase.
		State.addSeeds(session, item.speciesId, 1)
		State.notify(session, "Got a " .. itemDisplayName(item) .. " seed!", "#ffb347")
	else
		session.data.skins[item.skinId] = true
		session.data.skin = item.skinId
		session.player:SetAttribute("Skin", session.data.skin)
		fireSkinChange(session)
		State.notify(session, "Unlocked and equipped the Haunted Greenhouse skin!", "#c9a0ff")
	end
	Analytics.funnel(player, "EventShop", funnelId, 2, "Bought")
end

local function refreshStallLabels()
	local now = Events.now()
	for id, item in cfg.stall do
		local text = kioskLabels[id]
		if text then
			if now >= cfg.endAt then
				text.Text = "See you\nnext year!"
			elseif not Events.active(cfg, now) then
				text.Text = itemDisplayName(item) .. "\nopens 17 Oct"
			elseif Events.part(cfg, now) < item.fromPart then
				text.Text = itemDisplayName(item) .. "\nunlocks Part 2"
			else
				local capText = if item.dailyCap then (" (" .. item.dailyCap .. "/day)") else ""
				text.Text = itemDisplayName(item) .. "\n" .. item.price .. " berries" .. capText
			end
		end
	end
end

local function initStall(stallModel: Instance)
	local kiosks = stallModel:FindFirstChild("Kiosks")
	if not kiosks then
		warn("[EventService] Lantern Stall has no Kiosks folder; stall disabled")
		return
	end
	for _, kiosk in kiosks:GetChildren() do
		local itemId = kiosk:GetAttribute("Slot")
		local item = itemId and cfg.stall[itemId]
		if item then
			local prompt = Prompts.create(kiosk, "Buy " .. item.price .. " Moonberries", itemDisplayName(item))
			prompt.MaxActivationDistance = 8
			prompt.Triggered:Connect(function(player)
				buyStallItem(item, player)
			end)
			local gui = Instance.new("BillboardGui")
			gui.Name = "StallLabel"
			gui.Size = UDim2.fromOffset(150, 60)
			gui.StudsOffset = Vector3.new(0, 3.2, 0)
			gui.MaxDistance = 45
			gui.LightInfluence = 0
			gui.Parent = kiosk
			local text = Instance.new("TextLabel")
			text.Name = "Text"
			text.BackgroundTransparency = 1
			text.Size = UDim2.fromScale(1, 1)
			text.Font = Enum.Font.FredokaOne
			text.TextScaled = true
			text.TextStrokeTransparency = 0.3
			text.TextColor3 = Color3.fromRGB(255, 200, 120)
			text.Parent = gui
			kioskLabels[item.id] = text
		end
	end
	refreshStallLabels()
	task.spawn(function()
		while true do
			task.wait(5)
			refreshStallLabels()
		end
	end)
end

----------------------------------------------------------------------------------------------
-- join / end-of-event conversion

-- Called once per join, after PlotService.renderPads so State.income reflects this player's real
-- pads (the conversion rate is "5 min of current income").
function EventService.onJoin(session: State.Session)
	local player = session.player
	player:SetAttribute("Moonberries", session.data.event.berries)
	player:SetAttribute("Skin", session.data.skin or "")
	local now = Events.now()
	if now >= cfg.endAt and session.data.event.berries > 0 then
		local berries = session.data.event.berries
		-- spec: "1 [berry] = 5 min of income" -- each berry converts independently, not the whole
		-- balance at once (the worked example, 37 berries -> 12,400 Dew, only holds with `berries *`
		-- here; the first version of this line dropped it, so every player got the same flat
		-- ~5-minutes-of-income payout regardless of their balance).
		local dew = math.max(100, math.floor(berries * State.income(session) * 5 * 60))
		session.data.event.berries = 0
		player:SetAttribute("Moonberries", 0)
		State.addDew(session, dew, "Event:Conversion")
		State.notify(session, "Hollow Harvest is over! Your " .. berries .. " Moonberries became " .. Format.number(dew) .. " Dew.", "#ffb347")
	end
end

----------------------------------------------------------------------------------------------

function EventService.init(map: Instance)
	WeatherService.onStart(onWeatherStart)
	WeatherService.onStop(onWeatherStop)

	lanternFolder = Instance.new("Folder")
	lanternFolder.Name = "Lanterns"
	lanternFolder.Parent = workspace

	local island = map:FindFirstChild("Island")
	local spots = island and island:FindFirstChild("LanternSpawns")
	if spots then
		for _, child in spots:GetChildren() do
			if child:IsA("BasePart") then
				table.insert(spawnPoints, child)
			end
		end
	end
	if #spawnPoints == 0 then
		warn("[EventService] no LanternSpawn points found; Wisp Lanterns disabled")
	end

	local plaza = map:FindFirstChild("Plaza")
	local stallModel = plaza and plaza:FindFirstChild("Lantern Stall")
	if stallModel then
		initStall(stallModel)
	else
		warn("[EventService] no Lantern Stall found in the map; event shop disabled")
	end

	task.spawn(fogScheduler)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[-- Cross-server leaderboards: top lifetime Dew earners and each player's single rarest hatch.
-- Displayed on a physical board in the Plaza (near the Rebirth Shrine, see MapBuilder.luau).
--
-- The only spec for this feature is one line in
-- vault/Projects/Sproutling Isles - Launch & Live Ops.md ("Week 5": in-world leaderboards,
-- income and rarest hatch). Everything below is this engineer's design call, flagged for
-- game-designer/owner review:
--   - Uses OrderedDataStoreService so rankings are global across every server, matching how
--     the game already treats Dew and rebirths as server-independent progress.
--   - Income score = `data.totalDew` (lifetime Dew earned, already tracked by State.addDew).
--     Written on the same 5-minute batch/leave cadence as the income analytics Source event
--     (see init.server.luau's flushIncome), so this adds zero extra per-tick DataStore writes.
--   - Rarest-hatch score = rarityIndex * 1000 + species.order, using the exact same rarity and
--     species ordering Species.luau already defines elsewhere (Species.RarityOrder, .order).
--     Only written when a hatch beats the player's own previous best (session.data.bestHatch),
--     so a whole session of common hatches costs zero DataStore writes for that player.
--   - OrderedDataStore values must be plain numbers, so player names and (for the hatch board)
--     the species/rarity text live in a small companion plain DataStore, refreshed alongside
--     the score so they never go stale relative to it.
--   - The physical board refreshes every Config.LeaderboardRefreshSeconds by re-querying both
--     OrderedDataStores. An empty result (fresh deploy, no data anywhere yet) shows a
--     "be the first" message instead of erroring.

local DataStoreService = game:GetService("DataStoreService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)
local Format = require(Shared.Format)

local LeaderboardService = {}

local RARITY_INDEX: { [string]: number } = {}
for index, rarity in Species.RarityOrder do
	RARITY_INDEX[rarity] = index
end

local incomeStore: OrderedDataStore? = nil
local hatchStore: OrderedDataStore? = nil
local metaStore: GlobalDataStore? = nil

do
	local okIncome, income = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.DataStoreName .. "_LB_Income")
	end)
	local okHatch, hatch = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.DataStoreName .. "_LB_Hatch")
	end)
	local okMeta, meta = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName .. "_LB_Meta")
	end)
	if okIncome then
		incomeStore = income
	end
	if okHatch then
		hatchStore = hatch
	end
	if okMeta then
		metaStore = meta
	end
	if not (okIncome and okHatch and okMeta) then
		warn("[Sproutling] leaderboard DataStores unavailable, boards will stay empty:", income, hatch, meta)
	end
end

local incomeLabel: TextLabel? = nil
local hatchLabel: TextLabel? = nil

local function keyOf(player: Player): string
	return tostring(player.UserId)
end

-- Player name (and, for the hatch board, species/rarity text) kept alongside the OrderedDataStore
-- score. Fire-and-forget: a failed write here never blocks gameplay, and just leaves the board
-- showing the previous (or no) name until it succeeds another time.
local function setMeta(player: Player, patch: { [string]: any })
	if not metaStore then
		return
	end
	task.spawn(function()
		pcall(function()
			metaStore:UpdateAsync(keyOf(player), function(old)
				old = old or {}
				for k, v in patch do
					old[k] = v
				end
				return old
			end)
		end)
	end)
end

local function getMeta(key: string): { [string]: any }?
	if not metaStore then
		return nil
	end
	local ok, value = pcall(function()
		return metaStore:GetAsync(key)
	end)
	if ok then
		return value
	end
	return nil
end

-- Call on the same batched cadence as the income analytics Source event (never per-tick).
function LeaderboardService.reportIncome(player: Player, totalDew: number)
	if incomeStore then
		local score = math.floor(totalDew)
		task.spawn(function()
			pcall(function()
				(incomeStore :: OrderedDataStore):SetAsync(keyOf(player), score)
			end)
		end)
	end
	setMeta(player, { name = player.DisplayName })
end

-- Call right after a hatch. `session` is the player's State.Session; `species` is the just-hatched
-- Species row. Only writes to the DataStore when this beats the player's saved best.
function LeaderboardService.reportHatch(player: Player, session: any, species: any)
	local rarityIndex = RARITY_INDEX[species.rarity] or 0
	local order = species.order or 0
	local newScore = rarityIndex * 1000 + order
	local best = session.data.bestHatch
	local bestScore = (best and (best.rarityIndex * 1000 + best.order)) or 0
	if newScore <= bestScore then
		return
	end
	session.data.bestHatch = { rarityIndex = rarityIndex, order = order, species = species.id }
	if hatchStore then
		task.spawn(function()
			pcall(function()
				(hatchStore :: OrderedDataStore):SetAsync(keyOf(player), newScore)
			end)
		end)
	end
	setMeta(player, { name = player.DisplayName, hatchSpecies = species.name, hatchRarity = species.rarity })
end

----------------------------------------------------------------------------------------------
-- physical board display

local function fetchTop(store: OrderedDataStore?): { { key: string, value: number } }
	if not store then
		return {}
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, Config.LeaderboardSize)
	end)
	if not ok or not pages then
		return {}
	end
	local ok2, page = pcall(function()
		return (pages :: DataStorePages):GetCurrentPage()
	end)
	if not ok2 then
		return {}
	end
	return page or {}
end

local function render(label: TextLabel?, title: string, lines: { string })
	if not label then
		return
	end
	if #lines == 0 then
		label.Text = title .. "\n\nNo entries yet -\nbe the first!"
		return
	end
	local out = { title, "" }
	for _, line in lines do
		table.insert(out, line)
	end
	label.Text = table.concat(out, "\n")
end

function LeaderboardService.refresh()
	local incomeEntries = fetchTop(incomeStore)
	local incomeLines = {}
	for i, entry in incomeEntries do
		local meta = getMeta(entry.key)
		local name = (meta and meta.name) or ("Player " .. entry.key)
		table.insert(incomeLines, i .. ". " .. name .. " - " .. Format.number(entry.value) .. " Dew")
	end
	render(incomeLabel, "\240\159\143\134 TOP INCOME", incomeLines)

	local hatchEntries = fetchTop(hatchStore)
	local hatchLines = {}
	for i, entry in hatchEntries do
		local meta = getMeta(entry.key)
		local name = (meta and meta.name) or ("Player " .. entry.key)
		local species = (meta and meta.hatchSpecies) or "?"
		local rarity = (meta and meta.hatchRarity) or "?"
		table.insert(hatchLines, i .. ". " .. name .. " - " .. species .. " (" .. rarity .. ")")
	end
	render(hatchLabel, "\240\159\140\159 RAREST HATCH", hatchLines)
end

-- `map` is the built map (see MapBuilder.buildLeaderboards); missing parts (a stale bake from
-- before this feature) are handled gracefully so a republish is never required to avoid errors.
function LeaderboardService.init(map: Instance)
	local plaza = map:FindFirstChild("Plaza")
	local board = plaza and plaza:FindFirstChild("Leaderboards")
	local incomeBoard = board and board:FindFirstChild("IncomeBoard")
	local hatchBoard = board and board:FindFirstChild("RarityBoard")
	local incomeGui = incomeBoard and incomeBoard:FindFirstChild("Label")
	local hatchGui = hatchBoard and hatchBoard:FindFirstChild("Label")
	incomeLabel = incomeGui and (incomeGui:FindFirstChild("Text") :: TextLabel?)
	hatchLabel = hatchGui and (hatchGui:FindFirstChild("Text") :: TextLabel?)

	task.spawn(function()
		while true do
			LeaderboardService.refresh()
			task.wait(Config.LeaderboardRefreshSeconds)
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game pass ownership and developer product receipts.
-- Fill in the real IDs in ReplicatedStorage.Shared.Products once they exist on the Creator Dashboard.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared.Products)
local Config = require(Shared.Config)

local State = require(script.Parent.State)
local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local WeatherService = require(script.Parent.WeatherService)
local ShopService = require(script.Parent.ShopService)

local MonetizationService = {}

local MAX_RECEIPTS = 50

-- 3a step 11 "FirstPurchase": fires once, ever, for either a dev product grant or a game pass
-- purchase (whichever a player buys first).
local function markFirstPurchase(session: State.Session)
	if not session.data.onb.FirstPurchase then
		session.data.onb.FirstPurchase = true
		Analytics.onboarding(session.player, "FirstPurchase")
	end
end

local function applyPass(session: State.Session, key: string)
	if session.passes[key] then
		return
	end
	session.passes[key] = true
	session.player:SetAttribute("Pass_" .. key, true)
	if key == "BigGreenhouse" then
		PlotService.refillPads(session)
		PlotService.renderPads(session)
	elseif key == "VIP" then
		session.player:SetAttribute("VIP", true)
	end
	State.syncDew(session)
end

function MonetizationService.loadPasses(session: State.Session)
	local studioTest = RunService:IsStudio() and Config.StudioTestPasses
	for _, pass in Products.Passes do
		if studioTest then
			applyPass(session, pass.key)
		elseif pass.id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, session.player.UserId, pass.id)
			if ok and owns then
				applyPass(session, pass.key)
			end
		end
	end
end

-- Each handler returns true when the purchase was granted.
local handlers: { [string]: (State.Session) -> boolean } = {
	-- The store hides the Starter Pack once StarterBought is set, so a repeat can only come from an
	-- old/stale prompt. It then grants just the 5,000 Dew (the seeds stay one-time). Refusing repeats
	-- instead is an owner decision (QA m15).
	StarterPack = function(session)
		if not session.data.starterBought then
			session.data.starterBought = true
			session.player:SetAttribute("StarterBought", true)
			State.addSeeds(session, "mushroomph", 2)
		end
		State.addDew(session, 5_000, "IAP:StarterPack")
		return true
	end,
	DewSmall = function(session)
		State.addDew(session, math.max(500, State.income(session) * 15 * 60), "IAP:DewSmall")
		return true
	end,
	DewLarge = function(session)
		State.addDew(session, math.max(20_000, State.income(session) * 3 * 3600), "IAP:DewLarge")
		return true
	end,
	InstantGrow = function(session)
		local now = os.time()
		for _, plant in session.data.soil do
			plant.ready = math.min(plant.ready, now)
		end
		return true
	end,
	LuckBoost = function(session)
		session.luckUntil = math.max(session.luckUntil, os.time()) + 15 * 60
		session.data.luckUntil = session.luckUntil -- M5: saved, absolute Unix time, survives rejoin/hops
		session.player:SetAttribute("LuckUntil", session.luckUntil)
		return true
	end,
	RestockNow = function(session)
		ShopService.rollStock(session)
		return true
	end,
	SummonStarfall = function(session)
		WeatherService.start("starfall", session.player)
		return true
	end,
	SummonAurora = function(session)
		WeatherService.start("aurora", session.player)
		return true
	end,
}

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local session = player and State.get(player)
	local product = Products.ProductById[receipt.ProductId]
	if not session or not product then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receipts = session.data.receipts
	if table.find(receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- M5: in a live server a non-saving session (DataStore load failed) would lose the purchase on
	-- leave, so don't grant it; Roblox retries the receipt on a later join where saving works.
	-- In Studio without API access nothing ever saves: we grant in memory so products can be tested,
	-- and that grant is simply gone when the test stops (expected).
	if not session.persist and not RunService:IsStudio() then
		State.notify(session, "Saving is unavailable right now, so " .. product.name .. " will be delivered next time you join.", "#ffb070")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local handler = handlers[product.key]
	if not handler or not handler(session) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	markFirstPurchase(session)
	table.insert(receipts, receipt.PurchaseId)
	while #receipts > MAX_RECEIPTS do
		table.remove(receipts, 1)
	end
	State.notify(session, "Thanks for buying " .. product.name .. "!", "#ffe070")
	if session.persist and not DataService.save(player :: Player, session.data, false) then
		-- the grant is recorded in memory, so a retry will not double-grant it
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- 3b Store funnel step 4 only: steps 1-3 (StoreOpened/ItemViewed/PromptShown) need a new
	-- client->server remote (Net.StoreEvent) that doesn't exist yet, so there's no "store opened"
	-- step to anchor a shared session id to. A fresh GUID per purchase stands in for it.
	Analytics.funnel(player, "Store", HttpService:GenerateGUID(false), 4, "Purchased")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.init()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local session = State.get(player)
		if not purchased or not session then
			return
		end
		for _, pass in Products.Passes do
			if pass.id == passId then
				applyPass(session, pass.key)
				markFirstPurchase(session)
				State.notify(session, "You unlocked " .. pass.name .. "!", "#ffe070")
				-- 3b Store funnel step 4 (see processReceipt for why steps 1-3 are unwired)
				Analytics.funnel(player, "Store", HttpService:GenerateGUID(false), 4, "Purchased")
			end
		end
	end)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Creates the RemoteEvents the client talks through. Everything else is ProximityPrompts,
-- which the server validates itself.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function remote(name: string): RemoteEvent
	local event = Instance.new("RemoteEvent")
	event.Name = name
	event.Parent = folder
	return event
end

Net.Notify = remote("Notify") -- server -> client: (text, colorHex?)
Net.SelectSeed = remote("SelectSeed") -- client -> server: (speciesId)
Net.Effect = remote("Effect") -- server -> client: (kind, data) for hatch/snatch fanfare
Net.RedeemCode = remote("RedeemCode") -- client -> server: (code); reply is always a Notify toast

folder.Parent = ReplicatedStorage

function Net.notify(player: Player, text: string, color: string?)
	Net.Notify:FireClient(player, text, color)
end

function Net.announce(text: string, color: string?)
	Net.Notify:FireAllClients(text, color)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[-- Plot ownership, planting, hatching, display pads, selling from pads and the gate lock.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)
local SproutModel = require(Shared.SproutModel)
local Format = require(Shared.Format)
local MapBuilder = require(Shared.MapBuilder)

local Net = require(script.Parent.Net)
local State = require(script.Parent.State)
local Analytics = require(script.Parent.Analytics)
local Prompts = require(script.Parent.Prompts)
local WeatherService = require(script.Parent.WeatherService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local EventService = require(script.Parent.EventService)
local Events = require(Shared.Events)

local PlotService = {}

local MAX_STORAGE = 60
local SELL_CONFIRM_SECONDS = 5
local RARE_OR_BETTER = { Rare = true, Epic = true, Legendary = true, Mythic = true, Secret = true }
local ANNOUNCE_MUTATIONS = { starry = true, prismatic = true, golden = true }
local ANNOUNCE_RARITIES = { Legendary = true, Mythic = true, Secret = true }

local sellConfirmUntil: { [Player]: number } = {}

type PlotInfo = {
	model: Model,
	index: number,
	cx: number,
	cz: number,
	inward: number,
	owner: Player?,
	soilPrompts: { ProximityPrompt },
	sellPrompts: { ProximityPrompt },
	snatchPrompts: { ProximityPrompt },
	lockPrompt: ProximityPrompt,
	plantVisuals: { [number]: BasePart },
	padVisuals: { [number]: Model },
	accentColor: Color3, -- this plot's own colour (from the Border part), used to revert the skin
}

local plots: { PlotInfo } = {}
local plotByModel: { [Model]: PlotInfo } = {}

----------------------------------------------------------------------------------------------
-- geometry

local function worldPoint(info: PlotInfo, u: number, y: number, v: number): Vector3
	return Vector3.new(info.cx + info.inward * u, y, info.cz + v)
end

function PlotService.isInside(plot: Model, position: Vector3): boolean
	local info = plotByModel[plot]
	if not info then
		return false
	end
	local half = MapBuilder.PlotSize / 2
	return math.abs(position.X - info.cx) <= half and math.abs(position.Z - info.cz) <= half + 2
end

function PlotService.gateOutside(plot: Model): CFrame
	local info = plotByModel[plot]
	local pos = worldPoint(info, MapBuilder.PlotSize / 2 + 10, 4, 0)
	return CFrame.lookAt(pos, pos + Vector3.new(info.inward, 0, 0))
end

function PlotService.info(plot: Model): PlotInfo?
	return plotByModel[plot]
end

----------------------------------------------------------------------------------------------
-- visuals

-- MapBuilder labels are BillboardGui "Label" > TextLabel "Text".
local function labelOf(part: Instance?): TextLabel?
	local gui = part and part:FindFirstChild("Label")
	return gui and gui:FindFirstChild("Text") :: TextLabel?
end

local function setSign(info: PlotInfo)
	local label = labelOf(info.model:FindFirstChild("Sign"))
	if label then
		local colorName = info.model:GetAttribute("ColorName")
		label.Text = if info.owner then info.owner.DisplayName .. "'s Garden" else colorName .. " plot - unclaimed"
	end
end

local function clearPads(info: PlotInfo)
	for _, model in info.padVisuals do
		model:Destroy()
	end
	table.clear(info.padVisuals)
end

function PlotService.renderPads(session: State.Session)
	local plot = session.plot
	local info = plot and plotByModel[plot]
	if not info then
		return
	end
	clearPads(info)
	local capacity = State.padCapacity(session)
	local mult = State.multiplier(session)
	for pad = 1, 12 do
		local padPart = info.model.Pads:FindFirstChild("Pad" .. pad) :: BasePart
		padPart.Transparency = if pad <= capacity then 0 else 0.7
		local sprout = session.data.pads[tostring(pad)]
		info.sellPrompts[pad]:SetAttribute("Active", sprout ~= nil)
		if sprout then
			local species = Species.get(sprout.s)
			-- longer hold for Rare and better so they aren't sold by accident
			info.sellPrompts[pad].HoldDuration = if species and RARE_OR_BETTER[species.rarity] then 1 else 0.4
			local model = SproutModel.build(sprout, true)
			local top = padPart.Position + Vector3.new(0, padPart.Size.X / 2, 0)
			model:PivotTo(CFrame.lookAt(top, top + Vector3.new(info.inward, 0, 0)))
			local incomeLabel = model:FindFirstChild("Income", true) :: TextLabel?
			if incomeLabel then
				incomeLabel.Text = "+" .. Format.number(SproutModel.income(sprout) * mult) .. " Dew/s"
			end
			model.Parent = info.model
			info.padVisuals[pad] = model
			info.sellPrompts[pad].ObjectText = SproutModel.displayName(sprout)
			info.sellPrompts[pad].ActionText = "Sell for " .. Format.number(State.sellValue(sprout))
			info.snatchPrompts[pad].ObjectText = SproutModel.displayName(sprout) .. (species and (" (" .. species.rarity .. ")") or "")
		end
	end
	PlotService.refreshSnatchable(session)
	session.player:SetAttribute("Stored", #session.data.storage)
	State.syncDew(session)
end

-- Snatch prompts only show (for other players) on filled pads while the gate is open and the
-- owner's new-player shield has run out. The server re-checks all of this on trigger anyway.
function PlotService.refreshSnatchable(session: State.Session)
	local info = session.plot and plotByModel[session.plot]
	if not info then
		return
	end
	local open = not PlotService.isLocked(session) and session.shieldUntil <= os.time()
	for pad = 1, 12 do
		info.snatchPrompts[pad]:SetAttribute("Active", open and session.data.pads[tostring(pad)] ~= nil)
	end
end

local function plantVisual(info: PlotInfo, tile: number): BasePart
	local existing = info.plantVisuals[tile]
	if existing then
		return existing
	end
	local soil = info.model.Soil:FindFirstChild("Soil" .. tile) :: BasePart
	local bud = Instance.new("Part")
	bud.Name = "Plant"
	bud.Shape = Enum.PartType.Ball
	bud.Anchored = true
	bud.CanCollide = false
	bud.CanQuery = false
	bud.Material = Enum.Material.Grass
	bud.Position = soil.Position + Vector3.new(0, 1, 0)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.fromOffset(160, 40)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	gui.Parent = bud
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.3
	text.Parent = gui
	bud.Parent = info.model
	info.plantVisuals[tile] = bud
	return bud
end

local function updateSoil(info: PlotInfo, session: State.Session?)
	local now = os.time()
	for tile = 1, Config.SoilTilesPerPlot do
		local plant = session and session.data.soil[tostring(tile)]
		local prompt = info.soilPrompts[tile]
		if not plant then
			local visual = info.plantVisuals[tile]
			if visual then
				visual:Destroy()
				info.plantVisuals[tile] = nil
			end
			prompt.ActionText = "Plant seed"
			prompt:SetAttribute("Active", session ~= nil)
		else
			local species = Species.get(plant.s)
			local remaining = plant.ready - now
			local progress = math.clamp(1 - remaining / plant.total, 0, 1)
			local bud = plantVisual(info, tile)
			local size = 1 + progress * 3
			local soil = info.model.Soil:FindFirstChild("Soil" .. tile) :: BasePart
			bud.Size = Vector3.new(size, size, size)
			bud.Position = soil.Position + Vector3.new(0, 0.6 + size / 2, 0)
			bud.Color = species and species.leaf or Color3.new(0, 1, 0)
			local text = (bud :: any).Info.Text :: TextLabel
			if remaining <= 0 then
				bud.Material = Enum.Material.Neon
				text.Text = (species and species.name or "?") .. " - READY!"
				text.TextColor3 = Color3.fromRGB(255, 240, 120)
				prompt.ActionText = "Hatch!"
				prompt:SetAttribute("Active", true)
			else
				bud.Material = Enum.Material.Grass
				text.Text = (species and species.name or "?") .. " " .. Format.time(remaining)
				text.TextColor3 = Color3.new(1, 1, 1)
				prompt:SetAttribute("Active", false)
			end
		end
	end
end

----------------------------------------------------------------------------------------------
-- actions

-- Puts a Sproutling on the first free pad, or into storage. Returns false if everything is full.
-- `force` lets storage go past MAX_STORAGE (used when a stolen Sproutling comes home, so it is never deleted).
function PlotService.placeSprout(session: State.Session, sprout, force: boolean?): boolean
	for pad = 1, State.padCapacity(session) do
		if not session.data.pads[tostring(pad)] then
			session.data.pads[tostring(pad)] = sprout
			PlotService.renderPads(session)
			return true
		end
	end
	if #session.data.storage >= MAX_STORAGE and not force then
		return false
	end
	table.insert(session.data.storage, sprout)
	session.player:SetAttribute("Stored", #session.data.storage)
	return true
end

-- Moves the best stored Sproutlings onto any empty pads.
function PlotService.refillPads(session: State.Session)
	table.sort(session.data.storage, function(a, b)
		return SproutModel.income(a) > SproutModel.income(b)
	end)
	local changed = false
	for pad = 1, State.padCapacity(session) do
		if not session.data.pads[tostring(pad)] and #session.data.storage > 0 then
			session.data.pads[tostring(pad)] = table.remove(session.data.storage, 1)
			changed = true
		end
	end
	if changed then
		PlotService.renderPads(session)
	end
end

local function chooseSeed(session: State.Session): string?
	local selected = session.selectedSeed
	if selected and (session.data.seeds[selected] or 0) > 0 then
		return selected
	end
	for _, species in Species.List do
		if (session.data.seeds[species.id] or 0) > 0 then
			return species.id
		end
	end
	return nil
end

local function onSoil(info: PlotInfo, tile: number, player: Player)
	local session = State.get(player)
	if not session or info.owner ~= player then
		return
	end
	local key = tostring(tile)
	local plant = session.data.soil[key]
	if not plant then
		local seedId = chooseSeed(session)
		if not seedId then
			State.notify(session, "You have no seeds! Buy some at the Seed Shop or the Pollen Parade.", "#ffb070")
			-- 3d NoSeeds: a friction signal (this can mean a soft-lock); value is the Dew balance
			Analytics.custom(player, "NoSeeds", session.data.dew)
			return
		end
		local species = Species.get(seedId) :: Species.Species
		State.addSeeds(session, seedId, -1)
		session.data.soil[key] = { s = seedId, ready = os.time() + species.growSeconds, total = species.growSeconds }
		updateSoil(info, session)
		if not session.data.onb.FirstPlant then
			session.data.onb.FirstPlant = true
			Analytics.onboarding(player, "FirstPlant")
		end
	elseif plant.ready <= os.time() then
		local activeWeather = WeatherService.current()
		local wasWeather = activeWeather ~= nil
		local sprout = { s = plant.s, m = WeatherService.rollMutation(session), z = WeatherService.rollSize(), u = State.newUid() }
		if not PlotService.placeSprout(session, sprout) then
			State.notify(session, "Your greenhouse and storage are full! Sell some Sproutlings first.", "#ff8080")
			-- 3d StorageFull: a friction signal
			Analytics.custom(player, "StorageFull", 1)
			return
		end
		session.data.soil[key] = nil
		updateSoil(info, session)
		if not session.data.onb.FirstHatch then
			session.data.onb.FirstHatch = true
			Analytics.onboarding(player, "FirstHatch")
		end
		if wasWeather and not session.data.onb.FirstWeatherHatch then
			session.data.onb.FirstWeatherHatch = true
			Analytics.onboarding(player, "FirstWeatherHatch")
		end
		local species = Species.get(sprout.s) :: Species.Species
		LeaderboardService.reportHatch(player, session, species)
		WeatherService.registerHatch()
		-- 7. Hollow Harvest hatch bonus: +1 Moonberry per hatch during the event, +5 if this hatch
		-- came out Haunted (the event's own weather mutation, distinct from other mutations).
		if Events.active(Events.Halloween2026, Events.now()) then
			EventService.onHatch(player, sprout.m == "haunted")
		end
		-- 3d Hatch / HugeHatch. species order comes from Species.luau's load-order index.
		Analytics.custom(player, "Hatch", (species :: any).order, { species.rarity, sprout.m or "none", if activeWeather then activeWeather.id else "clear" })
		if sprout.z >= 2 then
			Analytics.custom(player, "HugeHatch", sprout.z, { species.rarity, sprout.m or "none" })
		end
		Net.Effect:FireClient(player, "Hatch", { name = SproutModel.displayName(sprout), rarity = species.rarity, mutation = sprout.m, size = sprout.z })
		-- only the exciting ones go server-wide (Dewy/Charged are common during weather)
		if (sprout.m and ANNOUNCE_MUTATIONS[sprout.m]) or sprout.z >= 2 or ANNOUNCE_RARITIES[species.rarity] then
			Net.announce(player.DisplayName .. " hatched a " .. SproutModel.displayName(sprout) .. "!", "#ffe070")
		end
	end
end

local function onSell(info: PlotInfo, pad: number, player: Player)
	local session = State.get(player)
	if not session or info.owner ~= player then
		return
	end
	local sprout = session.data.pads[tostring(pad)]
	if not sprout then
		return
	end
	session.data.pads[tostring(pad)] = nil
	local value = State.sellValue(sprout)
	State.addDew(session, value, "Sell:" .. sprout.s)
	if not session.data.onb.FirstSell then
		session.data.onb.FirstSell = true
		Analytics.onboarding(player, "FirstSell")
	end
	State.notify(session, "Sold " .. SproutModel.displayName(sprout) .. " for " .. Format.number(value) .. " Dew", "#a0ffa0")
	PlotService.renderPads(session)
	PlotService.refillPads(session)
end

function PlotService.sellStorage(session: State.Session)
	local total = 0
	for _, sprout in session.data.storage do
		total += State.sellValue(sprout)
	end
	local count = #session.data.storage
	if count == 0 then
		State.notify(session, "Nothing in storage. Sproutlings go to storage when your pads are full.")
		return
	end
	-- selling Rare+ Sproutlings needs a second trigger within a few seconds
	local rares = 0
	for _, sprout in session.data.storage do
		local species = Species.get(sprout.s)
		if species and RARE_OR_BETTER[species.rarity] then
			rares += 1
		end
	end
	local player = session.player
	if rares > 0 and (sellConfirmUntil[player] or 0) < os.clock() then
		sellConfirmUntil[player] = os.clock() + SELL_CONFIRM_SECONDS
		State.notify(session, "Storage has " .. rares .. " Rare or better Sproutling(s). Use the Sell Stand again within " .. SELL_CONFIRM_SECONDS .. "s to sell all " .. count .. ".", "#ffb070")
		return
	end
	sellConfirmUntil[player] = nil
	table.clear(session.data.storage)
	State.addDew(session, total, "SellStorage")
	if not session.data.onb.FirstSell then
		session.data.onb.FirstSell = true
		Analytics.onboarding(player, "FirstSell")
	end
	session.player:SetAttribute("Stored", 0)
	State.notify(session, "Sold " .. count .. " stored Sproutlings for " .. Format.number(total) .. " Dew", "#a0ffa0")
end

local function setGateVisual(info: PlotInfo, locked: boolean)
	local laser = info.model.Gate:FindFirstChild("Laser") :: BasePart
	laser.Transparency = if locked then 0.35 else 1
	local button = info.model.Gate:FindFirstChild("LockButton") :: BasePart
	button.Color = if locked then Color3.fromRGB(80, 220, 120) else Color3.fromRGB(255, 80, 80)
end

-- 3d GateLock's "had a thief nearby?" field: any other online player within roughly one plot's
-- width of this plot's centre, at the moment of locking. Not an exact definition from the spec
-- (there's no existing "nearby" concept to reuse); documented as an interpretation.
local NEARBY_THIEF_RADIUS = MapBuilder.PlotSize / 2 + 20

local function hasNearbyThief(info: PlotInfo, owner: Player): boolean
	for _, other in Players:GetPlayers() do
		if other ~= owner then
			local root = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(info.cx, 0, info.cz)).Magnitude <= NEARBY_THIEF_RADIUS then
				return true
			end
		end
	end
	return false
end

local function onLock(info: PlotInfo, player: Player)
	local session = State.get(player)
	if not session or info.owner ~= player then
		return
	end
	if PlotService.isLocked(session) then
		return -- already locked (prompt should be hidden; guards a stale client)
	end
	local seconds = if session.passes.SturdyGate then Config.LockSecondsWithPass else Config.LockSeconds
	session.lockUntil = os.time() + seconds
	Analytics.custom(player, "GateLock", seconds, { if hasNearbyThief(info, player) then "y" else "n" })
	if not session.data.onb.FirstGateLock then
		session.data.onb.FirstGateLock = true
		Analytics.onboarding(player, "FirstGateLock")
	end
	info.lockPrompt:SetAttribute("Active", false)
	PlotService.refreshSnatchable(session)
	setGateVisual(info, true)
	State.notify(session, "Gate locked for " .. seconds .. "s. Nobody can snatch from you!", "#80ff80")
end

function PlotService.isLocked(session: State.Session): boolean
	return session.lockUntil > os.time()
end

----------------------------------------------------------------------------------------------
-- Hollow Harvest plot skin (cosmetic only, per the spec: a recolor/swap of already-named parts,
-- same collision shape as unskinned -- so it can't hide Sproutlings or block thieves). Only the
-- "haunted" skin exists so far; a future event's skin would just add another branch here.

local SKIN_DEFAULT_ROOF = Color3.fromRGB(200, 240, 255)
local SKIN_DEFAULT_SIGN = Color3.fromRGB(250, 245, 230)
local SKIN_DEFAULT_SOIL = Color3.fromRGB(110, 75, 50)

local function applySkin(info: PlotInfo, skinId: string?)
	local haunted = skinId == "haunted"
	local greenhouse = info.model:FindFirstChild("Greenhouse")
	local roof = greenhouse and greenhouse:FindFirstChild("Roof") :: BasePart?
	if roof then
		roof.Color = if haunted then Color3.fromRGB(150, 90, 255) else SKIN_DEFAULT_ROOF
	end
	local gate = info.model:FindFirstChild("Gate")
	if gate then
		for _, child in gate:GetChildren() do
			if child.Name == "PillarCap" and child:IsA("BasePart") then
				child.Color = if haunted then Color3.fromRGB(255, 150, 40) else info.accentColor
			end
		end
	end
	local sign = info.model:FindFirstChild("Sign") :: BasePart?
	if sign then
		-- placeholder for the spec's "cobweb decal over the sign": no cobweb texture asset exists
		-- in this offline sandbox, so this is a colour tint stand-in (game-designer/art pass can
		-- swap in a real Decal later without touching this code path).
		sign.Color = if haunted then Color3.fromRGB(140, 100, 150) else SKIN_DEFAULT_SIGN
	end
	for tile = 1, Config.SoilTilesPerPlot do
		local soilPart = info.model.Soil:FindFirstChild("Soil" .. tile) :: BasePart?
		if soilPart then
			soilPart.Color = if haunted then Color3.fromRGB(90, 150, 90) else SKIN_DEFAULT_SOIL
			soilPart.Material = if haunted then Enum.Material.Neon else Enum.Material.Ground
		end
	end
end

-- Public so EventService's Lantern Stall equip/unequip toggle can re-apply it without EventService
-- needing to require PlotService back (see EventService.onSkinChange for the hook that calls this).
function PlotService.applySkin(session: State.Session)
	local info = session.plot and plotByModel[session.plot]
	if info then
		applySkin(info, session.data.skin)
	end
end

----------------------------------------------------------------------------------------------
-- ownership

function PlotService.claim(session: State.Session): boolean
	for _, info in plots do
		if not info.owner then
			info.owner = session.player
			session.plot = info.model
			local id = session.player.UserId
			info.model:SetAttribute("OwnerUserId", id)
			for _, prompt in info.soilPrompts do
				prompt:SetAttribute("OnlyUser", id)
			end
			for _, prompt in info.sellPrompts do
				prompt:SetAttribute("OnlyUser", id)
			end
			for _, prompt in info.snatchPrompts do
				-- everyone but the owner may see these (B1: OnlyUser must be cleared or nobody sees them)
				prompt:SetAttribute("OnlyUser", nil)
				prompt:SetAttribute("ExceptUser", id)
			end
			info.lockPrompt:SetAttribute("OnlyUser", id)
			info.lockPrompt:SetAttribute("Active", true)
			setSign(info)
			setGateVisual(info, false)
			applySkin(info, session.data.skin)
			session.player:SetAttribute("PlotColor", info.model:GetAttribute("ColorName"))
			PlotService.renderPads(session)
			PlotService.refillPads(session)
			updateSoil(info, session)
			if not session.data.onb.PlotClaimed then
				session.data.onb.PlotClaimed = true
				Analytics.onboarding(session.player, "PlotClaimed")
			end
			return true
		end
	end
	return false
end

function PlotService.release(session: State.Session)
	local info = session.plot and plotByModel[session.plot]
	if not info then
		return
	end
	info.owner = nil
	info.model:SetAttribute("OwnerUserId", 0)
	-- back to the same state init() leaves them in
	for _, list in { info.soilPrompts, info.sellPrompts } do
		for _, prompt in list do
			prompt:SetAttribute("OnlyUser", 0)
			prompt:SetAttribute("ExceptUser", nil)
			prompt:SetAttribute("Active", false)
		end
	end
	for _, prompt in info.snatchPrompts do
		prompt:SetAttribute("OnlyUser", nil)
		prompt:SetAttribute("ExceptUser", nil)
		prompt:SetAttribute("Active", false) -- hidden for everyone while unclaimed
	end
	info.lockPrompt:SetAttribute("OnlyUser", 0)
	info.lockPrompt:SetAttribute("Active", false)
	sellConfirmUntil[session.player] = nil
	clearPads(info)
	updateSoil(info, nil)
	setGateVisual(info, false)
	applySkin(info, nil) -- back to unskinned for the next claimant; the owner's skin re-applies on their next claim
	for pad = 9, 12 do
		(info.model.Pads:FindFirstChild("Pad" .. pad) :: BasePart).Transparency = 0.7
	end
	setSign(info)
	local lockLabel = labelOf(info.model.Gate.LockButton)
	if lockLabel then
		lockLabel.Text = "LOCK"
	end
	session.plot = nil
end

function PlotService.teleportHome(session: State.Session)
	local character = session.player.Character
	local plot = session.plot
	if not character or not plot then
		return
	end
	local spawnPoint = plot:FindFirstChild("SpawnPoint") :: BasePart
	character:PivotTo(spawnPoint.CFrame + Vector3.new(0, 3, 0))
end

----------------------------------------------------------------------------------------------

function PlotService.init(map: Instance)
	-- so the Lantern Stall's equip/unequip toggle can re-apply the skin without EventService
	-- requiring PlotService back (see PlotService.applySkin above)
	EventService.onSkinChange(PlotService.applySkin)

	for _, model in map.Plots:GetChildren() do
		local index = model:GetAttribute("Index")
		local cx, cz, inward = MapBuilder.plotPlacement(index)
		local info: PlotInfo = {
			model = model,
			index = index,
			cx = cx,
			cz = cz,
			inward = inward,
			owner = nil,
			soilPrompts = {},
			sellPrompts = {},
			snatchPrompts = {},
			lockPrompt = nil :: any,
			plantVisuals = {},
			padVisuals = {},
			accentColor = (model:FindFirstChild("Border") :: BasePart).Color,
		}
		for tile = 1, Config.SoilTilesPerPlot do
			local prompt = Prompts.create(model.Soil:FindFirstChild("Soil" .. tile), "Plant seed", "Soil")
			prompt:SetAttribute("OnlyUser", 0)
			prompt:SetAttribute("Active", false)
			prompt.Triggered:Connect(function(player)
				onSoil(info, tile, player)
			end)
			info.soilPrompts[tile] = prompt
		end
		for pad = 1, 12 do
			local padPart = model.Pads:FindFirstChild("Pad" .. pad)
			local sell = Prompts.create(padPart, "Sell", "", 0.4, Enum.KeyCode.F)
			sell:SetAttribute("OnlyUser", 0)
			sell:SetAttribute("Active", false)
			sell.Triggered:Connect(function(player)
				onSell(info, pad, player)
			end)
			info.sellPrompts[pad] = sell
			local snatch = Prompts.create(padPart, "Snatch!", "", Config.SnatchHoldSeconds)
			-- no OnlyUser here: Active=false hides it until an owner claims the plot (see claim())
			snatch:SetAttribute("Active", false)
			info.snatchPrompts[pad] = snatch
		end
		local lock = Prompts.create(model.Gate.LockButton, "Lock gate", "Gate")
		lock:SetAttribute("OnlyUser", 0)
		lock:SetAttribute("Active", false)
		lock.Triggered:Connect(function(player)
			onLock(info, player)
		end)
		info.lockPrompt = lock
		table.insert(plots, info)
		plotByModel[model] = info
	end
	table.sort(plots, function(a, b)
		return a.index < b.index
	end)

	-- 1 Hz: growth, weather speed-up, lock expiry
	task.spawn(function()
		while true do
			local dt = task.wait(1)
			local speed = WeatherService.growthSpeed()
			for _, info in plots do
				local session = info.owner and State.get(info.owner)
				if session then
					if speed > 1 then
						for _, plant in session.data.soil do
							plant.ready -= (speed - 1) * dt
						end
					end
					if session.lockUntil > 0 and session.lockUntil <= os.time() then
						session.lockUntil = 0
						setGateVisual(info, false)
						info.lockPrompt:SetAttribute("Active", true)
						PlotService.renderPads(session)
						State.notify(session, "Your gate is OPEN again. Go lock it!", "#ff9090")
					end
					if session.shieldUntil > 0 and session.shieldUntil <= os.time() then
						session.shieldUntil = 0
						session.player:SetAttribute("ShieldUntil", 0)
						PlotService.refreshSnatchable(session)
					end
					local lbl = labelOf(info.model.Gate.LockButton)
					if lbl then
						lbl.Text = if PlotService.isLocked(session) then "LOCKED " .. (session.lockUntil - os.time()) .. "s" else "OPEN - LOCK"
					end
				end
				updateSoil(info, session)
			end
		end
	end)

	-- 4 Hz: push intruders out of locked gardens
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, info in plots do
				local session = info.owner and State.get(info.owner)
				if session and PlotService.isLocked(session) then
					for _, other in Players:GetPlayers() do
						local root = other ~= info.owner and other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
						if root and PlotService.isInside(info.model, root.Position) then
							local otherSession = State.get(other)
							if otherSession then
								otherSession.serverMovedAt = os.clock() -- not a speed hack (see SnatchService)
								otherSession.serverMovedTo = PlotService.gateOutside(info.model).Position
							end
							other.Character:PivotTo(PlotService.gateOutside(info.model))
						end
					end
				end
			end
		end
	end)
end

function PlotService.snatchPrompt(plot: Model, pad: number): ProximityPrompt
	return plotByModel[plot].snatchPrompts[pad]
end

function PlotService.allPlots(): { PlotInfo }
	return plots
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">PondService</string>
          <string name="Source"><![CDATA[-- Wishing Pond (free casts) and the Sky Well (better loot, rebirth 1+).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)
local Format = require(Shared.Format)
local Events = require(Shared.Events)

local Net = require(script.Parent.Net)
local State = require(script.Parent.State)
local Analytics = require(script.Parent.Analytics)
local Prompts = require(script.Parent.Prompts)
local WeatherService = require(script.Parent.WeatherService)

local PondService = {}

-- Outcome weights (sum 100). "dew" currently pays 15-45 s of the player's income (min 25).
-- TODO(game-designer/owner, QA m10): the design intent was "minutes of income"; decide which is right.
local POND_TABLE = {
	{ kind = "dew", weight = 55 },
	{ kind = "seed", weight = 35, rarities = { Common = 80, Uncommon = 20 } },
	{ kind = "seed", weight = 8, rarities = { Rare = 75, Epic = 25 }, lucky = true },
	{ kind = "seed", weight = 1.8, rarities = { Legendary = 1 }, lucky = true },
	{ kind = "seed", weight = 0.18, rarities = { Mythic = 1 }, lucky = true },
	{ kind = "seed", weight = 0.02, rarities = { Secret = 1 }, lucky = true },
}

local SKY_TABLE = {
	{ kind = "dew", weight = 40 },
	{ kind = "seed", weight = 30, rarities = { Uncommon = 60, Rare = 40 } },
	{ kind = "seed", weight = 22, rarities = { Rare = 40, Epic = 60 }, lucky = true },
	{ kind = "seed", weight = 6, rarities = { Legendary = 1 }, lucky = true },
	{ kind = "seed", weight = 1.6, rarities = { Mythic = 1 }, lucky = true },
	{ kind = "seed", weight = 0.4, rarities = { Secret = 1 }, lucky = true },
}

local function roll(lootTable, luckyRod: boolean)
	local total = 0
	for _, entry in lootTable do
		total += entry.weight * (if luckyRod and entry.lucky then 2 else 1)
	end
	local r = State.rng:NextNumber() * total
	for _, entry in lootTable do
		r -= entry.weight * (if luckyRod and entry.lucky then 2 else 1)
		if r <= 0 then
			return entry
		end
	end
	return lootTable[1]
end

-- 6. Hollowisp is a bonus roll layered on top of the Wishing Pond's normal table (not folded into
-- the existing Mythic weight, which is shared with Moonpetal Wisp) so the tuned base odds don't
-- change: "Pond only" per the spec is read literally as the free Wishing Pond, not the Sky Well
-- (interpretation, not spelled out explicitly in the spec).
local function hollowispAvailable(): boolean
	local cfg = Events.Halloween2026
	local now = Events.now()
	if Events.part(cfg, now) < 2 or not Events.active(cfg, now) then
		return false
	end
	local w = WeatherService.current()
	return w ~= nil and w.id == cfg.weatherId
end

local function bobber(position: Vector3)
	local p = Instance.new("Part")
	p.Name = "Bobber"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(1.2, 1.2, 1.2)
	p.Anchored = true
	p.CanCollide = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 90, 90)
	p.Position = position
	p.Parent = workspace
	Debris:AddItem(p, Config.PondBiteSeconds + 0.5)
end

local function cast(player: Player, lootTable, where: Vector3, label: string)
	local session = State.get(player)
	if not session then
		return
	end
	local now = os.clock()
	if now < session.pondReadyAt then
		State.notify(session, "The water is still settling. Try again in " .. math.ceil(session.pondReadyAt - now) .. "s.", "#a0e0ff")
		return
	end
	session.pondReadyAt = now + Config.PondCooldownSeconds
	if not session.data.onb.FirstPondCast then
		session.data.onb.FirstPondCast = true
		Analytics.onboarding(player, "FirstPondCast")
	end
	bobber(where + Vector3.new((State.rng:NextNumber() - 0.5) * 20, 0, -8 - State.rng:NextNumber() * 20))
	State.notify(session, "You make a wish at the " .. label .. "...", "#a0e0ff")
	task.wait(Config.PondBiteSeconds)
	if not player.Parent then
		return
	end
	local luckyRod = session.passes.LuckyRod == true
	if lootTable == POND_TABLE and hollowispAvailable() then
		local chance = if luckyRod then 0.01 else 0.005
		if State.rng:NextNumber() < chance then
			State.addSeeds(session, "hollowisp", 1)
			State.notify(session, "You fished up a Hollowisp seed (Mythic)!", "#ffe070")
			Analytics.custom(player, "PondCatch", 1, { "seed", "Mythic", if luckyRod then "y" else "n" })
			Net.announce(player.DisplayName .. " fished a Mythic Hollowisp seed from the " .. label .. "!", "#ffe070")
			return
		end
	end
	local entry = roll(lootTable, luckyRod)
	if entry.kind == "dew" then
		local amount = math.max(25, State.income(session) * 30 * (0.5 + State.rng:NextNumber()))
		State.addDew(session, amount, "Pond")
		State.notify(session, "The " .. label .. " gave you " .. Format.number(amount) .. " Dew!", "#a0e0ff")
		Analytics.custom(player, "PondCatch", 1, { "dew", "none", if luckyRod then "y" else "n" })
	else
		local species = Species.rollByRarity(entry.rarities, State.rng)
		State.addSeeds(session, species.id, 1)
		State.notify(session, "You fished up a " .. species.name .. " seed (" .. species.rarity .. ")!", "#ffe070")
		Analytics.custom(player, "PondCatch", 1, { "seed", species.rarity, if luckyRod then "y" else "n" })
		if table.find({ "Legendary", "Mythic", "Secret" }, species.rarity) then
			Net.announce(player.DisplayName .. " fished a " .. species.rarity .. " " .. species.name .. " seed from the " .. label .. "!", "#ffe070")
		end
	end
end

function PondService.init(map: Instance)
	local pond = map.Pond
	for i = 1, 4 do
		local spot = pond:FindFirstChild("CastSpot" .. i) :: BasePart
		local prompt = Prompts.create(spot, "Cast (free)", "Wishing Pond")
		prompt.Triggered:Connect(function(player)
			cast(player, POND_TABLE, spot.Position, "Wishing Pond")
		end)
	end

	local well = map.SkyGarden:FindFirstChild("SkyWell") :: BasePart
	local wellPrompt = Prompts.create(well, "Make a wish", "Sky Well")
	wellPrompt.Triggered:Connect(function(player)
		local session = State.get(player)
		if session and session.data.rebirths >= 1 then
			cast(player, SKY_TABLE, well.Position + Vector3.new(0, 1, 12), "Sky Well")
		elseif session then
			State.notify(session, "The Sky Well only answers players who have rebirthed.", "#d0a0ff")
		end
	end)
end

return PondService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ProgressionService</string>
          <string name="Source"><![CDATA[-- Rebirth Shrine, Daily Gift streak and the Sky Garden launch pad.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)
local Format = require(Shared.Format)

local Net = require(script.Parent.Net)
local State = require(script.Parent.State)
local Analytics = require(script.Parent.Analytics)
local Prompts = require(script.Parent.Prompts)
local PlotService = require(script.Parent.PlotService)
local SnatchService = require(script.Parent.SnatchService)

local ProgressionService = {}

local DAILY_COOLDOWN = 20 * 3600

function ProgressionService.rebirthCost(session: State.Session): number
	return Config.RebirthBaseCost * Config.RebirthCostGrowth ^ session.data.rebirths
end

local function rebirth(player: Player)
	local session = State.get(player)
	if not session then
		return
	end
	if session.carrying then
		State.notify(session, "Finish your snatch first!")
		return
	end
	local cost = ProgressionService.rebirthCost(session)
	if session.data.dew < cost then
		State.notify(session, "Rebirth needs " .. Format.number(cost) .. " Dew. Keep growing!", "#ffb070")
		return
	end
	-- M3: Sproutlings being carried away from this player right now must not come back into the
	-- reborn garden. See SnatchService.forfeitCarriesFrom for why we void instead of refusing.
	SnatchService.forfeitCarriesFrom(player)
	local data = session.data
	-- 3b Rebirth funnel: same session id as step 1 "CanAfford" (fired in the income tick for this
	-- same tier), so Roblox can join the two steps into one funnel instance.
	local funnelSessionId = "rb" .. data.rebirths
	local dewBefore = data.dew
	data.rebirths += 1
	data.dew = Config.StartingDew
	if dewBefore > Config.StartingDew then
		-- 3c sink "Rebirth": the Dew reset isn't a plain State.spendDew (it's a hard reset to the
		-- starting amount, not a subtraction), so log it directly.
		Analytics.sink(player, "Rebirth", dewBefore - Config.StartingDew, data.dew)
	end
	-- 3d custom "Rebirth" (distinct from the sink above and the funnel step below)
	Analytics.custom(player, "Rebirth", data.rebirths)
	Analytics.funnel(player, "Rebirth", funnelSessionId, 2, "Rebirthed")
	data.seeds = table.clone(Config.StartingSeeds)
	data.soil = {}
	data.pads = {}
	data.storage = {}
	session.selectedSeed = nil
	State.syncAll(session)
	PlotService.renderPads(session)
	Net.announce(player.DisplayName .. " reached Rebirth " .. data.rebirths .. "! (+" .. math.floor(data.rebirths * Config.RebirthBonus * 100) .. "% Dew forever)", "#d0a0ff")
	Net.Effect:FireClient(player, "Rebirth", { rebirths = data.rebirths })
end

local function claimDaily(player: Player)
	local session = State.get(player)
	if not session then
		return
	end
	local data = session.data
	local now = os.time()
	local since = now - data.lastDaily
	if since < DAILY_COOLDOWN then
		State.notify(session, "Next gift in " .. Format.time(DAILY_COOLDOWN - since), "#ffb0d0")
		return
	end
	if since > Config.DailyResetHours * 3600 then
		data.streak = 0
	end
	data.streak += 1
	data.lastDaily = now
	local reward = Config.DailyRewards[(data.streak - 1) % #Config.DailyRewards + 1]
	local text
	if reward.seed then
		State.addSeeds(session, reward.seed, reward.count)
		local species = Species.get(reward.seed)
		text = reward.count .. "x " .. (species and species.name or reward.seed) .. " seed"
	else
		local amount = reward.dew * (1 + data.rebirths)
		State.addDew(session, amount, "Daily:" .. data.streak)
		text = Format.number(amount) .. " Dew"
	end
	if not data.onb.FirstDailyClaim then
		data.onb.FirstDailyClaim = true
		Analytics.onboarding(player, "FirstDailyClaim")
	end
	Analytics.custom(player, "DailyClaim", data.streak)
	player:SetAttribute("Streak", data.streak)
	player:SetAttribute("LastDaily", data.lastDaily)
	State.notify(session, "Day " .. data.streak .. " gift: " .. text .. "! Come back tomorrow to keep your streak.", "#ffb0d0")
end

function ProgressionService.init(map: Instance)
	local shrine = map.Plaza:FindFirstChild("Rebirth Shrine"):FindFirstChild("Anchor")
	local rebirthPrompt = Prompts.create(shrine, "Rebirth", "Rebirth Shrine", 1.5)
	rebirthPrompt.Triggered:Connect(rebirth)

	local gift = map.Plaza:FindFirstChild("Daily Gift"):FindFirstChild("Anchor")
	local giftPrompt = Prompts.create(gift, "Claim daily gift", "Daily Gift")
	giftPrompt.Triggered:Connect(claimDaily)

	-- Sky Garden: touching the launch pad flies you up if you have rebirthed at least once
	local sky = map.SkyGarden
	local landing = sky:FindFirstChild("Landing") :: BasePart
	local debounce: { [Player]: number } = {}
	local function touchPad(pad: BasePart, onTouch: (Player, Model) -> ())
		pad.Touched:Connect(function(hit)
			local character = hit.Parent
			local player = character and game:GetService("Players"):GetPlayerFromCharacter(character)
			if player and (debounce[player] or 0) < os.clock() then
				debounce[player] = os.clock() + 2
				onTouch(player, character)
			end
		end)
	end
	touchPad(sky:FindFirstChild("LaunchPad") :: BasePart, function(player, character)
		local session = State.get(player)
		if session and session.carrying then
			State.notify(session, "You can't fly while carrying a Sproutling!", "#ffb070")
		elseif session and session.data.rebirths >= 1 then
			session.serverMovedAt = os.clock()
			session.serverMovedTo = landing.Position
			character:PivotTo(landing.CFrame + Vector3.new(0, 4, 0))
		elseif session then
			State.notify(session, "The Sky Garden opens after your first Rebirth.", "#d0a0ff")
		end
	end)
	touchPad(sky:FindFirstChild("ReturnPad") :: BasePart, function(player, character)
		local session = State.get(player)
		if session then
			session.serverMovedAt = os.clock()
			session.serverMovedTo = Vector3.new(0, 5, 220)
		end
		character:PivotTo(CFrame.new(0, 5, 220))
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		debounce[player] = nil
	end)
end

return ProgressionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Prompts</string>
          <string name="Source"><![CDATA[-- ProximityPrompt factory. The server never toggles prompt.Enabled (that would fight the
-- client); instead it sets attributes the client uses to show/hide prompts per player:
--   Active    (bool)   - server-side state, e.g. soil has something to hatch
--   OnlyUser  (number) - only this UserId sees it (0 = nobody yet)
--   ExceptUser(number) - everyone except this UserId sees it
-- The server re-validates every trigger regardless.

local CollectionService = game:GetService("CollectionService")

local Prompts = {}

Prompts.Tag = "SIPrompt"

function Prompts.create(parent: Instance, action: string, object: string?, hold: number?, key: Enum.KeyCode?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object or ""
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	if key then
		prompt.KeyboardKeyCode = key
	end
	prompt:SetAttribute("Active", true)
	CollectionService:AddTag(prompt, Prompts.Tag)
	prompt.Parent = parent
	return prompt
end

return Prompts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Seed Shop kiosks with per-player timed restocks, the Sell Stand, and the Pollen Parade belt.

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)
local Format = require(Shared.Format)

local Net = require(script.Parent.Net)
local State = require(script.Parent.State)
local Analytics = require(script.Parent.Analytics)
local Prompts = require(script.Parent.Prompts)
local PlotService = require(script.Parent.PlotService)

local ShopService = {}

-- Total weight per rarity for the Pollen Parade (sums to 100).
local PARADE_WEIGHTS = {
	Common = 55,
	Uncommon = 27,
	Rare = 12,
	Epic = 4.5,
	Legendary = 1.3,
	Mythic = 0.17,
	Secret = 0.03,
}

----------------------------------------------------------------------------------------------
-- stock

-- Restocks happen on a global 5-minute clock so every player sees the same countdown.
function ShopService.nextRestockAt(): number
	local now = os.time()
	return now - (now % Config.RestockSeconds) + Config.RestockSeconds
end

function ShopService.rollStock(session: State.Session)
	local stock = {}
	for _, species in Species.ShopList do
		if State.rng:NextNumber() < species.stockChance then
			stock[species.id] = State.rng:NextInteger(species.stockRange[1], species.stockRange[2])
		else
			stock[species.id] = 0
		end
	end
	-- M4: stock is saved with the restock window it belongs to, so rejoining can't reroll it
	session.stock = stock
	session.data.stock = stock
	session.data.stockEpoch = ShopService.nextRestockAt()
	session.player:SetAttribute("Stock", HttpService:JSONEncode(stock))
end

-- On join: reuse the saved stock if it belongs to the current restock window, otherwise roll.
function ShopService.loadStock(session: State.Session)
	local saved = session.data.stock
	if type(saved) ~= "table" or session.data.stockEpoch ~= ShopService.nextRestockAt() then
		ShopService.rollStock(session)
		return
	end
	local stock = {}
	for _, species in Species.ShopList do
		local count = tonumber(saved[species.id]) or 0
		stock[species.id] = math.max(0, math.floor(count))
	end
	session.stock = stock
	session.data.stock = stock
	session.player:SetAttribute("Stock", HttpService:JSONEncode(stock))
end

local function buySeed(species: Species.Species, player: Player)
	local session = State.get(player)
	if not session then
		return
	end
	local left = session.stock[species.id] or 0
	if left <= 0 then
		State.notify(session, species.name .. " is sold out. Restock in " .. Format.time(ShopService.nextRestockAt() - os.time()), "#ffb070")
		return
	end
	if not State.spendDew(session, species.price, "Seed:" .. species.id) then
		State.notify(session, "Not enough Dew for " .. species.name .. " (" .. Format.number(species.price) .. ")", "#ff8080")
		return
	end
	if not session.data.onb.FirstSeedBought then
		session.data.onb.FirstSeedBought = true
		Analytics.onboarding(player, "FirstSeedBought")
	end
	session.stock[species.id] = left - 1
	player:SetAttribute("Stock", HttpService:JSONEncode(session.stock))
	State.addSeeds(session, species.id, 1)
	if not session.selectedSeed then
		session.selectedSeed = species.id
		player:SetAttribute("SelectedSeed", species.id)
	end
end

----------------------------------------------------------------------------------------------
-- parade

local function spawnParadeCrate(parade: Model)
	local species = Species.rollByRarity(PARADE_WEIGHTS, State.rng)
	local start = (parade:FindFirstChild("Start") :: BasePart).Position
	local finish = (parade:FindFirstChild("Finish") :: BasePart).Position

	local crate = Instance.new("Part")
	crate.Name = "Crate_" .. species.id
	crate.Size = Vector3.new(3.4, 3.4, 3.4)
	crate.Anchored = true
	crate.CanCollide = false
	crate.Material = Enum.Material.WoodPlanks
	crate.Color = Species.RarityColors[species.rarity]
	crate.CFrame = CFrame.new(start)
	local top = Instance.new("Part")
	top.Name = "Seed"
	top.Shape = Enum.PartType.Ball
	top.Size = Vector3.new(1.8, 1.8, 1.8)
	top.Anchored = true
	top.CanCollide = false
	top.Material = Enum.Material.Neon
	top.Color = species.leaf
	top.CFrame = crate.CFrame * CFrame.new(0, 2.4, 0)
	top.Parent = crate

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(180, 50)
	gui.StudsOffset = Vector3.new(0, 5, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Parent = crate
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.RichText = true
	text.TextStrokeTransparency = 0.3
	text.TextColor3 = Species.RarityColors[species.rarity]
	text.Text = species.name .. " seed\n" .. Format.number(species.price) .. " Dew"
	text.Parent = gui

	local prompt = Prompts.create(crate, "Buy " .. Format.number(species.price), species.name .. " seed (" .. species.rarity .. ")")
	prompt.MaxActivationDistance = 12
	local sold = false
	prompt.Triggered:Connect(function(player)
		local session = State.get(player)
		if sold or not session then
			return
		end
		if not State.spendDew(session, species.price, "Seed:" .. species.id) then
			State.notify(session, "Not enough Dew for " .. species.name .. " (" .. Format.number(species.price) .. ")", "#ff8080")
			return
		end
		sold = true
		if not session.data.onb.FirstSeedBought then
			session.data.onb.FirstSeedBought = true
			Analytics.onboarding(player, "FirstSeedBought")
		end
		State.addSeeds(session, species.id, 1)
		State.notify(session, "Got a " .. species.name .. " seed from the Pollen Parade!", "#ffe070")
		if table.find({ "Legendary", "Mythic", "Secret" }, species.rarity) then
			Net.announce(player.DisplayName .. " grabbed a " .. species.rarity .. " " .. species.name .. " seed from the Parade!", "#ffe070")
		end
		crate:Destroy()
	end)

	crate.Parent = parade:FindFirstChild("Items")
	if table.find({ "Legendary", "Mythic", "Secret" }, species.rarity) then
		Net.announce("A " .. species.rarity .. " " .. species.name .. " seed is riding the Pollen Parade!", "#ffe070")
	end

	local info = TweenInfo.new(Config.ParadeTravelSeconds, Enum.EasingStyle.Linear)
	local tween = TweenService:Create(crate, info, { CFrame = CFrame.new(finish) })
	TweenService:Create(top, info, { CFrame = CFrame.new(finish) * CFrame.new(0, 2.4, 0) }):Play()
	tween.Completed:Once(function()
		if crate.Parent then
			crate:Destroy()
		end
	end)
	tween:Play()
end

----------------------------------------------------------------------------------------------

function ShopService.init(map: Instance)
	local plaza = map.Plaza
	local shop = plaza:FindFirstChild("Seed Shop")
	for index, species in Species.ShopList do
		local kiosk = shop.Kiosks:FindFirstChild("Kiosk" .. index) :: BasePart
		kiosk:SetAttribute("Species", species.id)
		kiosk.Color = Species.RarityColors[species.rarity]
		local prompt = Prompts.create(kiosk, "Buy " .. Format.number(species.price), species.name .. " seed")
		prompt.MaxActivationDistance = 8
		prompt.Triggered:Connect(function(player)
			buySeed(species, player)
		end)
		-- the label text is filled in per player by the client from the "Stock" attribute
		local gui = Instance.new("BillboardGui")
		gui.Name = "StockLabel"
		gui.Size = UDim2.fromOffset(110, 60)
		gui.StudsOffset = Vector3.new(0, 3.2, 0)
		gui.MaxDistance = 45
		gui.LightInfluence = 0
		gui.Parent = kiosk
		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.BackgroundTransparency = 1
		text.Size = UDim2.fromScale(1, 1)
		text.Font = Enum.Font.FredokaOne
		text.TextScaled = true
		text.TextStrokeTransparency = 0.3
		text.TextColor3 = Species.RarityColors[species.rarity]
		text.Text = species.name .. "\n" .. Format.number(species.price)
		text.Parent = gui
	end

	local sellAnchor = plaza:FindFirstChild("Sell Stand"):FindFirstChild("Anchor")
	local sell = Prompts.create(sellAnchor, "Sell stored Sproutlings", "Sell Stand")
	sell.Triggered:Connect(function(player)
		local session = State.get(player)
		if session then
			PlotService.sellStorage(session)
		end
	end)

	ReplicatedStorage:SetAttribute("NextRestock", ShopService.nextRestockAt())
	task.spawn(function()
		local nextRestock = ShopService.nextRestockAt()
		while true do
			task.wait(1)
			if os.time() >= nextRestock then
				nextRestock = ShopService.nextRestockAt()
				ReplicatedStorage:SetAttribute("NextRestock", nextRestock)
				for _, session in State.sessions do
					ShopService.rollStock(session)
					State.notify(session, "The Seed Shop restocked!", "#a0ffa0")
				end
			end
		end
	end)

	local parade = map.Parade
	task.spawn(function()
		while true do
			spawnParadeCrate(parade)
			task.wait(Config.ParadeSpawnSeconds)
		end
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">SnatchService</string>
          <string name="Source"><![CDATA[-- Snatching: carry a rival's Sproutling home before time runs out or the owner bonks you.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)
local SproutModel = require(Shared.SproutModel)

local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)
local State = require(script.Parent.State)
local Analytics = require(script.Parent.Analytics)
local Prompts = require(script.Parent.Prompts)
local PlotService = require(script.Parent.PlotService)

local SnatchService = {}

type Carry = {
	sprout: any,
	victim: Player,
	pad: number,
	expiresAt: number,
	model: Model,
	bonkPrompt: ProximityPrompt,
	-- anti-cheat (see Config.CarryMaxSpeedFactor)
	lastPos: Vector3,
	lastClock: number,
	budget: number, -- studs of horizontal movement the thief may still make
	-- M3: set when the victim rebirths mid-carry. The victim's garden was wiped, so a failed carry
	-- does NOT return the Sproutling to them (it would survive the rebirth); it is simply lost.
	-- A successful carry still pays the thief. Either way exactly one copy exists: no dupe.
	forfeited: boolean,
	id: string, -- 3b Snatch funnel session id, one GUID per carry
	startedAt: number, -- os.clock() the carry began (3d SnatchResult's "seconds carried")
}

local function maxCarrySpeed(): number
	return Config.CarryWalkSpeed * Config.CarryMaxSpeedFactor
end

local function horizontal(v: Vector3): number
	return Vector3.new(v.X, 0, v.Z).Magnitude
end

-- Saves both players right after a Sproutling changes hands, so a crash can't leave it in both
-- profiles (m17). DataService serialises saves per player, so this can't clobber a newer write.
local function saveBoth(a: State.Session?, b: State.Session?)
	for _, session in { a, b } do
		if session and session.persist and not session.leaving then
			task.spawn(DataService.save, session.player, session.data, false)
		end
	end
end

local function restoreWalkSpeed(player: Player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = game:GetService("StarterPlayer").CharacterWalkSpeed
	end
end

-- Ends a carry. `success` hands the Sproutling to the thief, otherwise it goes back to the victim.
local function finish(thief: Player, success: boolean, reason: string?)
	local thiefSession = State.get(thief)
	local carry: Carry? = thiefSession and thiefSession.carrying
	if not thiefSession or not carry then
		return
	end
	thiefSession.carrying = nil
	thief:SetAttribute("Carrying", nil)
	carry.model:Destroy()
	carry.bonkPrompt:Destroy()
	restoreWalkSpeed(thief)

	-- 3d SnatchResult: fires exactly once per carry (guarded by `reported`) with a low-cardinality
	-- result bucket. The spec's fixed list is success/bonked/fell/timeout/full; "other" covers edge
	-- cases it doesn't name (moved too fast, the thief vanished, either player left).
	local secondsCarried = os.clock() - carry.startedAt
	local carrySpecies = Species.get(carry.sprout.s)
	local carryRarity = carrySpecies and carrySpecies.rarity or "unknown"
	local reported = false
	local function reportResult(result: string)
		if not reported then
			reported = true
			Analytics.custom(thief, "SnatchResult", secondsCarried, { result, carryRarity })
		end
	end

	local victimSession = State.get(carry.victim)
	if success then
		if PlotService.placeSprout(thiefSession, carry.sprout) then
			Net.announce(thief.DisplayName .. " snatched " .. carry.victim.DisplayName .. "'s " .. SproutModel.displayName(carry.sprout) .. "!", "#ff9a5a")
			Net.Effect:FireClient(thief, "SnatchSuccess", { name = SproutModel.displayName(carry.sprout) })
			if victimSession and not carry.forfeited then
				PlotService.refillPads(victimSession) -- m4: fill the emptied pad from storage
			end
			saveBoth(thiefSession, victimSession)
			Analytics.funnel(thief, "Snatch", carry.id, 2, "ReachedHome")
			reportResult("success")
			return
		end
		State.notify(thiefSession, "Your garden is full, so the Sproutling ran home!", "#ff8080")
		reportResult("full")
	end

	if carry.forfeited then
		-- the victim rebirthed mid-carry (see Carry.forfeited)
		State.notify(thiefSession, "Snatch failed" .. (reason and (": " .. reason) or "") .. ". The Sproutling faded away.", "#ff8080")
		reportResult("other")
		return
	end

	if victimSession then
		local key = tostring(carry.pad)
		if not victimSession.data.pads[key] then
			victimSession.data.pads[key] = carry.sprout
			PlotService.renderPads(victimSession)
		else
			PlotService.placeSprout(victimSession, carry.sprout, true) -- force: never delete a returned Sproutling
		end
		State.notify(victimSession, "Your " .. SproutModel.displayName(carry.sprout) .. " came back" .. (reason and (" (" .. reason .. ")") or "") .. "!", "#80ff80")
	end
	State.notify(thiefSession, "Snatch failed" .. (reason and (": " .. reason) or ""), "#ff8080")
	reportResult(
		if reason and reason:match("^bonked") then "bonked"
		elseif reason == "the thief fell" or reason == "the thief vanished" then "fell"
		elseif reason == "too slow" then "timeout"
		else "other"
	)
end

local function onSnatch(plot: Model, pad: number, thief: Player, prompt: ProximityPrompt)
	local thiefSession = State.get(thief)
	local ownerId = plot:GetAttribute("OwnerUserId")
	local victim = ownerId and Players:GetPlayerByUserId(ownerId)
	local victimSession = victim and State.get(victim)
	if not thiefSession or not victimSession or victim == thief or not thiefSession.plot then
		return
	end
	local now = os.time()
	if thiefSession.carrying then
		State.notify(thiefSession, "You're already carrying one!")
		return
	elseif now < thiefSession.snatchReadyAt then
		State.notify(thiefSession, "Catch your breath! Snatch again in " .. (thiefSession.snatchReadyAt - now) .. "s")
		return
	elseif PlotService.isLocked(victimSession) then
		State.notify(thiefSession, "That gate is locked!")
		return
	elseif victimSession.shieldUntil > now then
		State.notify(thiefSession, victim.DisplayName .. " is new here and shielded for a bit.")
		return
	end
	local character = thief.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	-- M1: the thief must really be at the pad (don't trust the client or engine-side prompt range checks)
	local pads = plot:FindFirstChild("Pads")
	local padPart = pads and pads:FindFirstChild("Pad" .. pad) :: BasePart?
	if not padPart or (root.Position - padPart.Position).Magnitude > prompt.MaxActivationDistance + Config.SnatchReachSlack then
		return
	end
	local key = tostring(pad)
	local sprout = victimSession.data.pads[key]
	if not sprout then
		return
	end
	local species = Species.get(sprout.s)
	local rarity = species and species.rarity or "unknown"

	victimSession.data.pads[key] = nil
	PlotService.renderPads(victimSession)
	-- 3d SnatchVictimLeft: checked in init.server.luau's onPlayerRemoving within 120s of this
	victimSession.lastStolenAt = os.time()
	victimSession.lastStolenRarity = rarity

	local model = SproutModel.build(sprout, true)
	SproutModel.weldTo(model, root, CFrame.new(0, 4.5, 0))
	model.Parent = character

	-- M2: own key (R / gamepad Y) and AlwaysShow, so the victim's E soil prompts never hide it
	local bonk = Prompts.create(root, "Bonk thief!", thief.DisplayName, 0, Enum.KeyCode.R)
	bonk.GamepadKeyCode = Enum.KeyCode.ButtonY
	bonk.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	bonk.MaxActivationDistance = 14
	bonk:SetAttribute("OnlyUser", victim.UserId)
	bonk.Triggered:Connect(function(player)
		if player == victim then
			finish(thief, false, "bonked by " .. victim.DisplayName)
		end
	end)

	local carryId = HttpService:GenerateGUID(false)
	thiefSession.carrying = {
		sprout = sprout,
		victim = victim,
		pad = pad,
		expiresAt = os.clock() + Config.SnatchCarrySeconds,
		model = model,
		bonkPrompt = bonk,
		lastPos = root.Position,
		lastClock = os.clock(),
		budget = maxCarrySpeed() * Config.CarryBurstSeconds,
		forfeited = false,
		id = carryId,
		startedAt = os.clock(),
	} :: Carry
	Analytics.funnel(thief, "Snatch", carryId, 1, "Grabbed")
	Analytics.custom(thief, "SnatchStart", 1, { rarity, if victimSession.passes.SturdyGate then "y" else "n" })
	thiefSession.snatchReadyAt = now + Config.SnatchCooldownSeconds
	thiefSession.shieldUntil = 0 -- snatching gives up your own new-player shield
	thiefSession.data.shieldForfeited = true -- m7: for good, not just until you rejoin
	thief:SetAttribute("ShieldUntil", 0)
	thief:SetAttribute("Carrying", SproutModel.displayName(sprout))
	thief:SetAttribute("CarryEndsAt", workspace:GetServerTimeNow() + Config.SnatchCarrySeconds)
	humanoid.WalkSpeed = Config.CarryWalkSpeed

	State.notify(thiefSession, "Run home! " .. Config.SnatchCarrySeconds .. "s to reach your garden.", "#ffd060")
	State.notify(victimSession, thief.DisplayName .. " is stealing your " .. SproutModel.displayName(sprout) .. "! Catch them and BONK!", "#ff5050")
	Net.Effect:FireClient(victim, "Stolen", { thief = thief.DisplayName })

	humanoid.Died:Once(function()
		finish(thief, false, "the thief fell")
	end)
end

function SnatchService.onLeaving(player: Player)
	local session = State.get(player)
	if session and session.carrying then
		finish(player, false, "the thief left")
	end
	-- anything stolen FROM this player is still mid-carry: send it back to them first so it is saved
	for _, other in State.sessions do
		local carry = other.carrying
		if carry and carry.victim == player then
			finish(other.player, false, "owner left")
		end
	end
end

-- M3: called by the Rebirth Shrine before it wipes `victim`'s garden. Carries of their Sproutlings
-- keep going (the thief can still win them), but a failed carry no longer returns the Sproutling
-- to the reborn garden. We void rather than refuse the rebirth so a thief can't block it.
function SnatchService.forfeitCarriesFrom(victim: Player)
	for _, other in State.sessions do
		local carry = other.carrying
		if carry and carry.victim == victim then
			carry.forfeited = true
		end
	end
end

-- M1: token-bucket speed check. Returns false if the thief moved faster than allowed.
local function movedLegally(session: State.Session, carry: Carry, position: Vector3): boolean
	local now = os.clock()
	local dt = now - carry.lastClock
	carry.lastClock = now
	local moved = horizontal(position - carry.lastPos)
	-- A server teleport (e.g. pushed out of a locked garden) is free. For ~1 s after it, measure from
	-- whichever is closer, the old position or the teleport target, since the client may briefly
	-- report either while it catches up. Jumping somewhere else in that window is still charged.
	local movedTo = session.serverMovedTo
	if movedTo and session.serverMovedAt and now - session.serverMovedAt < 1 then
		moved = math.min(moved, horizontal(position - movedTo))
	end
	carry.lastPos = position
	local speed = maxCarrySpeed()
	carry.budget = math.min(carry.budget + speed * dt, speed * Config.CarryBurstSeconds) - moved
	return carry.budget >= 0
end

function SnatchService.init()
	for _, info in PlotService.allPlots() do
		for pad, prompt in info.snatchPrompts do
			prompt.Triggered:Connect(function(player)
				onSnatch(info.model, pad, player, prompt)
			end)
		end
	end

	task.spawn(function()
		while true do
			task.wait(0.2)
			for player, session in State.sessions do
				local carry = session.carrying
				if carry then
					local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if not root then
						finish(player, false, "the thief vanished")
					elseif not movedLegally(session, carry, root.Position) then
						warn("[Sproutling] carry speed check failed for", player.Name)
						finish(player, false, "moved too fast")
					elseif session.plot and PlotService.isInside(session.plot, root.Position) then
						finish(player, true)
					elseif os.clock() > carry.expiresAt then
						finish(player, false, "too slow")
					end
				end
			end
		end
	end)
end

return SnatchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">State</string>
          <string name="Source"><![CDATA[-- In-memory session for each player plus the shared economy helpers every service uses.

local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Species = require(Shared.Species)
local SproutModel = require(Shared.SproutModel)
local Format = require(Shared.Format)

local Net = require(script.Parent.Net)
local Analytics = require(script.Parent.Analytics)

export type Session = {
	player: Player,
	data: { [string]: any },
	persist: boolean,
	plot: Model?,
	selectedSeed: string?,
	stock: { [string]: number },
	lockUntil: number,
	shieldUntil: number,
	carrying: any?, -- set by SnatchService while this player carries a stolen Sproutling
	snatchReadyAt: number,
	luckUntil: number,
	pondReadyAt: number,
	passes: { [string]: boolean },
	joinedAt: number,
	dewRemainder: number,
	leaving: boolean?, -- set once the player starts leaving; stops autosaves and double saves
	serverMovedAt: number?, -- os.clock() of the last server teleport of this player's character
	serverMovedTo: Vector3?, -- where that teleport put them (the carry speed check measures from here too)
	incomeSinceLog: number?, -- Dew earned from the income tick since the last batched analytics Source event
	rebirthCanAffordTier: number?, -- 3b Rebirth funnel: last rebirths tier "CanAfford" already fired for
	lastStolenAt: number?, -- os.time() this player was last snatched from (3d SnatchVictimLeft, 120s window)
	lastStolenRarity: string?, -- rarity of the Sproutling taken in that snatch
	codeReadyAt: number?, -- os.clock() a Codes redemption attempt is next allowed (CodesService anti-spam)
}

local State = {}
State.sessions = {} :: { [Player]: Session }
State.rng = Random.new()

function State.get(player: Player): Session?
	return State.sessions[player]
end

function State.multiplier(session: Session): number
	local m = 1 + session.data.rebirths * Config.RebirthBonus
	if session.passes.DoubleDew then
		m *= 2
	end
	if session.passes.VIP then
		m *= 1.1
	end
	return m
end

function State.padCapacity(session: Session): number
	return Config.BasePads + (if session.passes.BigGreenhouse then Config.BonusPadsPass else 0)
end

function State.income(session: Session): number
	local total = 0
	local capacity = State.padCapacity(session)
	for key, sprout in session.data.pads do
		-- pads above capacity (e.g. a refunded Big Greenhouse pass) don't earn
		local pad = tonumber(key)
		if pad and pad <= capacity then
			total += SproutModel.income(sprout)
		end
	end
	return total * State.multiplier(session)
end

function State.sellValue(sprout): number
	local species = Species.get(sprout.s)
	if not species then
		return 0
	end
	local base = SproutModel.income(sprout) / species.dewPerSecond -- mutation * size
	return math.floor(species.price * Config.SellRatio * base)
end

function State.newUid(): string
	return string.sub(HttpService:GenerateGUID(false), 1, 8)
end

----------------------------------------------------------------------------------------------
-- replication to the client (attributes + leaderstats + Seeds folder)

function State.syncDew(session: Session)
	local player = session.player
	player:SetAttribute("Dew", session.data.dew)
	player:SetAttribute("Income", State.income(session))
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		(stats :: any).Dew.Value = Format.number(session.data.dew)
		;(stats :: any).Rebirths.Value = session.data.rebirths
	end
end

function State.syncSeeds(session: Session)
	local folder = session.player:FindFirstChild("Seeds")
	if not folder then
		return
	end
	for _, species in Species.List do
		local value = folder:FindFirstChild(species.id) :: IntValue?
		local count = session.data.seeds[species.id] or 0
		if count > 0 and not value then
			local v = Instance.new("IntValue")
			v.Name = species.id
			v.Value = count
			v.Parent = folder
		elseif value then
			if count > 0 then
				value.Value = count
			else
				value:Destroy()
			end
		end
	end
end

function State.syncAll(session: Session)
	local player = session.player
	State.syncDew(session)
	State.syncSeeds(session)
	player:SetAttribute("Rebirths", session.data.rebirths)
	player:SetAttribute("RebirthCost", Config.RebirthBaseCost * Config.RebirthCostGrowth ^ session.data.rebirths)
	player:SetAttribute("SelectedSeed", session.selectedSeed or "")
	player:SetAttribute("ShieldUntil", session.shieldUntil)
	player:SetAttribute("LuckUntil", session.luckUntil)
	player:SetAttribute("Streak", session.data.streak)
	player:SetAttribute("LastDaily", session.data.lastDaily)
	player:SetAttribute("StarterBought", session.data.starterBought)
	player:SetAttribute("Stored", #session.data.storage)
	player:SetAttribute("Stock", HttpService:JSONEncode(session.stock))
	for key, owned in session.passes do
		player:SetAttribute("Pass_" .. key, owned)
	end
end

----------------------------------------------------------------------------------------------
-- economy

-- `reason` is the analytics economy sku (e.g. "Sell:mossbun", "Daily:3"); pass nil to skip logging
-- (used by the per-second income tick, which batches its own Source event instead -- see
-- init.server.luau -- so we don't blow the per-server analytics rate limit).
function State.addDew(session: Session, amount: number, reason: string?)
	amount = math.floor(amount)
	session.data.dew += amount
	if amount > 0 then
		session.data.totalDew += amount
	end
	State.syncDew(session)
	if reason then
		Analytics.source(session.player, reason, amount, session.data.dew)
	end
end

function State.spendDew(session: Session, amount: number, reason: string?): boolean
	if session.data.dew < amount then
		return false
	end
	session.data.dew -= amount
	State.syncDew(session)
	if reason then
		Analytics.sink(session.player, reason, amount, session.data.dew)
	end
	return true
end

function State.addSeeds(session: Session, speciesId: string, count: number)
	session.data.seeds[speciesId] = (session.data.seeds[speciesId] or 0) + count
	if session.data.seeds[speciesId] <= 0 then
		session.data.seeds[speciesId] = nil
	end
	State.syncSeeds(session)
end

function State.notify(session: Session, text: string, color: string?)
	Net.notify(session.player, text, color)
end

return State
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">WeatherService</string>
          <string name="Source"><![CDATA[-- Natural weather cycle, Robux-summoned weather, sky tinting and mutation rolls.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Weather = require(Shared.Weather)
local Ambience = require(Shared.Ambience)

local Net = require(script.Parent.Net)
local State = require(script.Parent.State)
local Analytics = require(script.Parent.Analytics)

local WeatherService = {}

local current: Weather.WeatherType? = nil
local endsAt = 0
-- Captured in init(), after the server bootstrap has applied Ambience to Lighting.
local defaultAmbient = Lighting.OutdoorAmbient
local defaultFog = Lighting.FogColor
-- 3d WeatherStart / WeatherSummonHatches
local summonedBy: Player? = nil -- set by start()'s byPlayer arg; nil for natural weather
local hatchesThisWeather = 0 -- reset every start(), read (and only reported) at stop() if summoned

-- Hollow Harvest hook: lets EventService spawn/despawn Wisp Lanterns on Spooky Fog start/stop
-- without WeatherService needing to require EventService (that would be circular, since PlotService
-- requires EventService for the hatch Moonberry grant). Called only on a *fresh* start/stop, never
-- on a stacking extension, so a Robux summon during a scheduled Fog can't spawn a second wave.
local startCallbacks: { (Weather.WeatherType, Player?) -> () } = {}
local stopCallbacks: { (Weather.WeatherType) -> () } = {}

function WeatherService.onStart(fn: (Weather.WeatherType, Player?) -> ())
	table.insert(startCallbacks, fn)
end

function WeatherService.onStop(fn: (Weather.WeatherType) -> ())
	table.insert(stopCallbacks, fn)
end

local function fireStart(w: Weather.WeatherType, byPlayer: Player?)
	for _, fn in startCallbacks do
		local ok, err = pcall(fn, w, byPlayer)
		if not ok then
			warn("[WeatherService] onStart callback failed:", err)
		end
	end
end

local function fireStop(w: Weather.WeatherType)
	for _, fn in stopCallbacks do
		local ok, err = pcall(fn, w)
		if not ok then
			warn("[WeatherService] onStop callback failed:", err)
		end
	end
end

local function tweenSky(color: Color3?, thick: boolean?)
	local goal = if color
		then { OutdoorAmbient = color, FogColor = color, FogEnd = 900 }
		else { OutdoorAmbient = defaultAmbient, FogColor = defaultFog, FogEnd = 100000 }
	TweenService:Create(Lighting, TweenInfo.new(4), goal):Play()
	-- With an Atmosphere present Roblox ignores Fog*, so tint the Atmosphere too.
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		local atmosphereGoal = if color then Ambience.weatherAtmosphere(color, thick == true) else Ambience.clearAtmosphere()
		TweenService:Create(atmosphere, TweenInfo.new(4), atmosphereGoal):Play()
	end
end

function WeatherService.current(): Weather.WeatherType?
	if current and os.clock() < endsAt then
		return current
	end
	return nil
end

function WeatherService.growthSpeed(): number
	local w = WeatherService.current()
	return if w then w.growthSpeed else 1
end

function WeatherService.start(id: string, byPlayer: Player?)
	local w = Weather.Types[id]
	if not w then
		return
	end
	-- stacking the same weather extends it; a different one replaces it
	local fresh = true
	if current == w and os.clock() < endsAt then
		endsAt += Config.WeatherDurationSeconds
		fresh = false
	else
		-- Hollow Harvest edge case: a different weather (e.g. a Robux Aurora) summoned mid-Fog
		-- replaces it outright, without going through stop()'s natural end-of-timer path. Fire the
		-- stop hooks for the outgoing weather here so EventService can despawn its lanterns, and
		-- call out the swap distinctly from the incoming weather's own announce.
		if current and current ~= w then
			local outgoing = current
			fireStop(outgoing)
			if outgoing.id == "spookyfog" then
				Net.announce("The " .. w.name .. " burned away the fog!", "#b4a0ff")
			end
		end
		current = w
		endsAt = os.clock() + Config.WeatherDurationSeconds
	end
	summonedBy = byPlayer
	hatchesThisWeather = 0
	ReplicatedStorage:SetAttribute("Weather", w.id)
	ReplicatedStorage:SetAttribute("WeatherEndsIn", endsAt - os.clock())
	tweenSky(w.sky, w.id == "spookyfog")
	local text = w.announce
	if byPlayer then
		text = byPlayer.DisplayName .. " summoned " .. w.name .. "! " .. text
	end
	Net.announce(text, "#b4a0ff")
	-- 3d WeatherStart: LogCustomEvent needs a player. A summon attributes to the summoner; natural
	-- weather has no player to anchor it to, so it's logged against any online player as a
	-- representative sample (documented interpretation, not in the spec).
	local target = byPlayer or Players:GetPlayers()[1]
	if target then
		Analytics.custom(target, "WeatherStart", 1, { w.id, if byPlayer then "summon" else "natural" })
	end
	if fresh then
		fireStart(w, byPlayer)
	end
end

-- 3d hook: PlotService calls this whenever a Sproutling hatches, so the counter below can prove
-- summoned weather (Robux purchases) benefits everyone on the server, not just the buyer.
function WeatherService.registerHatch()
	if WeatherService.current() then
		hatchesThisWeather += 1
	end
end

local function stop()
	local weatherId = if current then current.id else "clear"
	if summonedBy then
		Analytics.custom(summonedBy, "WeatherSummonHatches", hatchesThisWeather, { weatherId })
	end
	local ending = current
	summonedBy = nil
	current = nil
	ReplicatedStorage:SetAttribute("Weather", "")
	tweenSky(nil)
	Net.announce("The weather clears.", "#dddddd")
	if ending then
		fireStop(ending)
	end
end

-- Returns a mutation id (or nil) for a Sproutling hatching right now for this player.
function WeatherService.rollMutation(session): string?
	local luck = if session.luckUntil > os.time() then 2 else 1
	local w = WeatherService.current()
	if w and w.mutation and State.rng:NextNumber() < w.mutationChance * luck then
		return w.mutation
	end
	if State.rng:NextNumber() < Config.GoldenChance * luck then
		return "golden"
	end
	return nil
end

function WeatherService.rollSize(): number
	if State.rng:NextNumber() < Config.HugeChance then
		return Config.HugeSize
	end
	-- skewed towards small: 0.8 .. 1.5
	local r = State.rng:NextNumber()
	return math.floor((0.8 + r * r * 0.7) * 100) / 100
end

-- 5. Hardened to explicitly skip naturalWeight <= 0 entries (e.g. spookyfog): in the previous
-- version this only worked because Random:NextNumber()'s half-open [0, 1) range makes roll == 0
-- astronomically unlikely, which would otherwise let a 0-weight entry win if it happened to be the
-- first one Lua's unordered table iteration visited. Skipping them outright removes that edge case
-- instead of relying on floating-point luck.
local function pickNatural(): string
	local total = 0
	for _, w in Weather.Types do
		if w.naturalWeight > 0 then
			total += w.naturalWeight
		end
	end
	local roll = State.rng:NextNumber() * total
	for id, w in Weather.Types do
		if w.naturalWeight > 0 then
			roll -= w.naturalWeight
			if roll <= 0 then
				return id
			end
		end
	end
	return "drizzle"
end

function WeatherService.init()
	defaultAmbient = Lighting.OutdoorAmbient
	defaultFog = Lighting.FogColor
	ReplicatedStorage:SetAttribute("Weather", "")
	task.spawn(function()
		local nextNatural = os.clock() + State.rng:NextInteger(Config.WeatherEverySeconds[1], Config.WeatherEverySeconds[2]) * 0.5
		while true do
			task.wait(1)
			if current and os.clock() >= endsAt then
				stop()
				nextNatural = os.clock() + State.rng:NextInteger(Config.WeatherEverySeconds[1], Config.WeatherEverySeconds[2])
			elseif current then
				ReplicatedStorage:SetAttribute("WeatherEndsIn", endsAt - os.clock())
			elseif os.clock() >= nextNatural then
				WeatherService.start(pickNatural())
			end
		end
	end)
end

return WeatherService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="38">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpHeight">7.2</float>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="39">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="40">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Sproutling Isles client: HUD, seed hotbar, notifications, Robux store, per-player prompt
-- visibility, live kiosk stock labels and weather particles. All game rules live on the server.

local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Species = require(Shared.Species)
local Weather = require(Shared.Weather)
local Products = require(Shared.Products)
local Format = require(Shared.Format)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local FONT = Enum.Font.FredokaOne
local WHITE = Color3.new(1, 1, 1)

----------------------------------------------------------------------------------------------
-- tiny UI helpers

local function make(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(radius: number): UICorner
	return make("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function stroke(thickness: number, color: Color3?): UIStroke
	return make("UIStroke", { Thickness = thickness, Color = color or Color3.fromRGB(30, 40, 30), ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function text(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = FONT
	props.TextScaled = if props.TextScaled == nil then true else props.TextScaled
	props.TextColor3 = props.TextColor3 or WHITE
	local label = make("TextLabel", props)
	make("UIStroke", { Thickness = 1.5, Color = Color3.fromRGB(20, 30, 20), Parent = label })
	return label
end

local function button(props: { [string]: any }): TextButton
	props.Font = FONT
	props.TextScaled = true
	props.TextColor3 = props.TextColor3 or WHITE
	props.AutoButtonColor = true
	local b = make("TextButton", props)
	corner(10).Parent = b
	stroke(2).Parent = b
	return b
end

local screen = make("ScreenGui", { Name = "SproutlingHUD", ResetOnSpawn = false, IgnoreGuiInset = false, Parent = playerGui })

----------------------------------------------------------------------------------------------
-- top-left: Dew + income

local dewPanel = make("Frame", {
	Name = "Dew",
	Size = UDim2.new(0, 230, 0, 70),
	Position = UDim2.new(0, 12, 0, 12),
	BackgroundColor3 = Color3.fromRGB(40, 90, 60),
	BackgroundTransparency = 0.1,
	Parent = screen,
}, { corner(14), stroke(3) })
local dewLabel = text({ Size = UDim2.new(1, -16, 0.6, 0), Position = UDim2.new(0, 8, 0, 4), TextXAlignment = Enum.TextXAlignment.Left, Text = "0 Dew", TextColor3 = Color3.fromRGB(170, 235, 255), Parent = dewPanel })
local incomeLabel = text({ Size = UDim2.new(1, -16, 0.35, 0), Position = UDim2.new(0, 8, 0.6, 0), TextXAlignment = Enum.TextXAlignment.Left, Text = "+0/s", Parent = dewPanel })

local function refreshDew()
	dewLabel.Text = Format.number(player:GetAttribute("Dew") or 0) .. " Dew"
	incomeLabel.Text = "+" .. Format.number(player:GetAttribute("Income") or 0) .. " Dew/s"
end
player:GetAttributeChangedSignal("Dew"):Connect(refreshDew)
player:GetAttributeChangedSignal("Income"):Connect(refreshDew)
refreshDew()

-- status line under the Dew panel: shield, luck, carrying, storage
local statusLabel = text({ Size = UDim2.new(0, 330, 0, 24), Position = UDim2.new(0, 12, 0, 88), TextXAlignment = Enum.TextXAlignment.Left, Text = "", Parent = screen })

----------------------------------------------------------------------------------------------
-- Hollow Harvest: Moonberries + next Spooky Fog countdown (mirrors the Dew panel / Stock-label
-- pattern above -- read a server-set player Attribute, format it, show it; nothing more)

local eventPanel = make("Frame", {
	Name = "Event",
	Size = UDim2.new(0, 330, 0, 28),
	Position = UDim2.new(0, 12, 0, 116),
	BackgroundColor3 = Color3.fromRGB(70, 40, 100),
	BackgroundTransparency = 0.1,
	Visible = false,
	Parent = screen,
}, { corner(10), stroke(2) })
local eventLabel = text({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.new(0, 6, 0, 3), TextXAlignment = Enum.TextXAlignment.Left, Text = "", TextColor3 = Color3.fromRGB(230, 190, 255), Parent = eventPanel })

local function refreshEvent()
	local active = ReplicatedStorage:GetAttribute("EventActive") == true
	eventPanel.Visible = active
	if not active then
		return
	end
	local berries = player:GetAttribute("Moonberries") or 0
	local nextFogAt = ReplicatedStorage:GetAttribute("NextFogAt") or 0
	local remaining = nextFogAt - workspace:GetServerTimeNow()
	local fogText = if remaining > 0 then ("Next Fog in " .. Format.time(remaining)) else "Fog is here!"
	eventLabel.Text = "🎃 Moonberries: " .. Format.number(berries) .. " · " .. fogText
end
player:GetAttributeChangedSignal("Moonberries"):Connect(refreshEvent)
ReplicatedStorage:GetAttributeChangedSignal("EventActive"):Connect(refreshEvent)
refreshEvent()

----------------------------------------------------------------------------------------------
-- top-centre: weather banner

local weatherBanner = make("Frame", {
	Size = UDim2.new(0, 360, 0, 44),
	Position = UDim2.new(0.5, -180, 0, 12),
	BackgroundColor3 = Color3.fromRGB(60, 60, 110),
	BackgroundTransparency = 0.15,
	Visible = false,
	Parent = screen,
}, { corner(12), stroke(2) })
local weatherLabel = text({ Size = UDim2.new(1, -12, 1, -8), Position = UDim2.new(0, 6, 0, 4), Text = "", Parent = weatherBanner })

----------------------------------------------------------------------------------------------
-- notifications (bottom-right toasts) + big centre popup

local toasts = make("Frame", {
	Size = UDim2.new(0, 380, 0, 300),
	Position = UDim2.new(1, -392, 1, -420),
	BackgroundTransparency = 1,
	Parent = screen,
}, { make("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })

local toastCount = 0
local function toast(message: string, colorHex: string?)
	toastCount += 1
	local color = if colorHex then Color3.fromHex(colorHex) else WHITE
	local frame = make("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Color3.fromRGB(25, 35, 30),
		BackgroundTransparency = 0.2,
		LayoutOrder = toastCount,
		Parent = toasts,
	}, { corner(10) })
	text({ Size = UDim2.new(1, -16, 1, -8), Position = UDim2.new(0, 8, 0, 4), Text = message, TextColor3 = color, TextWrapped = true, Parent = frame })
	local children = toasts:GetChildren()
	if #children > 7 then
		for _, child in children do
			if child:IsA("Frame") then
				child:Destroy()
				break
			end
		end
	end
	task.delay(6, function()
		if frame.Parent then
			TweenService:Create(frame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			task.wait(0.4)
			frame:Destroy()
		end
	end)
end
Remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)

local popup = text({
	Size = UDim2.new(0, 600, 0, 80),
	Position = UDim2.new(0.5, -300, 0.3, 0),
	Text = "",
	Visible = false,
	Parent = screen,
})
local popupToken = 0
local function showPopup(message: string, color: Color3)
	popupToken += 1
	local token = popupToken
	popup.Text = message
	popup.TextColor3 = color
	popup.Visible = true
	popup.Size = UDim2.new(0, 300, 0, 40)
	popup.Position = UDim2.new(0.5, -150, 0.3, 20)
	TweenService:Create(popup, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.new(0, 600, 0, 80), Position = UDim2.new(0.5, -300, 0.3, 0) }):Play()
	task.delay(2.5, function()
		if token == popupToken then
			popup.Visible = false
		end
	end)
end

Remotes:WaitForChild("Effect").OnClientEvent:Connect(function(kind: string, data)
	if kind == "Hatch" then
		showPopup("Hatched " .. data.name .. "!", Species.RarityColors[data.rarity] or WHITE)
	elseif kind == "Stolen" then
		showPopup(data.thief .. " is stealing from you!", Color3.fromRGB(255, 90, 90))
	elseif kind == "SnatchSuccess" then
		showPopup("Snatched " .. data.name .. "!", Color3.fromRGB(255, 170, 80))
	elseif kind == "Rebirth" then
		showPopup("REBIRTH " .. data.rebirths .. "!", Color3.fromRGB(210, 160, 255))
	elseif kind == "LanternGone" then
		-- Hollow Harvest: hides this one Wisp Lantern for just this client (everyone else can still
		-- take it -- lanterns are collectible once per player, not once total). Purely a local
		-- rendering change: it never replicates back to the server or to other players.
		if typeof(data) == "Instance" and data:IsA("BasePart") then
			data.Transparency = 1
			data.CanCollide = false
			local light = data:FindFirstChildOfClass("PointLight")
			if light then
				light.Enabled = false
			end
			local gui = data:FindFirstChild("Label")
			if gui and gui:IsA("BillboardGui") then
				gui.Enabled = false
			end
			local prompt = data:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				prompt.Enabled = false
			end
		end
	end
end)

